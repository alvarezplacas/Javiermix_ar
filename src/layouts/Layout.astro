---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import MobileNav from '@components/MobileNav.astro';
import SEO from '@components/SEO.astro';
import CartWidget from '@components/ecommerce/CartWidget.tsx';
import MiniIAWidget from '@components/MiniIAWidget.jsx';
import '../styles/ecommerce.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  url?: string;
  pubDate?: string;
  author?: string;
  keywords?: string[];
  noindex?: boolean;
  schema?: object;
  themeForce?: 'dark' | 'light';
}

const {
  title,
  description,
  image,
  type,
  url = Astro.url.pathname,
  pubDate,
  author,
  keywords,
  noindex,
  schema,
  themeForce,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme-force={themeForce}>
	<head>
		<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
		<SEO
			title={title}
			description={description}
			image={image}
			type={type}
			url={url}
			pubDate={pubDate}
			author={author}
			keywords={keywords}
			noindex={noindex}
			schema={schema}
		/>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

		<!-- Umami Analytics (Golden Master 2.0) -->
		<script defer src="https://stats.javiermix.ar/script.js" data-website-id="d325c934-d7d1-439d-823f-bf250ebfc799"></script>

		<!-- ⚡ Anti-Flash Theme Script (Premium JMX load) -->
		<script is:inline>
			(function() {
				const htmlEl = document.documentElement;
				const force = htmlEl.getAttribute('data-theme-force');
				
				const getTheme = () => {
					if (force) return force;
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					return 'dark';
				};
				
				const theme = getTheme();
				htmlEl.setAttribute('data-theme', theme);
			})();
		</script>

		<ClientRouter />
	</head>
	<body>
		<slot />
		<CartWidget client:only="preact" />
		<MiniIAWidget client:only="preact" />
		<MobileNav />

		<!-- 🔄 Hydration for Theme Toggle (Supports View Transitions) -->
		<script>
			const setupThemeToggle = () => {
				const toggleBtn = document.getElementById('theme-toggle-btn');
				if (!toggleBtn) return;

				toggleBtn.addEventListener('click', () => {
					// Bypassed if the theme is strictly forced by layout context
					if (document.documentElement.getAttribute('data-theme-force')) return;

					const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
					const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
					
					document.documentElement.setAttribute('data-theme', newTheme);
					localStorage.setItem('theme', newTheme);
					
					window.dispatchEvent(new CustomEvent('theme-changed', { detail: newTheme }));
				});
			};

			document.addEventListener('astro:page-load', setupThemeToggle);
		</script>
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		padding: 0;
	}

	/* 🚀 FIX NUCLEAR: Eliminación de Resplandor Azul y ajuste de Hero */
	.split-visual, .hero-main-stack, .hero-media-item {
		box-shadow: none !important;
		filter: none !important;
		background-color: #000 !important;
	}

	.split-screen {
		display: flex !important;
		width: 100% !important;
		overflow-x: hidden !important;
	}

	.split-visual {
		flex: 0 0 50vw !important;
		width: 50vw !important;
	}

	.split-content {
		flex: 0 0 50vw !important;
		width: 50vw !important;
	}
</style>
