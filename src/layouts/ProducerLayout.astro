---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\layouts\ProducerLayout.astro
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

import { getSession } from 'auth-astro/server';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// Verificar Sesión del Artista
const session = await getSession(Astro.request);

const artistName = session?.user?.name || "Artista Anónimo";
const artistImage = session?.user?.image || null;
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title} | STUDIO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <ClientRouter />
</head>
<body class="producer-body">
    <div class="producer-interface">
        
        <!-- Sidebar Desktop / Bottom Nav Mobile -->
        <nav class="producer-nav" transition:persist>
            <div class="nav-brand desktop-only">
                <a href="/dashboard/artista" class="logo-box">
                    <span class="logo-text">ST</span>
                </a>
            </div>
            
            <div class="nav-links">
                <a href="/dashboard/artista" class={currentPath === '/dashboard/artista' ? 'active' : ''} data-tooltip="Mi Estudio">
                    <i class="fas fa-camera"></i>
                    <span class="mobile-label">Estudio</span>
                </a>
                <a href="/dashboard/artista/obras" class={currentPath.startsWith('/dashboard/artista/obras') ? 'active' : ''} data-tooltip="Mis Obras">
                    <i class="fas fa-images"></i>
                    <span class="mobile-label">Obras</span>
                </a>
                <a href="/dashboard/artista/estadisticas" class={currentPath.startsWith('/dashboard/artista/estadisticas') ? 'active' : ''} data-tooltip="Estadísticas">
                    <i class="fas fa-chart-line"></i>
                    <span class="mobile-label">Stats</span>
                </a>
                <a href="/comunidad" class="btn-external" data-tooltip="Ir a Comunidad">
                    <i class="fas fa-globe"></i>
                    <span class="mobile-label">Explorar</span>
                </a>
            </div>
            
            <div class="nav-bottom desktop-only">
                <button id="btn-logout-producer" class="btn-logout" data-tooltip="Salir">
                    <i class="fas fa-power-off"></i>
                </button>
            </div>
        </nav>

        <main class="main-workspace">
            <header class="workspace-header">
                <div class="header-left">
                    <span class="system-tag">NOIR & LUX STUDIO</span>
                    <h1 class="page-title">{title}</h1>
                </div>
                <div class="header-right">
                    <div class="user-badge">
                        <div class="user-info">
                            <span class="user-name">{artistName}</span>
                            <span class="user-role">FOTÓGRAFO</span>
                        </div>
                        <div class="user-avatar">
                            {artistImage ? <img src={artistImage} alt={artistName} style="width:100%; height:100%; border-radius:50%; object-fit:cover;" /> : <i class="fas fa-user"></i>}
                        </div>
                    </div>
                </div>
            </header>
            
            <div class="workspace-body" transition:animate="fade">
                <slot />
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('astro:page-load', () => {
            document.getElementById('btn-logout-producer')?.addEventListener('click', () => {
                // Logout logic for producer
                window.location.href = '/';
            });
        });
    </script>
</body>
</html>

<style is:global>
    :root {
        --c-bg: #050505;
        --c-nav: #0a0a0a;
        --c-accent: #C5A059;
        --c-text: #F2EFE9;
        --c-muted: rgba(242, 239, 233, 0.4);
        --c-border: rgba(255, 255, 255, 0.04);
        --nav-desktop-w: 80px;
        --nav-mobile-h: 65px;
        --header-h: 70px;
    }

    * { box-sizing: border-box; }

    body.producer-body {
        margin: 0;
        background-color: var(--c-bg);
        color: var(--c-text);
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
    }

    .producer-interface {
        display: flex;
        min-height: 100vh;
    }

    /* Navegación Desktop */
    .producer-nav {
        width: var(--nav-desktop-w);
        background-color: var(--c-nav);
        border-right: 1px solid var(--c-border);
        position: fixed;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem 0;
        z-index: 100;
        transition: all 0.3s ease;
    }

    .nav-brand { margin-bottom: 3rem; }
    
    .logo-box {
        width: 40px;
        height: 40px;
        border: 1px solid var(--c-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }
    .logo-text { color: var(--c-accent); font-weight: 700; font-size: 0.8rem; letter-spacing: 1px; }

    .nav-links {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
        align-items: center;
    }

    .nav-links a, .nav-bottom button {
        width: 45px;
        height: 45px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--c-muted);
        text-decoration: none;
        font-size: 1.2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        position: relative;
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .nav-links a:hover, .nav-bottom button:hover {
        color: var(--c-text);
        background: rgba(255,255,255,0.03);
    }

    .nav-links a.active {
        color: var(--c-accent);
        background: rgba(197, 160, 89, 0.1);
    }

    .mobile-label {
        display: none;
        font-size: 0.6rem;
        margin-top: 4px;
        font-weight: 600;
        text-transform: uppercase;
    }

    /* Tooltips Desktop */
    @media (min-width: 769px) {
        [data-tooltip]::before {
            content: attr(data-tooltip);
            position: absolute;
            left: 100%;
            margin-left: 15px;
            background: var(--c-accent);
            color: #000;
            padding: 4px 10px;
            font-size: 0.7rem;
            border-radius: 4px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s ease;
            pointer-events: none;
            font-weight: 600;
            z-index: 200;
        }

        [data-tooltip]:hover::before {
            opacity: 1;
            visibility: visible;
            transform: translateX(0);
        }
    }

    /* Workspace */
    .main-workspace {
        flex: 1;
        margin-left: var(--nav-desktop-w);
        display: flex;
        flex-direction: column;
    }

    .workspace-header {
        height: var(--header-h);
        padding: 0 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--c-border);
        background: rgba(5,5,5,0.5);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 90;
    }

    .system-tag {
        font-size: 0.55rem;
        letter-spacing: 2px;
        color: var(--c-accent);
        opacity: 0.6;
        text-transform: uppercase;
    }

    .page-title {
        font-size: 1.1rem;
        margin: 0.2rem 0 0;
        font-weight: 300;
        letter-spacing: 1px;
        color: var(--c-text);
    }

    .user-badge {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .user-info { text-align: right; }
    .user-name { display: block; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.5px; }
    .user-role { display: block; font-size: 0.55rem; color: var(--c-accent); letter-spacing: 1px; }
    
    .user-avatar {
        width: 35px;
        height: 35px;
        background: rgba(197, 160, 89, 0.1);
        border: 1px solid var(--c-accent);
        color: var(--c-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        border-radius: 50%;
    }

    .workspace-body {
        padding: 3rem;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
        padding-bottom: 5rem;
    }

    /* 📱 DISEÑO MÓVIL (BOTTOM NAVIGATION BAR) */
    @media (max-width: 768px) {
        .desktop-only { display: none !important; }
        
        .main-workspace {
            margin-left: 0;
            padding-bottom: var(--nav-mobile-h); /* Espacio para el menú inferior */
        }

        .workspace-header {
            padding: 0 1.5rem;
        }
        
        .user-info { display: none; }

        .workspace-body {
            padding: 1.5rem;
        }

        /* Transformar Sidebar a Bottom Bar */
        .producer-nav {
            width: 100%;
            height: var(--nav-mobile-h);
            top: auto;
            bottom: 0;
            left: 0;
            right: 0;
            border-right: none;
            border-top: 1px solid var(--c-border);
            flex-direction: row;
            padding: 0;
            background: rgba(10,10,10,0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .nav-links {
            flex-direction: row;
            justify-content: space-around;
            gap: 0;
            padding: 0 10px;
        }

        .nav-links a {
            width: auto;
            flex: 1;
            font-size: 1.1rem;
            background: transparent !important;
            height: 100%;
            border-radius: 0;
        }

        .mobile-label {
            display: block;
        }

        .nav-links a.active {
            color: var(--c-accent);
            border-top: 2px solid var(--c-accent);
        }
        
        .nav-links a.active .mobile-label {
            font-weight: 800;
        }
    }
</style>
