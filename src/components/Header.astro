---
// src/components/Header.astro
import CartNavButton from './ecommerce/CartNavButton.tsx';
const { currentPath = '/', theme = 'dark', themeForce } = Astro.props;
---

<header class={`site-header theme-${theme}`}>
	<nav class="nav-container" aria-label="Navegación principal">
        <div class="nav-links">
            <a href="/" class={currentPath === '/' ? 'active' : ''}>Inicio</a>
            <a href="/galeria" class={currentPath.startsWith('/galeria') ? 'active' : ''}>Colección</a>
            <a href="/rescate" class={currentPath.startsWith('/rescate') ? 'active' : ''}>Rescate</a>
            <a href="/royal-gallery" class={currentPath.startsWith('/royal-gallery') ? 'active' : ''}>Royal</a>
            <a href="/revista/" class={currentPath.startsWith('/revista') ? 'active' : ''}>Revista</a>
            
            <div class="cart-wrapper">
			    <CartNavButton client:load />
            </div>

            <!-- Botón de Acceso (Comunidad) Minimalista -->
            <a href="/dashboard/artista" class="user-access-btn" aria-label="Acceso a la Comunidad" data-tooltip="Comunidad">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </a>

            <!-- 🌍 Botón de Idioma -->
            <div class="lang-dropdown-wrapper">
                <button class="lang-toggle-btn" aria-label="Cambiar idioma" data-tooltip="Idioma / Language">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                </button>
                <div class="lang-dropdown-menu">
                    <button class="lang-option" data-lang="es">Español</button>
                    <button class="lang-option" data-lang="en">English</button>
                    <button class="lang-option" data-lang="fr">Français</button>
                </div>
            </div>

			<!-- 🌓 Alternador de Tema Luz/Noche (Ocultado si themeForce está activo) -->
			{!themeForce && (
				<button 
					id="theme-toggle-btn" 
					class="theme-toggle-btn" 
					aria-label="Cambiar tema de color" 
					data-tooltip="Modo Noir / Lux"
				>
					<svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>
			)}
		</div>
	</nav>
</header>

<style>
.site-header {
	position: absolute;
	top: 0;
	z-index: 1000;
	background: transparent;
	width: 100%;
	transition: var(--transition-premium);
}

.nav-container {
    width: 100%;
    padding: 2rem 4rem;
    display: flex;
    justify-content: flex-end; /* Aligned to the right */
    align-items: center;
}

.nav-links {
    display: flex;
    flex-direction: row;
    gap: 2rem;
    align-items: center;
    z-index: 2000;
}

.nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    padding: 0.5rem 0;
}

.nav-links a:hover, 
.nav-links a.active {
    color: var(--color-text);
    letter-spacing: 3px;
}

.user-access-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    margin-left: 0.5rem;
    z-index: 3000;
}

.user-access-btn:hover {
    color: var(--color-accent);
    transform: scale(1.1);
}

.user-access-btn svg {
    width: 18px;
    height: 18px;
}

.user-access-btn::after {
    display: none;
}

/* 🌓 Botones de Acción Iconográficos (Tema, Idioma) */
.theme-toggle-btn, .lang-toggle-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    margin-left: 0.5rem;
    z-index: 3000;
}

.theme-toggle-btn:hover, .lang-toggle-btn:hover {
    color: var(--color-accent);
    transform: scale(1.1);
}

.theme-toggle-btn svg, .lang-toggle-btn svg {
    width: 20px;
    height: 20px;
}

/* Dropdown Idiomas */
.lang-dropdown-wrapper {
    position: relative;
    display: inline-block;
}
.lang-dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    background: rgba(10, 10, 10, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.5rem 0;
    display: flex;
    flex-direction: column;
    min-width: 120px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 4000;
}
.lang-dropdown-wrapper:hover .lang-dropdown-menu,
.lang-dropdown-wrapper:focus-within .lang-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}
.lang-option {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    padding: 0.5rem 1rem;
    text-align: left;
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
}
.lang-option:hover {
    color: var(--color-accent);
    background: rgba(255, 255, 255, 0.05);
}

/* Ocultar/Mostrar iconos SVG de acuerdo al tema cargado */
html[data-theme="light"] .theme-toggle-btn .sun-icon {
    display: none;
}
html[data-theme="light"] .theme-toggle-btn .moon-icon {
    display: block;
    color: var(--color-text);
}

html[data-theme="dark"] .theme-toggle-btn .sun-icon {
    display: block;
    color: var(--color-text);
}
html[data-theme="dark"] .theme-toggle-btn .moon-icon {
    display: none;
}

/* Indicador inferior minimalista */
.nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.5s ease;
}

.nav-links a:hover::after,
.nav-links a.active::after {
    width: 100%;
}

.cart-wrapper {
    margin-left: 1rem;
    opacity: 0.7;
    transition: 0.3s;
}
.cart-wrapper:hover { opacity: 1; }

/* 🏷️ Premium Tooltip */
[data-tooltip] {
    position: relative;
}

[data-tooltip]::before {
    content: attr(data-tooltip);
    position: absolute;
    bottom: -35px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(0, 0, 0, 0.9);
    color: var(--color-accent);
    padding: 0.5rem 1rem;
    font-size: 0.6rem;
    font-weight: 800;
    white-space: nowrap;
    letter-spacing: 1px;
    border: 1px solid rgba(220, 177, 74, 0.3);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 1000;
}

[data-tooltip]:hover::before {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
}

@media (max-width: 1024px) {
    .nav-container {
        padding: 2rem;
    }
    .nav-links {
        gap: 1.5rem;
    }
    .nav-links a {
        font-size: 0.8rem;
        letter-spacing: 1px;
    }
}

@media (max-width: 768px) {
    .nav-links {
        display: none;
    }
}
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const langOptions = document.querySelectorAll('.lang-option');
        langOptions.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const lang = (e.target as HTMLElement).getAttribute('data-lang');
                const select = document.querySelector('.goog-te-combo') as HTMLSelectElement;
                if (select) {
                    select.value = lang || 'es';
                    select.dispatchEvent(new Event('change'));
                }
            });
        });
    });
</script>
