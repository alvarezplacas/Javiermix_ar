// h:\Javiermix_web_v2\frontend\magazine\index.astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getArticles, getAssetUrl } from '@conexion/directus';

// Fetch articles from Directus SDK
const dbArticles = await getArticles();

// 🛠️ Decodificador de entidades HTML para textos impecables (Estándar JMX Oro)
function decodeHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/&eacute;/g, 'é')
    .replace(/&ecute;/g, 'é') // Parche para entidad mal escrita en CMS
    .replace(/&aacute;/g, 'á')
    .replace(/&iacute;/g, 'í')
    .replace(/&oacute;/g, 'ó')
    .replace(/&uacute;/g, 'ú')
    .replace(/&ntilde;/g, 'ñ')
    .replace(/&Eacute;/g, 'É')
    .replace(/&Aacute;/g, 'Á')
    .replace(/&Iacute;/g, 'Í')
    .replace(/&Oacute;/g, 'Ó')
    .replace(/&Uacute;/g, 'Ú')
    .replace(/&Ntilde;/g, 'Ñ')
    .replace(/&ldquo;/g, '“')
    .replace(/&rdquo;/g, '”')
    .replace(/&rsquo;/g, '’')
    .replace(/&lsquo;/g, '‘')
    .replace(/&quot;/g, '"')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&nbsp;/g, ' ')
    .replace(/&mdash;/g, '—');
}

function resolveMedia(id: any): { url: string, type: 'image' | 'video' } {
  const url = id?.id ? getAssetUrl(id.id) : (typeof id === 'string' ? (id.startsWith('http') ? id : getAssetUrl(id)) : '/img/placeholder.jpg');
  const type = (url?.toLowerCase().endsWith('.mp4') || url?.includes('video')) ? 'video' : 'image';
  return { url: url || '/img/placeholder.jpg', type };
}

const articles = dbArticles.map(art => {
  const wordCount = (art.content_html || '').replace(/<[^>]*>/g, '').split(/\s+/).length;
  const readTime = Math.max(1, Math.ceil(wordCount / 200));

  // Extraer multimedia (Featured + Media JSON)
  let slideshow = [resolveMedia(art.featured_image)];
  
  if (art.media_json) {
    try {
        const extraRaw = typeof art.media_json === 'string' ? JSON.parse(art.media_json) : art.media_json;
        if (Array.isArray(extraRaw)) {
            const extra = extraRaw.map(m => resolveMedia(m));
            slideshow = [...slideshow, ...extra].slice(0, 6);
        }
    } catch(e) { console.error("Error parsing media_json", e); }
  }

  // Limpiar HTML y decodificar entidades en el título y extracto
  const plainTextExcerpt = (art.content_html || '').replace(/<[^>]*>/g, '').trim();
  const cleanExcerpt = decodeHtml(plainTextExcerpt.substring(0, 220)) + (plainTextExcerpt.length > 220 ? '...' : '');
  const cleanTitle = decodeHtml(art.title || '');

  return {
    id: art.id,
    title: cleanTitle,
    excerpt: cleanExcerpt,
    slideshow,
    readTime: `${readTime} min`,
    link: `/revista/${art.id}-${art.slug}`,
    location: "Buenos Aires",
    category: art.tags ? art.tags.split(',')[0].trim() : "Ensayo Visual"
  };
});
---

<Layout
  title="Revista Digital de Fotografía Fine Art"
  description="Artículos, ensayos visuales y crónicas sobre fotografía de autor, diseño de interiores y el arte de coleccionar imágenes."
  url="/revista"
>
  <Header currentPath="/revista" />

  <main class="revista-main">
    <div class="revista-hero">
      <div class="hero-bg-line"></div>
      <span class="issue-tag">Vol. I · 2026</span>
      <h1 class="revista-title">REVISTA DIGITAL</h1>
      <p class="revista-subtitle">Crónicas de luz, memoria y potencia estética para coleccionistas y decoradores.</p>
      
      {articles.length === 0 && (
        <div style="color: #c94c4c; font-size: 0.7rem; margin-top: 1rem; opacity: 0.7; letter-spacing: 2px;">
          DIAGNÓSTICO: No se encontraron artículos. Verifica permisos en Directus (colección 'magazine' o 'Magazine').
        </div>
      )}
    </div>

    <div class="articles-wrapper">
      {articles.length > 0 ? (
        articles.map((article, index) => (
          <article class={`article-row ${index % 2 !== 0 ? 'reversed' : ''}`} data-article-card>
            <div class="article-visual">
              <div class="tilt-frame" data-tilt-container>
                <div class="slideshow-wrapper">
                    {article.slideshow.map((media, i) => (
                        media.type === 'video' ? (
                            <video src={media.url} class={`article-media ${i === 0 ? 'active' : ''}`} muted playsinline loop autoplay></video>
                        ) : (
                            <img src={media.url} alt={`${article.title} - view ${i}`} class={`article-media ${i === 0 ? 'active' : ''}`} loading="lazy" />
                        )
                    ))}
                </div>
                <div class="image-glare"></div>
              </div>
              <span class="category-tag">{article.category}</span>
            </div>

            <div class="article-text">
              <span class="article-location">{article.location}</span>
              <h2 class="article-headline">{article.title}</h2>
              <p class="article-excerpt">{article.excerpt}</p>

              <footer class="article-footer">
                <div class="read-time">
                  <span>{article.readTime} de lectura</span>
                </div>
                <a href={article.link} class="btn-leer">
                  LEER NOTA
                  <span class="btn-underline"></span>
                </a>
              </footer>
            </div>
          </article>
        ))
      ) : (
        <div class="empty-state">
           <p>Próximamente nuevas crónicas y ensayos visuales.</p>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<script>
    function initMagazine() {
        // 🎞️ SLIDESHOW LÓGICA (CROSS-FADE HÍBRIDO)
        const articles = document.querySelectorAll('[data-article-card]');
        articles.forEach(art => {
            const media = art.querySelectorAll('.article-media');
            if (media.length <= 1) {
                // Si solo hay una imagen, igual activarla
                if(media[0]) media[0].classList.add('active');
                return;
            }

            let current = 0;
            // Limpiar intervalos previos si existen
            if ((art as any)._slideInterval) clearInterval((art as any)._slideInterval);
            
            (art as any)._slideInterval = setInterval(() => {
                media[current].classList.remove('active');
                current = (current + 1) % media.length;
                media[current].classList.add('active');
                
                if (media[current].tagName === 'VIDEO') {
                    (media[current] as HTMLVideoElement).play().catch(() => {});
                }
            }, 5000);
        });

        // 💡 EFECTO 3D MARCADO
        const handleTilt = (e: MouseEvent) => {
            const container = (e.target as HTMLElement).closest('[data-tilt-container]') as HTMLElement;
            if (!container) return;

            const r = container.getBoundingClientRect();
            const x = e.clientX - r.left; 
            const y = e.clientY - r.top;
            const rx = (y - r.height/2) / 10; // Más sensible
            const ry = (r.width/2 - x) / 10;
            
            container.style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg) scale3d(1.05, 1.05, 1.05)`;
            
            const glare = container.querySelector('.image-glare') as HTMLElement;
            if (glare) {
                const px = (x / r.width) * 100;
                const py = (y / r.height) * 100;
                glare.style.background = `radial-gradient(circle at ${px}% ${py}%, rgba(255,255,255,0.2) 0%, transparent 80%)`;
                glare.style.opacity = "1";
            }
        };

        const resetTilt = (e: MouseEvent) => {
            const container = (e.target as HTMLElement).closest('[data-tilt-container]') as HTMLElement;
            if (!container) return;
            container.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
            const glare = container.querySelector('.image-glare') as HTMLElement;
            if (glare) glare.style.opacity = "0";
        };

        document.querySelectorAll('.articles-wrapper').forEach(wrapper => {
            wrapper.addEventListener('mousemove', (e:any) => handleTilt(e));
            wrapper.addEventListener('mouseleave', (e:any) => resetTilt(e));
        });
    }

    // Ejecutar en ambos eventos para máxima compatibilidad
    document.addEventListener('astro:page-load', initMagazine);
    document.addEventListener('DOMContentLoaded', initMagazine);
    initMagazine(); // Ejecución inmediata
</script>

<style>
  .revista-main { 
    background-color: var(--color-bg); 
    min-height: 100vh; 
    padding-top: 5rem; 
    transition: background-color 0.5s ease;
  }
  
  .revista-hero { 
    text-align: center; 
    padding: 8rem 2rem 6rem; 
    position: relative; 
    border-bottom: 1px solid var(--glass-border); 
    transition: border-color 0.5s ease;
  }
  
  .hero-bg-line { 
    position: absolute; 
    left: 50%; 
    top: 0; 
    width: 1px; 
    height: 100%; 
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent); 
    opacity: 0.3; 
    transform: translateX(-50%); 
  }
  
  .issue-tag { 
    display: inline-block; 
    font-size: 0.7rem; 
    letter-spacing: 4px; 
    text-transform: uppercase; 
    color: var(--color-accent); 
    margin-bottom: 2rem; 
    border: 1px solid var(--glass-border); 
    padding: 0.4rem 1.2rem; 
    transition: border-color 0.5s ease, color 0.5s ease;
  }
  
  .revista-title { 
    font-size: clamp(3rem, 8vw, 7rem); 
    font-weight: 300; 
    letter-spacing: 10px; 
    color: var(--color-white); 
    margin-bottom: 2rem; 
    transition: color 0.5s ease;
  }
  
  .revista-subtitle { 
    font-size: 1.1rem; 
    font-weight: 300; 
    color: var(--color-text-muted); 
    max-width: 600px; 
    margin: 0 auto; 
    line-height: 1.6; 
    transition: color 0.5s ease;
  }

  .articles-wrapper { 
    max-width: 1400px; 
    margin: 0 auto; 
    padding: 8rem 5%; 
    display: flex; 
    flex-direction: column; 
    gap: 12rem; 
  }
  
  .article-row { 
    display: grid; 
    grid-template-columns: 1.1fr 0.9fr; 
    gap: 6rem; 
    align-items: center; 
  }
  
  .article-row.reversed { 
    direction: rtl; 
  }
  
  .article-row.reversed > * { 
    direction: ltr; 
  }
  
  .article-visual { 
    position: relative; 
    perspective: 1000px; 
  }
  
  /* 🖼️ Premium "Pared de Galería" Passepartout Frame */
  .tilt-frame { 
    width: 100%; 
    height: 520px; 
    overflow: hidden; 
    position: relative; 
    background: #0a0a0a; 
    border: 16px solid var(--color-bg); /* Elegant adaptive paper mat */
    outline: 1px solid var(--glass-border); /* Subtle frame edge */
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25), 0 15px 30px rgba(0, 0, 0, 0.15); 
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease, border-color 0.5s ease, outline-color 0.5s ease;
    transform-style: preserve-3d;
  }
  
  .article-row:hover .tilt-frame {
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.35), 0 20px 40px rgba(0, 0, 0, 0.2);
  }
  
  .slideshow-wrapper { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    background: #000;
    box-shadow: inset 0 0 80px rgba(0,0,0,0.8);
    z-index: 2;
  }
  
  .article-media { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    filter: grayscale(15%) brightness(0.85); 
    transition: opacity 1.5s ease, filter 0.8s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); 
    opacity: 0;
    z-index: 1;
    mask-image: radial-gradient(circle, black 70%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle, black 70%, transparent 100%);
  }
  
  .article-media.active { 
    opacity: 1; 
    filter: grayscale(0%) brightness(1); 
    z-index: 2; 
  }
  
  .article-row:hover .article-media.active {
    transform: scale(1.05);
  }
  
  .image-glare { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    pointer-events: none; 
    z-index: 5; 
    opacity: 0; 
    transition: opacity 0.3s;
  }
  
  .category-tag { 
    position: absolute; 
    bottom: -1rem; 
    left: 2.5rem; 
    background: var(--color-accent); 
    color: #000; 
    font-size: 0.65rem; 
    font-weight: 700; 
    letter-spacing: 3px; 
    text-transform: uppercase; 
    padding: 0.5rem 1.2rem; 
    z-index: 10; 
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  }
  
  /* 🕊️ Clean Floating Card-less Text Column */
  .article-text { 
    padding: 1rem 0; 
    display: flex; 
    flex-direction: column; 
    justify-content: center;
  }
  
  .article-location { 
    display: block; 
    font-size: 0.7rem; 
    letter-spacing: 4px; 
    text-transform: uppercase; 
    color: var(--color-accent); 
    font-family: var(--font-secondary); 
    font-weight: 500; 
    margin-bottom: 1.5rem; 
    transition: color 0.5s ease;
  }
  
  .article-headline { 
    font-size: clamp(2.2rem, 3.5vw, 3.2rem); 
    font-weight: 300; 
    font-style: italic; 
    color: var(--color-white); 
    line-height: 1.2; 
    margin-bottom: 2rem; 
    font-family: var(--font-primary); 
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), color 0.5s ease;
  }
  
  .article-row:hover .article-headline {
    transform: translateX(12px);
  }
  
  .article-excerpt { 
    color: var(--color-text-muted); 
    font-family: var(--font-secondary);
    font-size: 0.95rem; 
    line-height: 1.85; 
    font-weight: 300; 
    margin-bottom: 3rem; 
    transition: color 0.5s ease;
  }
  
  .article-footer { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    border-top: 1px solid var(--glass-border); 
    padding-top: 2rem; 
    transition: border-color 0.5s ease;
  }
  
  .read-time { 
    color: var(--color-text-muted); 
    font-family: var(--font-secondary); 
    font-weight: 400; 
    font-size: 0.7rem; 
    letter-spacing: 2px; 
    text-transform: uppercase; 
    transition: color 0.5s ease;
  }
  
  .btn-leer { 
    position: relative; 
    color: var(--color-white); 
    font-family: var(--font-secondary); 
    font-size: 0.7rem; 
    font-weight: 700; 
    letter-spacing: 3px; 
    text-decoration: none; 
    transition: color 0.5s ease;
  }
  
  .btn-underline { 
    display: block; 
    width: 30%; 
    height: 1px; 
    background-color: var(--color-accent); 
    margin-top: 6px; 
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1); 
  }
  
  .btn-leer:hover .btn-underline { 
    width: 100%; 
  }
  
  .empty-state {
    text-align: center;
    padding: 6rem 2rem;
    color: var(--color-text-muted);
    font-family: var(--font-secondary);
    font-size: 1rem;
    letter-spacing: 1px;
    border: 1px dashed var(--glass-border);
  }

  @media (max-width: 900px) {
    .article-row { 
      grid-template-columns: 1fr; 
      gap: 4rem; 
      direction: ltr !important; 
    }
    .articles-wrapper { 
      gap: 8rem; 
      padding: 4rem 5%;
    }
    .tilt-frame { 
      height: 380px; 
      border: 8px solid var(--color-bg); 
    }
    .article-row:hover .article-headline {
      transform: none;
    }
  }
</style>
