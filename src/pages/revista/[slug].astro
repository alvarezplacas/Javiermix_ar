---
// h:\Javiermix_web_v2\frontend\magazine\[slug].astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getArticleDetails, getAssetUrl, fetchFromDirectus, slugify, DirectusManager } from '@conexion/directus';
import { getArticleFeedback } from '@conexion/magazine_feedback';
import OptimizedImage from '@components/OptimizedImage.astro';
import { readItems } from '@directus/sdk';

export const prerender = true;

export async function getStaticPaths() {
  try {
    const client = await DirectusManager.getClient();
    const articles = await client.request(readItems('magazine' as any, {
      filter: {
        status: { _in: ['published', 'Publicado'] }
      },
      fields: ['id', 'slug'],
      limit: -1
    }));
    
    return articles.map((art: any) => ({
      params: { slug: `${art.id}-${art.slug}` }
    }));
  } catch (e) {
    console.error('[[slug].astro getStaticPaths] Error fetching paths:', e);
    return [];
  }
}

const { slug } = Astro.params;

// 1. Obtener datos con resiliencia total (Soporte Híbrido ID-Slug)
let articulo = null;
let connectionError = null;
let feedback = { comments: [], averageRating: 0, ratingsCount: 0, hasRated: false };

try {
    // Extraer el ID si el slug tiene formato "1-nombre"
    const idFromSlug = slug!.split('-')[0];
    articulo = await getArticleDetails(idFromSlug);
    
    // Si no lo encuentra por ID, intentamos por el slug completo
    if (!articulo) {
        articulo = await getArticleDetails(slug!);
    }

    if (articulo) {
        const clientIp = "unknown";
        feedback = await getArticleFeedback(articulo.id, clientIp);
    }
} catch (e: any) {
    connectionError = `Error de conexión: ${e.message}`;
}



// 🛠️ Decodificador de entidades HTML para textos impecables (Estándar JMX Oro)
function decodeHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/&eacute;/g, 'é')
    .replace(/&ecute;/g, 'é') // Parche para entidad mal escrita en CMS
    .replace(/&aacute;/g, 'á')
    .replace(/&iacute;/g, 'í')
    .replace(/&oacute;/g, 'ó')
    .replace(/&uacute;/g, 'ú')
    .replace(/&ntilde;/g, 'ñ')
    .replace(/&Eacute;/g, 'É')
    .replace(/&Aacute;/g, 'Á')
    .replace(/&Iacute;/g, 'Í')
    .replace(/&Oacute;/g, 'Ó')
    .replace(/&Uacute;/g, 'Ú')
    .replace(/&Ntilde;/g, 'Ñ')
    .replace(/&ldquo;/g, '“')
    .replace(/&rdquo;/g, '”')
    .replace(/&rsquo;/g, '’')
    .replace(/&lsquo;/g, '‘')
    .replace(/&quot;/g, '"')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&nbsp;/g, ' ')
    .replace(/&mdash;/g, '—');
}

if (articulo) {
    articulo.title = decodeHtml(articulo.title || '');
    articulo.content_html = decodeHtml(articulo.content_html || '');
    articulo.author = decodeHtml(articulo.author || '');
    if (articulo.Bibliografia) {
        articulo.Bibliografia = decodeHtml(articulo.Bibliografia);
    }
}

function resolveMediaURL(id: string | null): string {
  if (!id) return '/img/placeholder.jpg';
  if (id.startsWith('http') || id.startsWith('/')) return id;
  const PUBLIC_DIRECTUS_URL = 'https://admin.javiermix.ar';
  return `${PUBLIC_DIRECTUS_URL}/assets/${id}`;
}

function getYouTubeEmbed(url: string): string | null {
  if (!url) return null;
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=|shorts\/)([^#&?]*).*/;
  const match = url.match(regExp);
  const id = (match && match[2].length === 11) ? match[2] : null;
  if (!id) return null;
  // Mute=1 y autoplay=1 para respetar la lectura
  return `https://www.youtube.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&modestbranding=1&rel=0`;
}

// 2. Procesar Multimedia (Solo si existe el artículo)
let media = [];
let readingTime = 5;
let formattedDate = "Edición 2026";

if (articulo) {
    let mediaItems = [];
    try {
        if (articulo.media_json) {
            mediaItems = typeof articulo.media_json === 'string' ? JSON.parse(articulo.media_json) : articulo.media_json;
        }
    } catch (e) {}

    // Búsqueda dinámica por carpeta (Estándar JMX Oro - Autodetect robusto por Slug)
    let dynamicMedia = [];
    try {
        const parentRes = await fetchFromDirectus(`/folders?filter[name][_eq]=Revista&limit=1`);
        const parentData = await parentRes.json();
        const parentFolder = parentData.data?.[0];

        if (parentFolder) {
            const subRes = await fetchFromDirectus(`/folders?filter[parent][_eq]=${parentFolder.id}&limit=-1`);
            const subData = await subRes.json();
            const subFolders = subData.data || [];
            
            // Buscar carpeta cuyo nombre normalizado (slugified) coincida con el slug o el título normalizado
            const targetSlug = slugify(articulo.slug || articulo.title || '');
            const subFolder = subFolders.find((f: any) => slugify(f.name) === targetSlug);
            
            if (subFolder) {
                const filesRes = await fetchFromDirectus(`/files?filter[folder][_eq]=${subFolder.id}&sort=filename_download`);
                const filesData = await filesRes.json();
                dynamicMedia = (filesData.data || []).map(f => ({
                    id: f.id,
                    type: f.type?.startsWith('video/') ? 'video' : 'image',
                    src: getAssetUrl(f.id, f.type?.startsWith('video/') ? { raw: true } : { width: 1600 }),
                    caption: f.title || ''
                }));
                console.log(`[SSR-Revista] 📂 Cargadas automáticamente ${dynamicMedia.length} fotos de la carpeta: Revista/${subFolder.name}`);
            }
        }
    } catch (e) {
        console.error('[SSR-Revista] Error al buscar carpeta dinámica:', e);
    }

    const youtubeUrl = articulo.video_url?.includes('youtube.com') || articulo.video_url?.includes('youtu.be') 
        ? getYouTubeEmbed(articulo.video_url) 
        : null;

    media = dynamicMedia.length > 0 ? dynamicMedia : [
        youtubeUrl ? { type: 'youtube', src: youtubeUrl, caption: '' } : null,
        articulo.video_url && !youtubeUrl ? { type: 'video', src: resolveMediaURL(articulo.video_url), caption: '' } : null,
        articulo.featured_image ? { id: articulo.featured_image, type: 'image', src: resolveMediaURL(articulo.featured_image), caption: '' } : null,
        ...mediaItems.map(m => ({ ...m, id: m.id || m.src, src: resolveMediaURL(m.src) }))
    ].filter(Boolean);

    if (media.length === 0) media.push({ type: 'image', src: '/img/placeholder.jpg', caption: 'Imagen no disponible' });

    if (articulo.date_created) {
        formattedDate = new Date(articulo.date_created).toLocaleDateString('es-ES', {
            day: 'numeric', month: 'long', year: 'numeric'
        });
    }
    const wordCount = (articulo.content_html || '').replace(/<[^>]*>/g, '').split(/\s+/).length;
    readingTime = Math.max(1, Math.ceil(wordCount / 200));

    // Inyección de Publicidad Nuthost en el medio de la lectura
    articulo.contentPart1 = articulo.content_html;
    articulo.contentPart2 = "";

    if (articulo.content_html) {
        const paragraphs = articulo.content_html.split('</p>');
        if (paragraphs.length > 5) {
            const midPoint = Math.floor(paragraphs.length / 2);
            articulo.contentPart1 = paragraphs.slice(0, midPoint).join('</p>') + '</p>';
            articulo.contentPart2 = paragraphs.slice(midPoint).join('</p>');
        }
    }

    // Schema estructurado de tipo NewsArticle para Google News/Discover y Microsoft Start
    const newsSchema = {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      "headline": articulo.title,
      "description": articulo.seo_description || (articulo.content_html || '').replace(/<[^>]*>/g, '').trim().substring(0, 220) || '',
      "image": [
        articulo.featured_image 
          ? getAssetUrl(articulo.featured_image, { width: 1200, format: 'jpg', quality: 90 }) 
          : 'https://javiermix.ar/img/og/javiermix-og.jpg'
      ],
      "datePublished": articulo.date_created,
      "dateModified": articulo.date_updated || articulo.date_created,
      "author": [{
        "@type": "Person",
        "name": articulo.author || 'Javier Mix',
        "url": 'https://javiermix.ar/sobre-javier'
      }],
      "publisher": {
        "@type": "Organization",
        "name": "Javier Mix",
        "logo": {
          "@type": "ImageObject",
          "url": 'https://javiermix.ar/logo/JavierMix2.png'
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://javiermix.ar/revista/${articulo.id}-${articulo.slug}`
      }
    };
    Astro.props.newsSchema = newsSchema;
}
---

<Layout 
  title={articulo?.title || "Error en Artículo"} 
  description={articulo?.seo_description || articulo?.title || "No se pudo cargar el artículo"}
  schema={articulo ? Astro.props.newsSchema : undefined}
  type="article"
  pubDate={articulo?.date_created}
  author={articulo?.author}
>
  <Header currentPath="/revista" />
  
  {!articulo ? (
    <main class="error-container" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center; background: #000; padding: 2rem;">
      <div class="error-box" style="max-width: 600px; padding: 4rem; border: 1px solid rgba(255,255,255,0.1); background: #0a0a0a;">
        <h1 style="color: var(--color-accent); font-size: 1.5rem; margin-bottom: 2rem; letter-spacing: 5px;">CRÓNICA NO DISPONIBLE</h1>
        <p style="color: rgba(255,255,255,0.6); margin-bottom: 3rem; line-height: 1.8; font-size: 0.9rem;">
            {connectionError || "No hemos podido recuperar esta historia. Verifica que el artículo esté marcado como 'Publicado' y que el slug sea correcto en Directus."}
        </p>
        <a href="/revista/" style="color: var(--color-accent); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 5px; font-size: 0.7rem; letter-spacing: 3px; font-weight: 700;">← VOLVER A LA REVISTA</a>
      </div>
    </main>
  ) : (
    <>
    <div class="reading-progress-container">
        <div class="reading-progress-bar" id="reading-progress"></div>
    </div>

    <article class={`magazine-article ${articulo.is_premium ? 'premium-edition' : ''}`}>
        <div class="split-layout">
            <aside class="visual-column">
                <div class="media-stage">
                    {media.map((m: any, index: number) => (
                        <div class={`media-layer ${index === 0 ? 'active' : ''}`} data-index={index}>
                            {m.type === 'video' ? (
                                <video src={m.src} class="media-video" muted autoplay loop playsinline></video>
                            ) : m.type === 'youtube' ? (
                                <iframe src={m.src} class="media-iframe" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                            ) : (
                                m.id && !m.id.startsWith('http') && !m.id.startsWith('/') ? (
                                    <OptimizedImage id={m.id} alt={articulo.title} class="media-img" loading={index === 0 ? "eager" : "lazy"} />
                                ) : (
                                    <img src={m.src} alt={articulo.title} class="media-img" loading={index === 0 ? "eager" : "lazy"} crossorigin="anonymous" />
                                )
                            )}
                        </div>
                    ))}


                    <!-- EXIF Overlay -->
                    <div class="media-exif-overlay" id="media-exif-overlay"></div>

                    {media.length > 1 && (
                        <div class="media-navigation" data-media-navigation>
                            <button class="nav-btn prev-btn" id="media-prev" aria-label="Foto anterior">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                            </button>
                            <div class="media-indicator">
                                <span id="media-current-num">1</span> <span class="divider">/</span> <span id="media-total-num">{media.length}</span>
                            </div>
                            <button class="nav-btn next-btn" id="media-next" aria-label="Foto siguiente">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </button>
                        </div>
                    )}
                </div>
            </aside>

            <section class="narrative-column">
                <header class="article-header">
                    <div class="eyebrow-row">
                        <span class="eyebrow">REVISTA ONLINE</span>
                        {articulo.is_premium && <span class="premium-badge">EDICIÓN EXCLUSIVA</span>}
                    </div>
                    <h1 class="headline">{articulo.title}</h1>
                    <div class="meta-row">
                        <div class="meta-item">
                            <span class="meta-label">AUTOR</span>
                            <span class="meta-value">{articulo.author || 'Javier Mix'}</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">EDICIÓN</span>
                            <span class="meta-value">{formattedDate}</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">LECTURA</span>
                            <span class="meta-value">{readingTime} MINUTOS</span>
                        </div>
                        <div class="meta-item header-rating-item">
                            <span class="meta-label">VALORACIÓN</span>
                            <div class="header-rating-stars" id="header-average-rating-container" title={`Puntuación promedio de ${feedback.averageRating} estrellas`}>
                                <span class="stars-span">
                                    {Array.from({ length: 5 }).map((_, i) => {
                                        const starNum = i + 1;
                                        if (feedback.averageRating >= starNum) {
                                            return <i class="fa-solid fa-star gold-star-icon"></i>;
                                        } else if (feedback.averageRating >= starNum - 0.5) {
                                            return <i class="fa-solid fa-star-half-stroke gold-star-icon"></i>;
                                        } else {
                                            return <i class="fa-regular fa-star gold-star-icon"></i>;
                                        }
                                    })}
                                </span>
                                <span class="rating-count-text" id="header-rating-count">({feedback.ratingsCount})</span>
                            </div>
                        </div>
                        
                        <button id="btn-listen" class="btn-listen-article" title="Escuchar artículo con IA">
                            <div class="btn-icon-wrapper">
                                <i class="fas fa-volume-up"></i>
                                <div class="audio-waves">
                                    <span></span><span></span><span></span>
                                </div>
                            </div>
                            <span class="btn-text">ESCUCHAR NOTA</span>
                        </button>
                    </div>
                </header>

                <div class="prose-content">
                    <Fragment set:html={articulo.contentPart1} />
                    
                    {articulo.contentPart2 && (
                        <div class="nuthost-ad-container">
                            <a href="https://clientes.nuthost.com/aff.php?aff=329" target="_blank" rel="noopener noreferrer" class="nuthost-ad-card">
                                <div class="ad-visual">
                                    <i class="fa-solid fa-server"></i>
                                </div>
                                <div class="ad-info">
                                    <span class="ad-eyebrow">PARTNER TECNOLÓGICO OFICIAL</span>
                                    <h4 class="ad-title">Alojamiento Web Premium</h4>
                                    <p class="ad-text">La infraestructura que potencia a JavierMix. Acelera tu presencia digital con Nuthost.</p>
                                </div>
                                <div class="ad-action">
                                    <span>DESCUBRIR</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </div>
                            </a>
                        </div>
                        <Fragment set:html={articulo.contentPart2} />
                    )}
                </div>
                
                {articulo.Bibliografia && (
                    <div class="article-bibliography">
                        <span class="bib-label">BIBLIOGRAFÍA:</span>
                        <p class="bib-content">{articulo.Bibliografia}</p>
                    </div>
                )}
                
                <!-- SECCIÓN DE FEEDBACK (VALORACIONES Y COMENTARIOS) -->
                <section class="article-feedback-section" id="comments-section" data-article-id={articulo.id}>
                    <h3 class="feedback-main-title">Opiniones y Eco de los Lectores</h3>
                    
                    <div class="feedback-grid">
                        <!-- Lado Izquierdo: Lista de comentarios -->
                        <div class="feedback-comments-list">
                            <h4 class="feedback-subtitle">Eco de los Lectores (<span id="comments-count-badge">{feedback.comments.length}</span>)</h4>
                            <div class="comments-container" id="comments-list-container">
                                {feedback.comments.length > 0 ? (
                                    feedback.comments.map((comment) => (
                                        <div class="comment-item">
                                            <header class="comment-header">
                                                <div class="comment-author-info">
                                                    <span class="comment-author">{comment.name}</span>
                                                    {comment.instagram && (
                                                        <a href={`https://instagram.com/${comment.instagram.replace('@', '')}`} target="_blank" class="comment-instagram" rel="noopener noreferrer">
                                                            <i class="fab fa-instagram"></i> @{comment.instagram.replace('@', '')}
                                                        </a>
                                                    )}
                                                </div>
                                                <span class="comment-date">
                                                    {new Date(comment.created_at).toLocaleDateString('es-ES', {
                                                        day: 'numeric', month: 'short', year: 'numeric'
                                                    })}
                                                </span>
                                            </header>
                                            {comment.rating && (
                                                <div class="comment-rating-display">
                                                    {Array.from({ length: 5 }).map((_, i) => (
                                                        <i class={`${i < comment.rating ? 'fa-solid' : 'fa-regular'} fa-star gold-star-icon`}></i>
                                                    ))}
                                                </div>
                                            )}
                                            <p class="comment-body">{comment.comment}</p>
                                        </div>
                                    ))
                                ) : (
                                    <div class="empty-comments">
                                        <p>No hay opiniones aún. Sé el primero en compartir tu eco.</p>
                                    </div>
                                )}
                            </div>
                        </div>

                        <!-- Lado Derecho: Formulario de opinión -->
                        <div class="feedback-form-block">
                            <h4 class="feedback-subtitle">Deja tu Huella</h4>
                            
                            <form id="feedback-form" class="feedback-premium-form">
                                <div class="rating-input-wrapper">
                                    <span class="rating-input-label">¿Qué te pareció esta crónica?</span>
                                    <div class="rating-stars-input" id="stars-input-container">
                                        {Array.from({ length: 5 }).map((_, i) => (
                                            <button type="button" class="star-btn" data-star={i + 1} aria-label={`Calificar con ${i + 1} estrellas`}>
                                                <i class="fa-regular fa-star interactive-star"></i>
                                            </button>
                                        ))}
                                    </div>
                                    <input type="hidden" name="rating" id="rating-hidden-value" value="" />
                                    {feedback.hasRated && (
                                        <span class="already-rated-warning">Ya has calificado esta crónica desde tu dirección IP. Solo puedes dejar un comentario sin una nueva calificación de estrellas.</span>
                                    )}
                                </div>

                                <div class="form-group-grid">
                                    <div class="form-group">
                                        <input type="text" id="input-name" name="name" required placeholder=" " class="premium-input" />
                                        <label for="input-name" class="premium-label">Nombre</label>
                                    </div>
                                    <div class="form-group">
                                        <input type="email" id="input-email" name="email" required placeholder=" " class="premium-input" />
                                        <label for="input-email" class="premium-label">Email</label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <input type="text" id="input-instagram" name="instagram" placeholder=" " class="premium-input" />
                                    <label for="input-instagram" class="premium-label">Instagram (Opcional)</label>
                                </div>

                                <div class="form-group">
                                    <textarea id="input-comment" name="comment" required placeholder=" " rows="4" class="premium-textarea"></textarea>
                                    <label for="input-comment" class="premium-label">Tu Opinión</label>
                                </div>

                                <button type="submit" class="btn-submit-feedback">
                                    <span class="btn-label-text">ENVIAR OPINIÓN</span>
                                    <div class="form-spinner"></div>
                                </button>
                                <div class="form-message" id="form-feedback-message"></div>
                            </form>
                        </div>
                    </div>
                </section>
                
                <div class="article-footer-nav">
                    <a href="/revista/" class="back-link">← VOLVER A LA REVISTA</a>
                </div>
            </section>
        </div>
    </article>
    </>
  )}
  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const layers = document.querySelectorAll('.media-layer');
    const prevBtn = document.getElementById('media-prev');
    const nextBtn = document.getElementById('media-next');
    const currentNum = document.getElementById('media-current-num');
    const exifOverlay = document.getElementById('media-exif-overlay');
    
    let current = 0;
    let exifrModule: any = null;

    async function updateExifForCurrentSlide() {
        if (!exifOverlay) return;
        exifOverlay.classList.remove('visible');
        if (!exifrModule) return;

        const activeLayer = layers[current] || document.querySelector('.media-layer');
        const img = activeLayer?.querySelector('.media-img');
        
        if (!img) return;

        try {
            const exif = await exifrModule.parse(img);
            if (exif && (exif.Artist || exif.Copyright || exif.ImageDescription)) {
                let html = '';
                if (exif.Artist) {
                    html += `<div class="media-exif-line"><strong>Autor:</strong> ${exif.Artist}</div>`;
                }
                if (exif.Copyright) {
                    html += `<div class="media-exif-line"><strong>Copyright:</strong> ${exif.Copyright}</div>`;
                }
                if (exif.ImageDescription) {
                    html += `<div class="media-exif-desc">${exif.ImageDescription}</div>`;
                }
                exifOverlay.innerHTML = html;
                exifOverlay.classList.add('visible');
            }
        } catch (e) {
            // Silently ignore errors
        }
    }

    // Dynamic import of exifr in the browser
    import('https://cdn.jsdelivr.net/npm/exifr@4.1.3/dist/lite.esm.js')
        .then(module => {
            exifrModule = module.default;
            updateExifForCurrentSlide();
        })
        .catch(err => console.error('Failed to load exifr:', err));

    if (layers.length > 1) {
        let autoplayTimer: any = null;

        function showSlide(index: number) {
            layers[current].classList.remove('active');
            current = (index + layers.length) % layers.length;
            layers[current].classList.add('active');
            
            if (currentNum) {
                currentNum.innerText = (current + 1).toString();
            }

            const activeVideo = layers[current].querySelector('video');
            if (activeVideo) {
                activeVideo.play().catch(() => {});
            }

            updateExifForCurrentSlide();
        }

        function startAutoplay() {
            stopAutoplay();
            autoplayTimer = setInterval(() => {
                showSlide(current + 1);
            }, 7000); // Transiciones de exactamente 7 segundos
        }

        function stopAutoplay() {
            if (autoplayTimer) {
                clearInterval(autoplayTimer);
            }
        }

        let isManualOverride = false;
        let overrideTimeout: any = null;
        const isMobile = window.innerWidth <= 1024;

        function setManualOverride(index: number) {
            isManualOverride = true;
            showSlide(index);
            if (overrideTimeout) clearTimeout(overrideTimeout);
            overrideTimeout = setTimeout(() => {
                isManualOverride = false;
            }, 10000);
            
            if (isMobile) startAutoplay();
        }

        // Lógica de visualización híbrida
        if (!isMobile) {
            // Escritorio: Scroll Spy (cambia imagen según lectura)
            const proseContent = document.querySelector('.prose-content');
            window.addEventListener('scroll', () => {
                if (isManualOverride || !proseContent) return;
                
                const rect = proseContent.getBoundingClientRect();
                const winHeight = window.innerHeight;
                
                // Progreso basado en cuánto texto ha pasado por el viewport
                const startThreshold = winHeight * 0.7; 
                let scrollProgress = (startThreshold - rect.top) / rect.height;
                scrollProgress = Math.max(0, Math.min(1, scrollProgress));
                
                const targetIndex = Math.min(layers.length - 1, Math.floor(scrollProgress * layers.length));
                
                if (targetIndex !== current && !isNaN(targetIndex)) {
                    showSlide(targetIndex);
                }
            }, { passive: true });
        } else {
            // Móvil: Autoplay solo si la galería está visible (arriba)
            const visualCol = document.querySelector('.visual-column');
            if (visualCol && 'IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            startAutoplay();
                        } else {
                            stopAutoplay();
                        }
                    });
                }, { threshold: 0.1 });
                observer.observe(visualCol);
            } else {
                startAutoplay();
            }
        }

        // Eventos para botones de la barra flotante
        prevBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            setManualOverride(current - 1);
        });

        nextBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            setManualOverride(current + 1);
        });

        // Click en laterales de la columna visual completa
        const visualColumn = document.querySelector('.visual-column');
        visualColumn?.addEventListener('click', (e) => {
            // Ignorar click si fue en el control flotante de navegación
            if ((e.target as HTMLElement).closest('[data-media-navigation]')) {
                return;
            }
            const rect = visualColumn.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const width = rect.width;
            
            if (clickX < width / 2) {
                setManualOverride(current - 1);
            } else {
                setManualOverride(current + 1);
            }
        });

        // Cambiar cursor según lado hovered para feedback visual premium
        visualColumn?.addEventListener('mousemove', (e: any) => {
            const rect = visualColumn.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const width = rect.width;
            
            if (x < width / 2) {
                visualColumn.classList.add('cursor-left');
                visualColumn.classList.remove('cursor-right');
            } else {
                visualColumn.classList.add('cursor-right');
                visualColumn.classList.remove('cursor-left');
            }
        });

        visualColumn?.addEventListener('mouseleave', () => {
            visualColumn.classList.remove('cursor-left', 'cursor-right');
        });

        // Navegación por teclado (Flechas)
        const handleKeyDown = (e: KeyboardEvent) => {
            if (e.key === 'ArrowLeft') {
                setManualOverride(current - 1);
            } else if (e.key === 'ArrowRight') {
                setManualOverride(current + 1);
            }
        };
        window.addEventListener('keydown', handleKeyDown);

        // Limpieza de eventos al cambiar de página (Astro transitions)
        document.addEventListener('astro:before-preparation', () => {
            window.removeEventListener('keydown', handleKeyDown);
            stopAutoplay();
            if (overrideTimeout) clearTimeout(overrideTimeout);
        }, { once: true });
    }

    const progressBar = document.getElementById('reading-progress');
    window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        if (progressBar) progressBar.style.width = scrolled + "%";
    });

    const btnListen = document.getElementById('btn-listen');
    const content = document.querySelector('.prose-content');
    let isReading = false;
    let utterance = null;

    // 🛡️ Detección de soporte y visibilidad
    if (!('speechSynthesis' in window)) {
        if (btnListen) btnListen.style.display = 'none';
    }

    // Inicializar voces para navegadores que cargan asíncronamente
    window.speechSynthesis.getVoices();

    btnListen?.addEventListener('click', () => {
        const synth = window.speechSynthesis;

        if (isReading) {
            resetAudioState();
            return;
        }

        // 📱 Parche para Móviles: Algunos navegadores necesitan un "resume" previo o están bloqueados
        if (synth.paused) {
            synth.resume();
        }

        // Limpieza de texto para una lectura fluida
        const rawText = content?.textContent || "";
        const cleanText = rawText.replace(/\s+/g, ' ').trim();
        
        if (!cleanText) return;

        utterance = new SpeechSynthesisUtterance(cleanText);
        
        // Selección inteligente de voz (Cualquier español disponible)
        let voices = synth.getVoices();
        
        // Si no hay voces, intentamos forzar una carga (algunos móviles lo requieren)
        if (voices.length === 0) {
            voices = window.speechSynthesis.getVoices();
        }

        const spanishVoice = voices.find(v => v.lang.startsWith('es-') || v.lang === 'es') || voices[0];
        
        if (spanishVoice) utterance.voice = spanishVoice;
        utterance.lang = spanishVoice?.lang || 'es-ES';
        utterance.rate = 0.95;
        utterance.pitch = 1;

        utterance.onstart = () => {
            isReading = true;
            btnListen.classList.add('playing');
            const btnText = btnListen.querySelector('.btn-text');
            if (btnText) (btnText as HTMLElement).innerText = "DETENER AUDIO";
        };

        utterance.onend = () => resetAudioState();
        utterance.onerror = (e) => {
            console.error("SpeechSynthesis Error:", e);
            // Si falla, intentamos resetear todo para permitir un nuevo intento
            resetAudioState();
        };

        // 🚀 Ejecución con limpieza de buffer previa
        synth.cancel();
        
        // Un pequeño delay ayuda a algunos navegadores móviles a procesar el nuevo speak
        setTimeout(() => {
            synth.speak(utterance!);
            // 📱 Segundo parche para móviles: Forzar el inicio si se queda en pendiente
            if (synth.paused) {
                synth.resume();
            }
        }, 150);
    });

    function resetAudioState() {
        isReading = false;
        window.speechSynthesis.cancel();
        if (btnListen) {
            btnListen.classList.remove('playing');
            const btnText = btnListen.querySelector('.btn-text');
            if (btnText) (btnText as HTMLElement).innerText = "ESCUCHAR NOTA";
        }
    }

    // 🏛️ Lógica del Sistema de Feedback (Estrellas + Comentarios)
    const feedbackSection = document.getElementById('comments-section');
    const articleId = feedbackSection ? parseInt(feedbackSection.dataset.articleId || '') : null;
    const form = document.getElementById('feedback-form') as HTMLFormElement;
    const starsContainer = document.getElementById('stars-input-container');
    const ratingHidden = document.getElementById('rating-hidden-value') as HTMLInputElement;
    const submitBtn = form?.querySelector('.btn-submit-feedback') as HTMLButtonElement;
    const formMsg = document.getElementById('form-feedback-message') as HTMLElement;
    const commentsListContainer = document.getElementById('comments-list-container');
    const commentsCountBadge = document.getElementById('comments-count-badge');
    const headerAverageRatingContainer = document.getElementById('header-average-rating-container');
    
    let selectedRating = 0;
    
    if (starsContainer && ratingHidden) {
        const stars = starsContainer.querySelectorAll('.star-btn');
        
        stars.forEach(btn => {
            const starValue = parseInt(btn.getAttribute('data-star') || '0');
            
            // Hover logic
            btn.addEventListener('mouseenter', () => {
                highlightStars(starValue);
            });
            
            btn.addEventListener('mouseleave', () => {
                highlightStars(selectedRating);
            });
            
            // Click logic
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                selectedRating = starValue;
                ratingHidden.value = starValue.toString();
                highlightStars(starValue);
            });
        });
        
        function highlightStars(count: number) {
            stars.forEach((btn, index) => {
                const starIcon = btn.querySelector('.interactive-star');
                if (starIcon) {
                    if (index < count) {
                        starIcon.className = 'fa-solid fa-star interactive-star active';
                    } else {
                        starIcon.className = 'fa-regular fa-star interactive-star';
                    }
                }
            });
        }
    }
    
    // Auto-prepending "@" in Instagram input on change/blur
    const inputInstagram = document.getElementById('input-instagram') as HTMLInputElement;
    inputInstagram?.addEventListener('blur', () => {
        let val = inputInstagram.value.trim();
        if (val.length > 0 && !val.startsWith('@')) {
            inputInstagram.value = '@' + val;
        }
    });

    // Form submission
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!articleId) return;

        const formData = new FormData(form);
        const name = formData.get('name')?.toString() || '';
        const email = formData.get('email')?.toString() || '';
        let instagram = formData.get('instagram')?.toString() || '';
        const comment = formData.get('comment')?.toString() || '';
        const rating = selectedRating > 0 ? selectedRating : null;

        if (instagram.length > 0 && !instagram.startsWith('@')) {
            instagram = '@' + instagram;
        }

        // Validate
        if (!name.trim() || !email.trim() || !comment.trim()) {
            showFormMessage('Por favor completa todos los campos requeridos', 'error');
            return;
        }

        try {
            // Start spinner & disable
            form.classList.add('loading');
            submitBtn.disabled = true;
            showFormMessage('', '');

            const response = await fetch('/api/magazine/feedback', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    articleId,
                    name,
                    email,
                    instagram: instagram || null,
                    comment,
                    rating
                })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.message || 'Error al enviar opinión');
            }

            // Success state
            showFormMessage('¡Muchas gracias por dejar tu huella en nuestra revista!', 'success');
            form.reset();
            selectedRating = 0;
            if (ratingHidden) ratingHidden.value = '';
            if (starsContainer) {
                const stars = starsContainer.querySelectorAll('.interactive-star');
                stars.forEach(s => s.className = 'fa-regular fa-star interactive-star');
            }

            // Re-render comments list dynamically
            if (commentsListContainer && data.comments) {
                commentsListContainer.innerHTML = '';
                if (data.comments.length > 0) {
                    data.comments.forEach((c: any) => {
                        const commentEl = document.createElement('div');
                        commentEl.className = 'comment-item reveal-fade-in';
                        
                        let starHTML = '';
                        if (c.rating) {
                            starHTML = `<div class="comment-rating-display">`;
                            for (let i = 0; i < 5; i++) {
                                starHTML += `<i class="${i < c.rating ? 'fa-solid' : 'fa-regular'} fa-star gold-star-icon"></i>`;
                            }
                            starHTML += `</div>`;
                        }

                        let instagramHTML = '';
                        if (c.instagram) {
                            instagramHTML = `
                                <a href="https://instagram.com/${c.instagram.replace('@', '')}" target="_blank" class="comment-instagram" rel="noopener noreferrer">
                                    <i class="fab fa-instagram"></i> @${c.instagram.replace('@', '')}
                                </a>
                            `;
                        }

                        const commentDate = new Date(c.created_at).toLocaleDateString('es-ES', {
                            day: 'numeric', month: 'short', year: 'numeric'
                        });

                        commentEl.innerHTML = `
                            <header class="comment-header">
                                <div class="comment-author-info">
                                    <span class="comment-author">${c.name}</span>
                                    ${instagramHTML}
                                </div>
                                <span class="comment-date">${commentDate}</span>
                            </header>
                            ${starHTML}
                            <p class="comment-body">${c.comment}</p>
                        `;
                        commentsListContainer.appendChild(commentEl);
                    });
                } else {
                    commentsListContainer.innerHTML = `
                        <div class="empty-comments">
                            <p>No hay opiniones aún. Sé el primero en compartir tu eco.</p>
                        </div>
                    `;
                }
            }

            // Update comments badge
            if (commentsCountBadge && data.comments) {
                commentsCountBadge.innerText = data.comments.length.toString();
            }

            // Update header star rating
            if (headerAverageRatingContainer && data.ratingsCount !== undefined) {
                const starsSpan = headerAverageRatingContainer.querySelector('.stars-span');
                const ratingCountSpan = document.getElementById('header-rating-count');
                
                if (starsSpan) {
                    let headerStarsHTML = '';
                    for (let i = 0; i < 5; i++) {
                        const starNum = i + 1;
                        if (data.averageRating >= starNum) {
                            headerStarsHTML += `<i class="fa-solid fa-star gold-star-icon"></i>`;
                        } else if (data.averageRating >= starNum - 0.5) {
                            headerStarsHTML += `<i class="fa-solid fa-star-half-stroke gold-star-icon"></i>`;
                        } else {
                            headerStarsHTML += `<i class="fa-regular fa-star gold-star-icon"></i>`;
                        }
                    }
                    starsSpan.innerHTML = headerStarsHTML;
                }
                
                if (ratingCountSpan) {
                    ratingCountSpan.innerText = `(${data.ratingsCount})`;
                }
                
                headerAverageRatingContainer.title = `Puntuación promedio de ${data.averageRating} estrellas`;
            }

            // If they rated, disable stars since they've already rated
            if (rating && !form.querySelector('.already-rated-warning')) {
                const wrapper = form.querySelector('.rating-input-wrapper');
                if (wrapper) {
                    const warning = document.createElement('span');
                    warning.className = 'already-rated-warning';
                    warning.innerText = 'Ya has calificado esta crónica desde tu dirección IP. Solo puedes dejar un comentario sin una nueva calificación de estrellas.';
                    wrapper.appendChild(warning);
                }
            }

        } catch (err: any) {
            console.error('Error submitting feedback:', err);
            showFormMessage(err.message || 'Error al conectar con el servidor', 'error');
        } finally {
            form.classList.remove('loading');
            submitBtn.disabled = false;
        }
    });

    function showFormMessage(msg: string, type: 'success' | 'error' | '') {
        if (!formMsg) return;
        formMsg.innerText = msg;
        formMsg.className = 'form-message ' + type;
    }

    // 🛑 Seguridad: Detener audio si el usuario navega (Astro View Transitions)
    document.addEventListener('astro:before-preparation', () => {
        window.speechSynthesis.cancel();
        isReading = false;
    });
  });
</script>

