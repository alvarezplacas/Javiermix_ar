---
// src/pages/revista/[...page].astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getAssetUrl, fetchFromDirectus, slugify, DirectusManager } from '@conexion/directus';
import { readItems } from '@directus/sdk';

// export const prerender = true; // Removido para usar SSR

// NOTA SOBRE VARIABLES DE ENTORNO DE DIRECTUS:
// DirectusManager y getAssetUrl utilizan internamente las variables de entorno de Directus:
// - import.meta.env.PUBLIC_DIRECTUS_URL

let allArticles = [];
try {
  const client = await DirectusManager.getClient();
  // Obtener todos los artículos publicados
  allArticles = await client.request(readItems('magazine' as any, { 
      filter: {
        status: { _in: ['published', 'Publicado'] }
      },
      sort: ['-date_created'],
      fields: ['*', { user_created: ['*'] }],
      limit: -1
  }));
} catch (e) {
  console.error('Error fetching articles for SSR pagination:', e);
}

const pageSize = 12;
const totalPages = Math.max(1, Math.ceil(allArticles.length / pageSize));
const currentPageParam = Astro.params.page;
const currentPage = currentPageParam ? parseInt(currentPageParam) : 1;

const dbArticles = allArticles.slice((currentPage - 1) * pageSize, currentPage * pageSize);

const page = {
  data: dbArticles,
  currentPage: currentPage,
  lastPage: totalPages,
  url: {
    prev: currentPage > 1 ? (currentPage === 2 ? '/revista' : `/revista/${currentPage - 1}`) : null,
    next: currentPage < totalPages ? `/revista/${currentPage + 1}` : null
  }
};

// 🛠️ Decodificador de entidades HTML para textos impecables (Estándar JMX Oro)
function decodeHtml(html: string): string {
  if (!html) return '';
  return html
    .replace(/&eacute;/g, 'é')
    .replace(/&ecute;/g, 'é') // Parche para entidad mal escrita en CMS
    .replace(/&aacute;/g, 'á')
    .replace(/&iacute;/g, 'í')
    .replace(/&oacute;/g, 'ó')
    .replace(/&uacute;/g, 'ú')
    .replace(/&ntilde;/g, 'ñ')
    .replace(/&Eacute;/g, 'É')
    .replace(/&Aacute;/g, 'Á')
    .replace(/&Iacute;/g, 'Í')
    .replace(/&Oacute;/g, 'Ó')
    .replace(/&Uacute;/g, 'Ú')
    .replace(/&Ntilde;/g, 'Ñ')
    .replace(/&ldquo;/g, '“')
    .replace(/&rdquo;/g, '”')
    .replace(/&rsquo;/g, '’')
    .replace(/&lsquo;/g, '‘')
    .replace(/&quot;/g, '"')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&nbsp;/g, ' ')
    .replace(/&mdash;/g, '—');
}

function resolveMedia(id: any): { url: string, type: 'image' | 'video' } {
  const url = id?.id ? getAssetUrl(id.id) : (typeof id === 'string' ? (id.startsWith('http') ? id : getAssetUrl(id)) : '/img/placeholder.jpg');
  const type = (url?.toLowerCase().endsWith('.mp4') || url?.includes('video')) ? 'video' : 'image';
  return { url: url || '/img/placeholder.jpg', type };
}

// 📂 Búsqueda de Carpetas de Revista para asociar imágenes dinámicas automáticamente (Estándar JMX Oro)
let folderMediaMap = new Map();
try {
  const parentRes = await fetchFromDirectus('/folders?filter[name][_eq]=Revista&limit=1');
  const parentJson = await parentRes.json();
  const parentFolder = parentJson.data?.[0];

  if (parentFolder) {
    const subRes = await fetchFromDirectus(`/folders?filter[parent][_eq]=${parentFolder.id}&limit=-1`);
    const subJson = await subRes.json();
    const subFolders = subJson.data || [];

    // Mapear carpetas que coincidan con slugs
    const matchingFolderIds = [];
    const folderToSlugMap = new Map();

    subFolders.forEach((f: any) => {
      const normalizedFolderName = slugify(f.name);
      folderToSlugMap.set(f.id, normalizedFolderName);
      matchingFolderIds.push(f.id);
    });

    if (matchingFolderIds.length > 0) {
      const filesRes = await fetchFromDirectus(`/files?filter[folder][_in]=${matchingFolderIds.join(',')}&sort=filename_download&limit=-1`);
      const filesJson = await filesRes.json();
      const files = filesJson.data || [];

      // Agrupar archivos por el slug normalizado de su carpeta
      files.forEach((file: any) => {
        const folderId = file.folder;
        const slugName = folderToSlugMap.get(folderId);
        if (slugName) {
          if (!folderMediaMap.has(slugName)) {
            folderMediaMap.set(slugName, []);
          }
          folderMediaMap.get(slugName).push({
            id: file.id,
            type: file.type?.startsWith('video/') ? 'video' : 'image',
            url: getAssetUrl(file.id, file.type?.startsWith('video/') ? { raw: true } : { width: 1600 })
          });
        }
      });
      console.log(`[Revista-SSR] 📁 Escaneadas ${subFolders.length} carpetas. Asociadas a ${folderMediaMap.size} artículos de revista.`);
    }
  }
} catch (e) {
  console.error('[Revista-SSR] Error al cargar multimedia dinámico por carpetas:', e);
}

const articles = dbArticles.map(art => {
  const wordCount = (art.content_html || '').replace(/<[^>]*>/g, '').split(/\s+/).length;
  const readTime = Math.max(1, Math.ceil(wordCount / 200));

  // 1. Iniciar slideshow con la imagen de portada principal solo si existe
  let slideshow = [];
  if (art.featured_image) {
    slideshow.push(resolveMedia(art.featured_image));
  }
  
  // 2. Intentar buscar fotos dinámicas en la carpeta asociada al slug/título de la nota
  const normalizedSlug = slugify(art.slug || art.title || '');
  const dynamicPhotos = folderMediaMap.get(normalizedSlug) || [];

  if (dynamicPhotos.length > 0) {
    // Si existen fotos en la carpeta, las cargamos automáticamente
    const mappedDynamic = dynamicPhotos.map(p => ({ url: p.url, type: p.type }));
    slideshow = [...slideshow, ...mappedDynamic].slice(0, 6);
  } else if (art.media_json) {
    // Fallback: usar media_json si no hay carpeta o está vacía
    try {
        const extraRaw = typeof art.media_json === 'string' ? JSON.parse(art.media_json) : art.media_json;
        if (Array.isArray(extraRaw)) {
            const extra = extraRaw.map(m => resolveMedia(m));
            slideshow = [...slideshow, ...extra].slice(0, 6);
        }
    } catch(e) { console.error("Error parsing media_json", e); }
  }

  // 3. Fallback de seguridad si no hay ninguna foto
  if (slideshow.length === 0) {
      slideshow.push({ url: '/logo_footer_dorado.png', type: 'image' });
  }

  // Limpiar HTML y decodificar entidades en el título y extracto
  const plainTextExcerpt = (art.content_html || '').replace(/<[^>]*>/g, '').trim();
  const cleanExcerpt = decodeHtml(plainTextExcerpt.substring(0, 220)) + (plainTextExcerpt.length > 220 ? '...' : '');
  const cleanTitle = decodeHtml(art.title || '');

  return {
    id: art.id,
    title: cleanTitle,
    excerpt: cleanExcerpt,
    slideshow,
    readTime: `${readTime} min`,
    link: `/revista/${art.id}-${art.slug}`,
    location: "Buenos Aires",
    category: art.tags ? art.tags.split(',')[0].trim() : "Ensayo Visual"
  };
});
---

<Layout
  title="Revista Digital de Fotografía Fine Art"
  description="Artículos, ensayos visuales y crónicas sobre fotografía de autor, diseño de interiores y el arte de coleccionar imágenes."
  url="/revista"
>
  <Header currentPath="/revista" />

  <main class="revista-main">
    <div class="revista-hero">
      <div class="hero-bg-line"></div>
      <span class="issue-tag">Vol. I · 2026</span>
      <h1 class="revista-title">REVISTA DIGITAL</h1>
      <p class="revista-subtitle">Crónicas de luz, memoria y potencia estética para coleccionistas y decoradores.</p>
      
      {articles.length === 0 && (
        <div style="color: #c94c4c; font-size: 0.7rem; margin-top: 1rem; opacity: 0.7; letter-spacing: 2px;">
          DIAGNÓSTICO: No se encontraron artículos. Verifica permisos en Directus (colección 'magazine' o 'Magazine').
        </div>
      )}
    </div>

    <div class="articles-wrapper">
      {articles.length > 0 ? (
        articles.map((article, index) => (
          <article class={`article-row ${index % 2 !== 0 ? 'reversed' : ''}`} data-article-card>
            <div class="article-visual">
              <div class="tilt-frame" data-tilt-container>
                <div class="slideshow-wrapper">
                    {article.slideshow.map((media, i) => (
                        media.type === 'video' ? (
                            <video src={media.url} class={`article-media ${i === 0 ? 'active' : ''}`} muted playsinline loop autoplay></video>
                        ) : (
                            <img src={media.url} alt={`${article.title} - view ${i}`} class={`article-media ${i === 0 ? 'active' : ''}`} loading="lazy" onerror="this.onerror=null; this.style.display='none'; this.classList.remove('active'); if(this.nextElementSibling) this.nextElementSibling.classList.add('active'); else this.src='/logo_footer_dorado.png';" />
                        )
                    ))}
                </div>
                <div class="image-glare"></div>
              </div>
            </div>

            <div class="article-text">
              <div class="article-meta-header">
                <span class="category-tag-inline">{article.category}</span>
                <span class="separator">·</span>
                <span class="article-location">{article.location}</span>
              </div>
              <h2 class="article-headline">{article.title}</h2>
              <p class="article-excerpt">{article.excerpt}</p>

              <footer class="article-footer">
                <div class="read-time">
                  <span>{article.readTime} de lectura</span>
                </div>
                <a href={article.link} class="btn-leer">
                  LEER NOTA
                </a>
              </footer>
            </div>
          </article>
        ))
      ) : (
        <div class="empty-state">
           <p>Próximamente nuevas crónicas y ensayos visuales.</p>
        </div>
      )}
    </div>

    <!-- Controles de Paginación Premium -->
    {page.lastPage > 1 && (
      <div class="pagination-container">
        {page.url.prev ? (
          <a href={page.url.prev} class="btn-pagination">← ANTERIORES</a>
        ) : (
          <span class="btn-pagination disabled">← ANTERIORES</span>
        )}
        <span class="page-indicator">Edición {page.currentPage} de {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="btn-pagination">SIGUIENTES →</a>
        ) : (
          <span class="btn-pagination disabled">SIGUIENTES →</span>
        )}
      </div>
    )}
  </main>

  <Footer />
</Layout>

<script>
    function initMagazine() {
        // 🎞️ SLIDESHOW LÓGICA (CROSS-FADE HÍBRIDO)
        const articles = document.querySelectorAll('[data-article-card]');
        articles.forEach(art => {
            const media = art.querySelectorAll('.article-media');
            if (media.length <= 1) {
                // Si solo hay una imagen, igual activarla
                if(media[0]) media[0].classList.add('active');
                return;
            }

            let current = 0;
            // Limpiar intervalos previos si existen
            if ((art as any)._slideInterval) clearInterval((art as any)._slideInterval);
            
            (art as any)._slideInterval = setInterval(() => {
                let prev = current;
                media[current].classList.remove('active');
                
                // Buscar la siguiente imagen que no esté oculta (rota)
                do {
                    current = (current + 1) % media.length;
                } while ((media[current] as HTMLElement).style.display === 'none' && current !== prev);
                
                media[current].classList.add('active');
                
                if (media[current].tagName === 'VIDEO') {
                    (media[current] as HTMLVideoElement).play().catch(() => {});
                }
            }, 8000);
        });

        // 💡 EFECTO 3D SUAVE Y AMORTIGUADO (ESTÁNDAR PREMIUM JMX)
        const tiltFrames = document.querySelectorAll('[data-tilt-container]');
        tiltFrames.forEach(container => {
            container.addEventListener('mousemove', (e: any) => {
                const r = container.getBoundingClientRect();
                const x = e.clientX - r.left; 
                const y = e.clientY - r.top;
                const rx = (y - r.height/2) / 60; // Reducido a 60 para una inclinación muy sutil y elegante
                const ry = (r.width/2 - x) / 60; // Reducido a 60 para una inclinación muy sutil y elegante
                
                (container as HTMLElement).style.transform = `perspective(1200px) rotateX(${rx}deg) rotateY(${ry}deg) scale3d(1.015, 1.015, 1.015)`; // Escala reducida a 1.015 para evitar brincos bruscos
                
                const glare = container.querySelector('.image-glare') as HTMLElement;
                if (glare) {
                    const px = (x / r.width) * 100;
                    const py = (y / r.height) * 100;
                    glare.style.background = `radial-gradient(circle at ${px}% ${py}%, rgba(255,255,255,0.12) 0%, transparent 80%)`;
                    glare.style.opacity = "1";
                }
            });

            container.addEventListener('mouseleave', () => {
                (container as HTMLElement).style.transform = `perspective(1200px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
                const glare = container.querySelector('.image-glare') as HTMLElement;
                if (glare) glare.style.opacity = "0";
            });
        });
    }

    // Ejecutar en ambos eventos para máxima compatibilidad
    document.addEventListener('astro:page-load', initMagazine);
    document.addEventListener('DOMContentLoaded', initMagazine);
    initMagazine(); // Ejecución inmediata
</script>

<style>
  .revista-main { 
    background-color: var(--color-bg); 
    min-height: 100vh; 
    padding-top: 5rem; 
    transition: background-color 0.5s ease;
  }
  
  .revista-hero { 
    text-align: center; 
    padding: 8rem 2rem 6rem; 
    position: relative; 
    border-bottom: 1px solid var(--glass-border); 
    transition: border-color 0.5s ease;
  }
  
  .hero-bg-line { 
    position: absolute; 
    left: 50%; 
    top: 0; 
    width: 1px; 
    height: 100%; 
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent); 
    opacity: 0.3; 
    transform: translateX(-50%); 
  }
  
  .issue-tag { 
    display: inline-block; 
    font-size: 0.7rem; 
    letter-spacing: 4px; 
    text-transform: uppercase; 
    color: var(--color-accent); 
    margin-bottom: 2rem; 
    border: 1px solid var(--glass-border); 
    padding: 0.4rem 1.2rem; 
    transition: border-color 0.5s ease, color 0.5s ease;
  }
  
  .revista-title { 
    font-size: clamp(3rem, 8vw, 7rem); 
    font-weight: 300; 
    letter-spacing: 10px; 
    color: var(--color-white); 
    margin-bottom: 2rem; 
    transition: color 0.5s ease;
  }
  
  .revista-subtitle { 
    font-size: 1.1rem; 
    font-weight: 300; 
    color: var(--color-text-muted); 
    max-width: 600px; 
    margin: 0 auto; 
    line-height: 1.6; 
    transition: color 0.5s ease;
  }

  .articles-wrapper { 
    max-width: 1400px; 
    margin: 0 auto; 
    padding: 8rem 5% 4rem; 
    display: flex; 
    flex-direction: column; 
    gap: 12rem; 
  }
  
  .article-row { 
    display: grid; 
    grid-template-columns: 1.1fr 0.9fr; 
    gap: 6rem; 
    align-items: center; 
  }
  
  .article-row.reversed { 
    direction: rtl; 
  }
  
  .article-row.reversed > * { 
    direction: ltr; 
  }
  
  .article-visual { 
    position: relative; 
    perspective: 1000px; 
  }
  
  /* 🖼️ Premium "Pared de Galería" Passepartout Frame */
  .tilt-frame { 
    width: 100%; 
    height: 520px; 
    overflow: hidden; 
    position: relative; 
    background: #0d0d0c; 
    border: 24px solid #f9f8f6; /* Elegant textured cotton paper mat */
    box-shadow: 
      0 30px 60px rgba(0, 0, 0, 0.5), 
      inset 0 0 12px rgba(0, 0, 0, 0.18),
      0 0 0 1px rgba(197, 160, 89, 0.2); 
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
    transform-style: preserve-3d;
  }
  
  .article-row:hover .tilt-frame {
    box-shadow: 0 45px 90px rgba(0, 0, 0, 0.7), 0 0 15px rgba(197, 160, 89, 0.1);
    transition: transform 0.15s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.6s ease; 
  }
  
  .slideshow-wrapper { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    background: #000;
    box-shadow: inset 0 0 80px rgba(0,0,0,0.8);
    z-index: 2;
  }
  
  .article-media { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    filter: grayscale(15%) brightness(0.85); 
    transition: opacity 2.5s ease, filter 1.5s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); 
    opacity: 0;
    z-index: 1;
    mask-image: radial-gradient(circle, black 70%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle, black 70%, transparent 100%);
  }
  
  .article-media.active { 
    opacity: 1; 
    filter: grayscale(0%) brightness(1); 
    z-index: 2; 
  }
  
  .article-row:hover .article-media.active {
    transform: scale(1.04);
  }
  
  .image-glare { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    pointer-events: none; 
    z-index: 5; 
    opacity: 0; 
    transition: opacity 0.3s;
  }
  
  .article-text { 
    padding: 1rem 0; 
    display: flex; 
    flex-direction: column; 
    justify-content: center;
  }
  
  .article-meta-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .category-tag-inline {
    font-family: var(--font-secondary), sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 3px;
    color: #c5a059;
    text-transform: uppercase;
  }

  .separator {
    color: rgba(255, 255, 255, 0.15);
    font-size: 0.8rem;
  }

  .article-location { 
    display: block; 
    font-size: 0.65rem; 
    letter-spacing: 3px; 
    text-transform: uppercase; 
    color: rgba(255, 255, 255, 0.5); 
    font-family: var(--font-secondary); 
    font-weight: 500; 
    transition: color 0.5s ease;
  }
  
  .article-headline { 
    font-size: clamp(2.2rem, 3.5vw, 3.2rem); 
    font-weight: 300; 
    font-style: italic; 
    color: var(--color-white); 
    line-height: 1.25; 
    margin-bottom: 2rem; 
    font-family: var(--font-primary); 
    transition: color 0.4s ease;
  }
  
  .article-row:hover .article-headline {
    color: #c5a059;
  }
  
  .article-excerpt { 
    color: var(--color-text-muted); 
    font-family: var(--font-secondary);
    font-size: 0.95rem; 
    line-height: 1.85; 
    font-weight: 300; 
    margin-bottom: 3rem; 
    transition: color 0.5s ease;
  }
  
  .article-footer { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    border-top: 1px solid var(--glass-border); 
    padding-top: 2rem; 
    transition: border-color 0.5s ease;
  }
  
  .read-time { 
    color: var(--color-text-muted); 
    font-family: var(--font-secondary); 
    font-weight: 400; 
    font-size: 0.7rem; 
    letter-spacing: 2px; 
    text-transform: uppercase; 
    transition: color 0.5s ease;
  }
  
  .btn-leer { 
    position: relative; 
    color: var(--color-white); 
    font-family: var(--font-secondary); 
    font-size: 0.75rem; 
    font-weight: 700; 
    letter-spacing: 3px; 
    text-decoration: none; 
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    transition: color 0.4s ease;
  }

  .btn-leer::after {
    content: '→';
    font-size: 0.95rem;
    color: #c5a059;
    transition: transform 0.3s ease;
  }

  .btn-leer:hover {
    color: #c5a059;
  }

  .btn-leer:hover::after {
    transform: translateX(5px);
  }
  
  .empty-state {
    text-align: center;
    padding: 6rem 2rem;
    color: var(--color-text-muted);
    font-family: var(--font-secondary);
    font-size: 1rem;
    letter-spacing: 1px;
    border: 1px dashed var(--glass-border);
  }

  /* Estilos de Paginación Premium */
  .pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    margin: 4rem auto 8rem;
    font-family: var(--font-secondary);
  }
  .btn-pagination {
    color: var(--color-white);
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 2px;
    font-weight: 700;
    transition: color 0.3s;
    border-bottom: 1px solid transparent;
    padding-bottom: 4px;
    text-transform: uppercase;
  }
  .btn-pagination:hover:not(.disabled) {
    color: #c5a059;
    border-bottom-color: #c5a059;
  }
  .btn-pagination.disabled {
    opacity: 0.25;
    cursor: not-allowed;
    pointer-events: none;
  }
  .page-indicator {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .article-row { 
      grid-template-columns: 1fr; 
      gap: 4rem; 
      direction: ltr !important; 
    }
    .articles-wrapper { 
      gap: 8rem; 
      padding: 4rem 5% 2rem;
    }
    .tilt-frame { 
      height: 380px; 
      border: 8px solid var(--color-bg); 
    }
    .article-row:hover .article-headline {
      transform: none;
    }
    .pagination-container {
      gap: 1.5rem;
      margin-bottom: 6rem;
    }
  }
</style>
