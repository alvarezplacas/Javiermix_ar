</style>

<!-- Script de Cliente para el renderizado 3D WebGL -->
<script>
    import * as THREE from 'three';

    // 🔬 Audio procedimental para simular la rotura del vidrio
    function playShatterSound() {
        try {
            const AudioContext = window.AudioContext || (window as any).webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            
            // Sonido metálico/vidrio rompiéndose
            const numNotes = 8 + Math.floor(Math.random() * 6);
            for (let i = 0; i < numNotes; i++) {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                
                osc.connect(gain);
                gain.connect(ctx.destination);
                
                const freq = 1800 + Math.random() * 2500;
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(150 + Math.random() * 400, ctx.currentTime + 0.1 + Math.random() * 0.2);
                
                osc.type = Math.random() > 0.5 ? 'triangle' : 'sine';
                
                const startTime = ctx.currentTime + Math.random() * 0.06;
                const duration = 0.15 + Math.random() * 0.25;
                
                gain.gain.setValueAtTime(0, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.12 / numNotes, startTime + 0.005);
                gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
                
                osc.start(startTime);
                osc.stop(startTime + duration);
            }
            
            // Ruido blanco para el impacto sordo inicial
            const bufferSize = ctx.sampleRate * 0.25; 
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }
            
            const noise = ctx.createBufferSource();
            noise.buffer = buffer;
            
            const noiseFilter = ctx.createBiquadFilter();
            noiseFilter.type = 'bandpass';
            noiseFilter.frequency.value = 3500;
            noiseFilter.Q.value = 1.5;
            
            const noiseGain = ctx.createGain();
            noiseGain.gain.setValueAtTime(0.15, ctx.currentTime);
            noiseGain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.2);
            
            noise.connect(noiseFilter);
            noiseFilter.connect(noiseGain);
            noiseGain.connect(ctx.destination);
            
            noise.start();
        } catch (e) {
            console.warn("AudioContext bloqueado o no soportado por el navegador:", e);
        }
    }

    // --- VARIABLES Y SELECTORES ---
    const dataEl = document.getElementById('series-data');
    if (!dataEl) throw new Error("No series-data element found");
    const seriesMap = JSON.parse(dataEl.getAttribute('data-series') || '{}');

    const seriesSelect = document.getElementById('series-select') as HTMLSelectElement;
    const metaTitle = document.getElementById('meta-title')!;
    const metaDim = document.getElementById('meta-dim')!;
    const metaSize = document.getElementById('meta-size')!;
    const metaDate = document.getElementById('meta-date')!;
    const valShards = document.getElementById('val-shards')!;
    const valGravity = document.getElementById('val-gravity')!;
    const paramShards = document.getElementById('param-shards') as HTMLInputElement;
    const paramGravity = document.getElementById('param-gravity') as HTMLInputElement;
    const progressFill = document.getElementById('progress-indicator')!;
    const trackerCount = document.getElementById('tracker-count')!;
    const container = document.getElementById('canvas-container')!;

    let currentSeriesName = seriesSelect.value;
    let currentPhotos = seriesMap[currentSeriesName] || [];
    let currentIndex = 0;

    // Físicas configurables
    let configShards = parseInt(paramShards.value, 10);
    let configGravity = parseFloat(paramGravity.value);

    paramShards.addEventListener('input', () => {
        configShards = parseInt(paramShards.value, 10);
        valShards.textContent = configShards.toString();
    });

    paramGravity.addEventListener('input', () => {
        configGravity = parseFloat(paramGravity.value);
        valGravity.textContent = configGravity.toFixed(1);
    });

    // --- MOTOR 3D (THREE.JS) ---
    let scene: THREE.Scene, 
        camera: THREE.PerspectiveCamera, 
        renderer: THREE.WebGLRenderer;
        
    let solidMesh: THREE.Mesh | null = null;
    let nextMesh: THREE.Mesh | null = null;
    let activeShardsGroup: THREE.Group | null = null;
    let activeShardsList: THREE.Mesh[] = [];
    
    let isShattered = false;
    let isTransitioning = false;
    let currentTexture: THREE.Texture | null = null;
    let nextTexture: THREE.Texture | null = null;

    const textureLoader = new THREE.TextureLoader();
    textureLoader.crossOrigin = 'anonymous';
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    const pointLight = new THREE.PointLight(0xdcb14a, 8, 15);

    // Inicializar Escenario
    function init3D() {
        const width = container.clientWidth;
        const height = container.clientHeight;

        scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x030303, 0.05);

        camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
        camera.position.z = 10;

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        // Luces
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.45);
        scene.add(ambientLight);

        // Luz direccional suave
        const dirLight = new THREE.DirectionalLight(0xffffff, 0.35);
        dirLight.position.set(0, 10, 10);
        scene.add(dirLight);

        // Luz puntual de cursor interactiva
        pointLight.position.set(0, 0, 2);
        scene.add(pointLight);

        // Eventos
        window.addEventListener('resize', onResize);
        container.addEventListener('click', onStageClick);
        container.addEventListener('mousemove', onMouseMove);

        // Cargar primera obra
        loadSlide(0);
        animate();
    }

    function onResize() {
        const width = container.clientWidth;
        const height = container.clientHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
    }

    function onMouseMove(e: MouseEvent) {
        const rect = container.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        const y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        // Mapear luz puntual interactiva
        pointLight.position.x = x * 5;
        pointLight.position.y = y * 4;
        pointLight.position.z = 1.5;
    }

    // --- CARGAR TEXTURAS E IMÁGENES ---
    function loadSlide(index: number) {
        if (currentPhotos.length === 0) return;

        isShattered = false;
        isTransitioning = false;
        
        // Limpieza de shards anteriores
        clearShards();

        const photo = currentPhotos[index];
        updateUI(photo, index);

        // Cargar textura principal
        textureLoader.load(photo.src, (texture) => {
            currentTexture = texture;
            currentTexture.colorSpace = THREE.SRGBColorSpace;
            setupActiveMesh(currentTexture);

            // Pre-cargar la textura siguiente para transiciones inmediatas
            const nextIndex = (index + 1) % currentPhotos.length;
            const nextPhoto = currentPhotos[nextIndex];
            textureLoader.load(nextPhoto.src, (nTex) => {
                nextTexture = nTex;
                nextTexture.colorSpace = THREE.SRGBColorSpace;
                setupNextMesh(nextTexture);
            });
        });
    }

    function updateUI(photo: any, index: number) {
        metaTitle.textContent = photo.title.toUpperCase();
        metaDim.textContent = photo.metadata.dim;
        metaSize.textContent = photo.metadata.size;
        metaDate.textContent = photo.metadata.date;

        const total = currentPhotos.length;
        trackerCount.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        progressFill.style.width = `${((index + 1) / total) * 100}%`;
    }

    function calculatePlaneSize(texture: THREE.Texture) {
        const aspect = texture.image.width / texture.image.height;
        const maxW = 5.8;
        const maxH = 4.0;
        let w = maxW;
        let h = w / aspect;
        if (h > maxH) {
            h = maxH;
            w = h * aspect;
        }
        return { w, h };
    }

    function setupActiveMesh(texture: THREE.Texture) {
        if (solidMesh) {
            scene.remove(solidMesh);
            solidMesh.geometry.dispose();
            (solidMesh.material as THREE.Material).dispose();
        }

        const size = calculatePlaneSize(texture);
        const geom = new THREE.PlaneGeometry(size.w, size.h);
        const mat = new THREE.MeshPhongMaterial({
            map: texture,
            side: THREE.DoubleSide,
            shininess: 40,
            specular: new THREE.Color(0xdcb14a)
        });

        solidMesh = new THREE.Mesh(geom, mat);
        solidMesh.position.set(0, 0, 0);
        solidMesh.scale.set(1, 1, 1);
        scene.add(solidMesh);
    }

    function setupNextMesh(texture: THREE.Texture) {
        if (nextMesh) {
            scene.remove(nextMesh);
            nextMesh.geometry.dispose();
            (nextMesh.material as THREE.Material).dispose();
        }

        const size = calculatePlaneSize(texture);
        const geom = new THREE.PlaneGeometry(size.w, size.h);
        const mat = new THREE.MeshPhongMaterial({
            map: texture,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0,
            shininess: 40
        });

        nextMesh = new THREE.Mesh(geom, mat);
        // Colocar detrás y escalado hacia abajo
        nextMesh.position.set(0, 0, -3);
        nextMesh.scale.set(0.65, 0.65, 0.65);
        scene.add(nextMesh);
    }

    function clearShards() {
        if (activeShardsGroup) {
            scene.remove(activeShardsGroup);
            activeShardsList.forEach(s => {
                s.geometry.dispose();
                if (Array.isArray(s.material)) {
                    s.material.forEach(m => m.dispose());
                } else {
                    s.material.dispose();
                }
            });
            activeShardsList = [];
            activeShardsGroup = null;
        }
    }

    // --- ACCIÓN DE ROTURA (CLICK) ---
    function onStageClick(e: MouseEvent) {
        if (isShattered || isTransitioning || !solidMesh || !currentTexture) return;

        const rect = container.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouse, camera);
        const intersects = raycaster.intersectObject(solidMesh);

        if (intersects.length > 0) {
            // Punto de impacto en la geometría local
            const impact = intersects[0].point;
            shatterAndSlide(impact);
        }
    }

    function shatterAndSlide(impactPoint: THREE.Vector3) {
        isShattered = true;
        isTransitioning = true;

        // Sonido procedimental
        playShatterSound();

        // 1. Generar Shards 3D
        const size = calculatePlaneSize(currentTexture!);
        const shardData = createShards3D(currentTexture!, size.w, size.h, impactPoint);

        activeShardsGroup = shardData.group;
        activeShardsList = shardData.shards;
        scene.add(activeShardsGroup);

        // 2. Ocultar lienzo plano
        if (solidMesh) solidMesh.visible = false;

        // 3. Animación de entrada suave del siguiente slide
        let startSlideTime = document.timeline ? document.timeline.currentTime as number : performance.now();
        const slideDuration = 1400; // ms

        function animateSlideIn() {
            if (!nextMesh) return;

            const now = document.timeline ? document.timeline.currentTime as number : performance.now();
            const elapsed = now - startSlideTime;
            const progress = Math.min(elapsed / slideDuration, 1);

            // Curva Bézier fluida de desaceleración (easeOutCubic)
            const ease = 1 - Math.pow(1 - progress, 3);

            // Animar propiedades
            nextMesh.position.z = -3 + (ease * 3);
            const currentScale = 0.65 + (ease * 0.35);
            nextMesh.scale.set(currentScale, currentScale, currentScale);
            (nextMesh.material as THREE.Material).opacity = ease;

            if (progress < 1) {
                requestAnimationFrame(animateSlideIn);
            } else {
                // Finaliza transición
                currentIndex = (currentIndex + 1) % currentPhotos.length;
                
                // El siguiente pasa a ser el activo
                solidMesh = nextMesh;
                solidMesh.position.set(0, 0, 0);
                solidMesh.scale.set(1, 1, 1);
                (solidMesh.material as THREE.Material).opacity = 1;
                
                currentTexture = nextTexture;
                nextMesh = null;
                
                isShattered = false;
                isTransitioning = false;

                // Cargar metadatos del actual
                const photo = currentPhotos[currentIndex];
                updateUI(photo, currentIndex);

                // Cargar de fondo la que sigue
                const nextIdx = (currentIndex + 1) % currentPhotos.length;
                const nextPhoto = currentPhotos[nextIdx];
                textureLoader.load(nextPhoto.src, (nTex) => {
                    nextTexture = nTex;
                    nextTexture.colorSpace = THREE.SRGBColorSpace;
                    setupNextMesh(nextTexture);
                });
            }
        }

        requestAnimationFrame(animateSlideIn);
    }

    // --- ALGORITMO DE FRACTURA ---
    function createShards3D(texture: THREE.Texture, width: number, height: number, impactPoint: THREE.Vector3) {
        const group = new THREE.Group();
        const shards: THREE.Mesh[] = [];

        // Generamos rejilla con ruido
        // Adaptar columnas y filas según el número de shards deseados
        const totalTarget = configShards;
        const ratio = width / height;
        const rows = Math.round(Math.sqrt(totalTarget / ratio));
        const cols = Math.round(rows * ratio);

        const cellW = width / cols;
        const cellH = height / rows;

        // Guardar nodos
        const nodes: THREE.Vector2[] = [];
        for (let r = 0; r <= rows; r++) {
            for (let c = 0; c <= cols; c++) {
                let x = (c / cols) - 0.5;
                let y = (r / rows) - 0.5;

                // Añadir ruido a los nodos internos
                if (c > 0 && c < cols && r > 0 && r < rows) {
                    x += (Math.random() - 0.5) * (1 / cols) * 0.45;
                    y += (Math.random() - 0.5) * (1 / rows) * 0.45;
                }

                nodes.push(new THREE.Vector2(x * width, y * height));
            }
        }

        const getNodeIdx = (c: number, r: number) => r * (cols + 1) + c;

        function addShard(p1: THREE.Vector2, p2: THREE.Vector2, p3: THREE.Vector2) {
            const geom = new THREE.BufferGeometry();

            // Mapeo en 3D
            const vertices = new Float32Array([
                p1.x, p1.y, 0,
                p2.x, p2.y, 0,
                p3.x, p3.y, 0
            ]);
            geom.setAttribute('position', new THREE.BufferAttribute(vertices, 3));

            // UVs
            const uvs = new Float32Array([
                (p1.x / width) + 0.5, (p1.y / height) + 0.5,
                (p2.x / width) + 0.5, (p2.y / height) + 0.5,
                (p3.x / width) + 0.5, (p3.y / height) + 0.5
            ]);
            geom.setAttribute('uv', new THREE.BufferAttribute(uvs, 2));

            geom.computeVertexNormals();

            const mat = new THREE.MeshPhongMaterial({
                map: texture,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 1,
                shininess: 90,
                specular: new THREE.Color(0xdcb14a),
                reflectivity: 0.8
            });

            const mesh = new THREE.Mesh(geom, mat);

            // Calcular baricentro
            const cx = (p1.x + p2.x + p3.x) / 3;
            const cy = (p1.y + p2.y + p3.y) / 3;

            // Físicas del estallido
            const dx = cx - impactPoint.x;
            const dy = cy - impactPoint.y;
            const dist = Math.sqrt(dx * dx + dy * dy) || 0.1;

            // Fuerza decae con la distancia
            const force = Math.max(0.1, 2.5 / (dist + 0.4));

            // Velocidad 3D
            const vx = (dx / dist) * force * 0.15 + (Math.random() - 0.5) * 0.05;
            const vy = (dy / dist) * force * 0.15 + (Math.random() - 0.5) * 0.05;
            const vz = (Math.random() * 0.12 + 0.05) * force;

            mesh.userData = {
                velocity: new THREE.Vector3(vx, vy, vz),
                angularVelocity: new THREE.Vector3(
                    (Math.random() - 0.5) * 0.18,
                    (Math.random() - 0.5) * 0.18,
                    (Math.random() - 0.5) * 0.18
                ),
                opacity: 1,
                // Breve retardo en la reacción según distancia para efecto de grieta
                delay: dist * 8
            };

            group.add(mesh);
            shards.push(mesh);
        }

        // Armar quads
        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
                const n00 = nodes[getNodeIdx(c, r)];
                const n10 = nodes[getNodeIdx(c + 1, r)];
                const n01 = nodes[getNodeIdx(c, r + 1)];
                const n11 = nodes[getNodeIdx(c + 1, r + 1)];

                // Rotura aleatoria en diagonales
                if (Math.random() > 0.5) {
                    addShard(n00, n10, n01);
                    addShard(n10, n11, n01);
                } else {
                    addShard(n00, n10, n11);
                    addShard(n00, n11, n01);
                }
            }
        }

        return { group, shards };
    }

    // --- BUCLE DE ANIMACIÓN (TICK) ---
    let lastTime = performance.now();

    function animate() {
        requestAnimationFrame(animate);

        const now = performance.now();
        const delta = Math.min((now - lastTime) / 16.666, 3); // normalizado a 60fps
        lastTime = now;

        // 1. Simulación física de shards
        if (activeShardsList.length > 0) {
            const gravityAcc = (configGravity / 1000) * delta;
            
            for (let i = 0; i < activeShardsList.length; i++) {
                const shard = activeShardsList[i];
                
                // Retardo de onda de impacto
                if (shard.userData.delay > 0) {
                    shard.userData.delay -= 16.666 * delta;
                    continue;
                }

                // Aplicar posición
                shard.position.addScaledVector(shard.userData.velocity, delta);

                // Aplicar rotación
                shard.rotation.x += shard.userData.angularVelocity.x * delta;
                shard.rotation.y += shard.userData.angularVelocity.y * delta;
                shard.rotation.z += shard.userData.angularVelocity.z * delta;

                // Aplicar aceleración por gravedad (Y decreciente)
                shard.userData.velocity.y -= gravityAcc;

                // Rozamiento del aire sutil
                shard.userData.velocity.multiplyScalar(Math.pow(0.975, delta));
                shard.userData.angularVelocity.multiplyScalar(Math.pow(0.975, delta));

                // Desvanecimiento
                shard.userData.opacity -= 0.008 * delta;
                const mat = shard.material as THREE.MeshPhongMaterial;
                mat.opacity = Math.max(0, shard.userData.opacity);

                // Desactivar sombras si es invisible
                if (shard.userData.opacity <= 0) {
                    shard.visible = false;
                }
            }
        }

        renderer.render(scene, camera);
    }

    // --- INTERFACING DE SELECCIÓN DE SERIES ---
    seriesSelect.addEventListener('change', () => {
        currentSeriesName = seriesSelect.value;
        currentPhotos = seriesMap[currentSeriesName] || [];
        currentIndex = 0;
        
        // Reset completo del escenario
        if (solidMesh) scene.remove(solidMesh);
        if (nextMesh) scene.remove(nextMesh);
        clearShards();
        
        solidMesh = null;
        nextMesh = null;
        
        loadSlide(0);
    });

    // Arrancar
    init3D();
</script>
