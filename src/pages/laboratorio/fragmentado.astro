---
import Layout from '../../layouts/Layout.astro';
import { getCatalogoFiles, getAssetUrl } from '../../conexion/directus';

let files = [];
try {
    files = await getCatalogoFiles();
} catch (e) {
    console.error("[Fragmentado Page] Error al cargar archivos de Directus:", e);
}

// Filtrar principales (excluyendo variantes _2)
const mainFiles = files.filter((f: any) => !f.filename_download?.toLowerCase().includes('_2')) || [];

// Agrupar archivos por nombre de serie
const seriesMap: Record<string, any[]> = {};
mainFiles.forEach((file: any) => {
    const sName = file.serie_name || 'General';
    if (!seriesMap[sName]) seriesMap[sName] = [];
    seriesMap[sName].push({
        id: file.id,
        title: file.title || file.filename_download.split('.')[0] || 'Obra sin título',
        src: getAssetUrl(file.id, { width: 1600, format: 'webp', quality: 90 }),
        thumb: getAssetUrl(file.id, { width: 400, format: 'webp', quality: 70 }),
        metadata: {
            size: file.filesize ? (file.filesize / 1024 / 1024).toFixed(2) + ' MB' : 'N/A',
            dim: file.width && file.height ? `${file.width} x ${file.height}px` : 'Resolución Variable',
            date: file.uploaded_on ? new Date(file.uploaded_on).toLocaleDateString('es-AR') : 'N/A'
        }
    });
});

// Fallback por si Directus no tiene datos
const fallbackSeries = {
    'Serie Demostración JMX': [
        {
            id: 'demo1',
            title: 'Rescate de Plata I',
            src: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=1600&q=90',
            thumb: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=400&q=70',
            metadata: { size: '1.24 MB', dim: '3000 x 4000px', date: '04/06/2026' }
        },
        {
            id: 'demo2',
            title: 'Líneas de Paso II',
            src: 'https://images.unsplash.com/photo-1579783928621-7a13d66a62d1?w=1600&q=90',
            thumb: 'https://images.unsplash.com/photo-1579783928621-7a13d66a62d1?w=400&q=70',
            metadata: { size: '2.10 MB', dim: '3500 x 5000px', date: '04/06/2026' }
        },
        {
            id: 'demo3',
            title: 'Texturas de Mármol III',
            src: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1600&q=90',
            thumb: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400&q=70',
            metadata: { size: '1.85 MB', dim: '4000 x 4000px', date: '04/06/2026' }
        }
    ]
};

if (Object.keys(seriesMap).length === 0) {
    Object.assign(seriesMap, fallbackSeries);
}

const seriesNames = Object.keys(seriesMap);
---

<Layout title="Lienzo Fragmentado 3D | Laboratorio JMX" themeForce="dark">
    <main class="shatter-container">
        <!-- Navegación superior -->
        <nav class="shatter-nav">
            <a href="/laboratorio" class="back-link">← VOLVER AL GABINETE</a>
            <div class="shatter-badge">PROTOCOLO: LIENZO FRAGMENTADO 3D</div>
        </nav>

        <div class="shatter-layout">
            <!-- Columna Izquierda: Escenario WebGL -->
            <div class="webgl-stage">
                <div class="light-table-grid"></div>
                <div id="canvas-container" class="canvas-mount"></div>
                <div class="interaction-hint">
                    <span class="hint-click">HAZ CLIC EN LA FOTO PARA FRAGMENTARLA</span>
                </div>
            </div>

            <!-- Columna Derecha: Control de Datos y Metadatos Collapsible -->
            <aside class="sidebar-panel" id="sidebar">
                <!-- Botón retráctil flotante en el borde izquierdo -->
                <button id="sidebar-toggle" class="sidebar-toggle-btn" aria-label="Minimizar panel">
                    <span class="toggle-icon">→</span>
                </button>

                <div class="sidebar-inner">
                    <!-- Selector de Series -->
                    <div class="control-group">
                        <label for="series-select">COLECCIÓN FOTOGRÁFICA</label>
                        <select id="series-select" class="jmx-select">
                            {seriesNames.map(name => (
                                <option value={name}>{name.toUpperCase()}</option>
                            ))}
                        </select>
                    </div>

                    <!-- Selector de Tipo de Rotura -->
                    <div class="control-group">
                        <label for="shatter-type-select">TIPO DE FRACTURA FÍSICA</label>
                        <select id="shatter-type-select" class="jmx-select">
                            <option value="glass">VIDRIO TEMPLADO (SHARDS)</option>
                            <option value="stone">BLOQUES DE PIEDRA (MATE)</option>
                            <option value="dust">POLVO DE PLATA (PARTÍCULAS)</option>
                        </select>
                    </div>

                    <!-- Selector de Color de Luz -->
                    <div class="control-group">
                        <label for="light-color-select">COLOR DE LUZ INTERACTIVA</label>
                        <select id="light-color-select" class="jmx-select">
                            <option value="gold">ORO JMX (#DCB14A)</option>
                            <option value="cyan">CIAN NEÓN (#00FFFF)</option>
                            <option value="crimson">VELVET RED (#FF0055)</option>
                            <option value="white">BLANCO NEUTRO (#FFFFFF)</option>
                        </select>
                    </div>

                    <!-- Configuración del Motor (Slider Físico) -->
                    <div class="engine-settings">
                        <div class="sheet-title">PARÁMETROS DEL MOTOR //</div>
                        
                        <div class="slider-item">
                            <div class="slider-header">
                                <span>CANTIDAD DE SHARDS / DENSIDAD</span>
                                <span id="val-shards">63</span>
                            </div>
                            <input type="range" id="param-shards" min="20" max="150" value="63" class="jmx-slider" />
                        </div>

                        <div class="slider-item">
                            <div class="slider-header">
                                <span>GRAVEDAD DE CAÍDA</span>
                                <span id="val-gravity">9.8</span>
                            </div>
                            <input type="range" id="param-gravity" min="0" max="25" step="0.5" value="9.8" class="jmx-slider" />
                        </div>

                        <div class="slider-item">
                            <div class="slider-header">
                                <span>INTENSIDAD LUZ CURSOR</span>
                                <span id="val-light-intensity">8</span>
                            </div>
                            <input type="range" id="param-light-intensity" min="0" max="25" step="1" value="8" class="jmx-slider" />
                        </div>
                    </div>

                    <!-- Estado de la secuencia -->
                    <div class="sequence-tracker">
                        <div class="progress-bar">
                            <div id="progress-indicator" class="progress-fill"></div>
                        </div>
                        <div class="tracker-text">
                            <span>SECUENCIA EN EJECUCIÓN</span>
                            <span id="tracker-count">01 / 01</span>
                        </div>
                    </div>

                    <!-- Ficha Técnica Activa en el Footer -->
                    <div class="technical-sheet compact">
                        <div class="sheet-title">FICHA TÉCNICA //</div>
                        
                        <div class="spec-row">
                            <span class="spec-key">TÍTULO</span>
                            <span id="meta-title" class="spec-value">-</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-key">RESOLUCIÓN</span>
                            <span id="meta-dim" class="spec-value">-</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-key">PESO</span>
                            <span id="meta-size" class="spec-value">-</span>
                        </div>
                        <div class="spec-row">
                            <span class="spec-key">SUBIDA</span>
                            <span id="meta-date" class="spec-value">-</span>
                        </div>
                    </div>

                    <!-- Mini Footer Explicativo Retraído abajo -->
                    <footer class="sidebar-mini-footer">
                        <div class="mini-title">EXP-07 // FÍSICA DE LIENZO</div>
                        <p class="mini-desc">Simulación interactiva de tensión en emulsión. Al hacer clic, la obra se fracciona en coordenadas 3D de vidrio, piedra o polvo de haluros.</p>
                    </footer>
                </div>
            </aside>
        </div>
    </main>

    <!-- Datos Serializados para el Cliente -->
    <div id="series-data" data-series={JSON.stringify(seriesMap)} style="display: none;"></div>
</Layout>

<style>
    :root {
        --jmx-gold: #dcb14a;
        --jmx-bg: #030303;
        --jmx-text-dim: rgba(255, 255, 255, 0.4);
        --transition-jmx: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .shatter-container {
        min-height: 100vh;
        background: var(--jmx-bg);
        color: #fff;
        font-family: 'Inter', system-ui, sans-serif;
        position: relative;
        overflow: hidden;
    }

    /* 🧭 Navegación Superior */
    .shatter-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding: 2rem 4rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        background: linear-gradient(to bottom, var(--jmx-bg) 0%, transparent 100%);
        pointer-events: none;
    }

    .shatter-nav * {
        pointer-events: auto;
    }

    .back-link {
        color: #fff;
        text-decoration: none;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 3px;
        opacity: 0.6;
        transition: var(--transition-jmx);
    }
    .back-link:hover {
        opacity: 1;
        color: var(--jmx-gold);
    }

    .shatter-badge {
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 2px;
        color: var(--jmx-gold);
        border: 1px solid var(--jmx-gold);
        padding: 0.4rem 1rem;
    }

    /* 🔲 Layout de Columnas Flexbox para animar el colapso */
    .shatter-layout {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    /* 🖥️ Escenario de Render */
    .webgl-stage {
        flex: 1;
        height: 100%;
        position: relative;
        background: #060606;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .light-table-grid {
        position: absolute;
        inset: 0;
        opacity: 0.03;
        background-size: 40px 40px;
        background-image: 
            linear-gradient(to right, rgba(220, 177, 74, 0.5) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(220, 177, 74, 0.5) 1px, transparent 1px);
        z-index: 1;
        pointer-events: none;
    }

    .canvas-mount {
        position: absolute;
        inset: 0;
        z-index: 2;
        cursor: pointer;
    }

    .interaction-hint {
        position: absolute;
        bottom: 3rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        pointer-events: none;
    }

    .hint-click {
        font-size: 0.65rem;
        letter-spacing: 3px;
        color: var(--jmx-text-dim);
        font-weight: 800;
        background: rgba(0, 0, 0, 0.6);
        padding: 0.8rem 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        animation: breath 2.5s infinite ease-in-out;
    }

    @keyframes breath {
        0%, 100% { opacity: 0.4; transform: scale(0.98); }
        50% { opacity: 0.9; transform: scale(1.02); color: var(--jmx-gold); }
    }

    /* aside Lateral Panel */
    .sidebar-panel {
        background: rgba(5, 5, 5, 0.75);
        border-left: 1px solid rgba(220, 177, 74, 0.08);
        z-index: 10;
        backdrop-filter: blur(30px);
        -webkit-backdrop-filter: blur(30px);
        box-shadow: -20px 0 50px rgba(0, 0, 0, 0.9);
        display: flex;
        flex-direction: column;
        position: relative;
        width: 400px;
        flex-shrink: 0;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), margin-right 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sidebar-panel.collapsed {
        margin-right: -400px;
        transform: translateX(100%);
    }

    /* Botón flotante para colapsar panel */
    .sidebar-toggle-btn {
        position: absolute;
        top: 50%;
        left: -32px;
        transform: translateY(-50%);
        width: 32px;
        height: 64px;
        background: rgba(10, 10, 10, 0.85);
        border: 1px solid rgba(220, 177, 74, 0.15);
        border-right: none;
        border-radius: 8px 0 0 8px;
        color: var(--jmx-gold);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        z-index: 12;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .sidebar-toggle-btn:hover {
        background: var(--jmx-gold);
        color: #000;
        border-color: var(--jmx-gold);
        box-shadow: -5px 0 15px rgba(220, 177, 74, 0.25);
    }

    .sidebar-toggle-btn .toggle-icon {
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-block;
    }

    .sidebar-panel.collapsed .sidebar-toggle-btn .toggle-icon {
        transform: rotate(180deg);
    }

    .sidebar-inner {
        padding: 7rem 2.5rem 2.5rem;
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: space-between;
        gap: 1.2rem;
        overflow-y: auto;
    }

    /* Controles */
    .control-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .control-group label {
        font-size: 0.55rem;
        font-weight: 900;
        letter-spacing: 2px;
        color: var(--jmx-gold);
    }

    .jmx-select {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #fff;
        padding: 0.8rem 1.2rem;
        font-size: 0.75rem;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        transition: var(--transition-jmx);
    }

    .jmx-select:hover, .jmx-select:focus {
        border-color: var(--jmx-gold);
        background: rgba(220, 177, 74, 0.05);
    }

    .jmx-select option {
        background: #111;
        color: #fff;
    }

    /* Ficha Técnica */
    .technical-sheet, .engine-settings {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 1.2rem;
    }

    .technical-sheet.compact {
        margin-top: auto;
    }

    .sheet-title {
        font-size: 0.6rem;
        font-weight: 900;
        color: var(--jmx-gold);
        letter-spacing: 2px;
        margin-bottom: 0.2rem;
    }

    .spec-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.7rem;
        letter-spacing: 1px;
    }

    .spec-key {
        font-weight: 900;
        color: rgba(255,255,255,0.3);
    }

    .spec-value {
        font-weight: 500;
        color: rgba(255, 255, 255, 0.85);
        text-align: right;
    }

    /* Sliders de Parámetros */
    .slider-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .slider-header {
        display: flex;
        justify-content: space-between;
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 1px;
        color: var(--jmx-text-dim);
    }

    .slider-header span:last-child {
        color: var(--jmx-gold);
    }

    .jmx-slider {
        -webkit-appearance: none;
        width: 100%;
        height: 2px;
        background: rgba(255, 255, 255, 0.1);
        outline: none;
        cursor: pointer;
    }

    .jmx-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 10px;
        height: 10px;
        background: var(--jmx-gold);
        border-radius: 50%;
        transition: 0.2s;
    }

    .jmx-slider::-webkit-slider-thumb:hover {
        transform: scale(1.4);
        box-shadow: 0 0 10px var(--jmx-gold);
    }

    /* Tracker */
    .sequence-tracker {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 1.2rem;
    }

    .progress-bar {
        width: 100%;
        height: 2px;
        background: rgba(255, 255, 255, 0.05);
    }

    .progress-fill {
        width: 0%;
        height: 100%;
        background: var(--jmx-gold);
        box-shadow: 0 0 10px var(--jmx-gold);
        transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .tracker-text {
        display: flex;
        justify-content: space-between;
        font-size: 0.6rem;
        font-weight: 900;
        letter-spacing: 2px;
        color: var(--jmx-text-dim);
    }

    .tracker-text span:last-child {
        color: #fff;
    }

    /* Mini Footer Explicativo */
    .sidebar-mini-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-top: 0.5rem;
    }

    .mini-title {
        font-size: 0.55rem;
        font-weight: 900;
        color: var(--jmx-gold);
        letter-spacing: 1.5px;
    }

    .mini-desc {
        font-size: 0.6rem;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.25);
        margin: 0;
    }

    /* Responsivo */
    @media (max-width: 1000px) {
        .shatter-layout {
            flex-direction: column;
        }

        .sidebar-panel {
            width: 100% !important;
            height: 380px;
            border-left: none;
            border-top: 1px solid rgba(220, 177, 74, 0.08);
            margin-right: 0 !important;
            transform: none !important;
        }

        .sidebar-panel.collapsed {
            margin-bottom: -380px;
            transform: translateY(100%) !important;
        }

        .sidebar-toggle-btn {
            top: -32px;
            left: 50%;
            transform: translateX(-50%) rotate(-90deg);
            width: 32px;
            height: 64px;
            border-bottom: none;
            border-radius: 8px 8px 0 0;
        }

        .sidebar-panel.collapsed .sidebar-toggle-btn .toggle-icon {
            transform: rotate(-90deg);
        }

        .sidebar-inner {
            padding: 2rem;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 1.5rem;
            overflow-y: auto;
        }

        .sidebar-inner > div, .sidebar-inner > aside, .sidebar-inner > select, .sidebar-inner > footer {
            flex: 1 1 200px;
        }

        .sequence-tracker, .sidebar-mini-footer {
            width: 100%;
        }
    }
</style>

<!-- Script de Cliente para el renderizado 3D WebGL -->
<script>
    import * as THREE from 'three';

    // 🔬 Audio procedimental específico para cada modo de rotura
    function playShatterSound(type: string) {
        try {
            const AudioContext = window.AudioContext || (window as any).webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            
            if (type === 'glass') {
                const numNotes = 8 + Math.floor(Math.random() * 6);
                for (let i = 0; i < numNotes; i++) {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    
                    const freq = 1800 + Math.random() * 2500;
                    osc.frequency.setValueAtTime(freq, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(150 + Math.random() * 400, ctx.currentTime + 0.1 + Math.random() * 0.2);
                    
                    osc.type = Math.random() > 0.5 ? 'triangle' : 'sine';
                    
                    const startTime = ctx.currentTime + Math.random() * 0.06;
                    const duration = 0.15 + Math.random() * 0.25;
                    
                    gain.gain.setValueAtTime(0, ctx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.12 / numNotes, startTime + 0.005);
                    gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
                    
                    osc.start(startTime);
                    osc.stop(startTime + duration);
                }
                
                const bufferSize = ctx.sampleRate * 0.25; 
                const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }
                const noise = ctx.createBufferSource();
                noise.buffer = buffer;
                
                const noiseFilter = ctx.createBiquadFilter();
                noiseFilter.type = 'bandpass';
                noiseFilter.frequency.value = 3500;
                noiseFilter.Q.value = 1.5;
                
                const noiseGain = ctx.createGain();
                noiseGain.gain.setValueAtTime(0.15, ctx.currentTime);
                noiseGain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.2);
                
                noise.connect(noiseFilter);
                noiseFilter.connect(noiseGain);
                noiseGain.connect(ctx.destination);
                noise.start();

            } else if (type === 'stone') {
                const numRocks = 4 + Math.floor(Math.random() * 4);
                for (let i = 0; i < numRocks; i++) {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    
                    osc.type = 'sawtooth';
                    
                    const filter = ctx.createBiquadFilter();
                    filter.type = 'lowpass';
                    filter.frequency.value = 350;
                    
                    osc.connect(filter);
                    filter.connect(gain);
                    gain.connect(ctx.destination);
                    
                    const freq = 110 + Math.random() * 90;
                    osc.frequency.setValueAtTime(freq, ctx.currentTime);
                    osc.frequency.linearRampToValueAtTime(35, ctx.currentTime + 0.2 + Math.random() * 0.25);
                    
                    const startTime = ctx.currentTime + Math.random() * 0.08;
                    const duration = 0.3 + Math.random() * 0.3;
                    
                    gain.gain.setValueAtTime(0, ctx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.35 / numRocks, startTime + 0.01);
                    gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
                    
                    osc.start(startTime);
                    osc.stop(startTime + duration);
                }
                
                const bufferSize = ctx.sampleRate * 0.45;
                const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }
                const noise = ctx.createBufferSource();
                noise.buffer = buffer;
                
                const noiseFilter = ctx.createBiquadFilter();
                noiseFilter.type = 'lowpass';
                noiseFilter.frequency.value = 160;
                
                const noiseGain = ctx.createGain();
                noiseGain.gain.setValueAtTime(0.45, ctx.currentTime);
                noiseGain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.4);
                
                noise.connect(noiseFilter);
                noiseFilter.connect(noiseGain);
                noiseGain.connect(ctx.destination);
                noise.start();

            } else if (type === 'dust') {
                const bufferSize = ctx.sampleRate * 0.8;
                const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }
                const noise = ctx.createBufferSource();
                noise.buffer = buffer;
                
                const noiseFilter = ctx.createBiquadFilter();
                noiseFilter.type = 'bandpass';
                noiseFilter.frequency.setValueAtTime(4500, ctx.currentTime);
                noiseFilter.frequency.exponentialRampToValueAtTime(350, ctx.currentTime + 0.65);
                noiseFilter.Q.value = 0.7;
                
                const noiseGain = ctx.createGain();
                noiseGain.gain.setValueAtTime(0.25, ctx.currentTime);
                noiseGain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.75);
                
                noise.connect(noiseFilter);
                noiseFilter.connect(noiseGain);
                noiseGain.connect(ctx.destination);
                noise.start();
            }
        } catch (e) {
            console.warn("AudioContext bloqueado o no soportado por el navegador:", e);
        }
    }

    // --- VARIABLES Y SELECTORES ---
    const dataEl = document.getElementById('series-data');
    if (!dataEl) throw new Error("No series-data element found");
    const seriesMap = JSON.parse(dataEl.getAttribute('data-series') || '{}');

    const seriesSelect = document.getElementById('series-select') as HTMLSelectElement;
    const shatterTypeSelect = document.getElementById('shatter-type-select') as HTMLSelectElement;
    const lightColorSelect = document.getElementById('light-color-select') as HTMLSelectElement;
    
    const sidebar = document.getElementById('sidebar')!;
    const sidebarToggle = document.getElementById('sidebar-toggle')!;
    
    const metaTitle = document.getElementById('meta-title')!;
    const metaDim = document.getElementById('meta-dim')!;
    const metaSize = document.getElementById('meta-size')!;
    const metaDate = document.getElementById('meta-date')!;
    
    const valShards = document.getElementById('val-shards')!;
    const valGravity = document.getElementById('val-gravity')!;
    const valLightIntensity = document.getElementById('val-light-intensity')!;
    
    const paramShards = document.getElementById('param-shards') as HTMLInputElement;
    const paramGravity = document.getElementById('param-gravity') as HTMLInputElement;
    const paramLightIntensity = document.getElementById('param-light-intensity') as HTMLInputElement;
    
    const progressFill = document.getElementById('progress-indicator')!;
    const trackerCount = document.getElementById('tracker-count')!;
    const container = document.getElementById('canvas-container')!;

    let currentSeriesName = seriesSelect.value;
    let currentPhotos = seriesMap[currentSeriesName] || [];
    let currentIndex = 0;

    // Físicas configurables
    let configShards = parseInt(paramShards.value, 10);
    let configGravity = parseFloat(paramGravity.value);
    let configLightIntensity = parseFloat(paramLightIntensity.value);
    let configShatterType = shatterTypeSelect.value;
    let configLightColor = lightColorSelect.value;

    const colorMap: Record<string, number> = {
        gold: 0xdcb14a,
        cyan: 0x00ffff,
        crimson: 0xff0055,
        white: 0xffffff
    };

    // --- BINDING DE CONTROLES ---
    paramShards.addEventListener('input', () => {
        configShards = parseInt(paramShards.value, 10);
        valShards.textContent = configShards.toString();
    });

    paramGravity.addEventListener('input', () => {
        configGravity = parseFloat(paramGravity.value);
        valGravity.textContent = configGravity.toFixed(1);
    });

    paramLightIntensity.addEventListener('input', () => {
        configLightIntensity = parseFloat(paramLightIntensity.value);
        valLightIntensity.textContent = configLightIntensity.toString();
        pointLight.intensity = configLightIntensity;
    });

    lightColorSelect.addEventListener('change', () => {
        configLightColor = lightColorSelect.value;
        const hex = colorMap[configLightColor] || 0xdcb14a;
        pointLight.color.setHex(hex);
    });

    shatterTypeSelect.addEventListener('change', () => {
        configShatterType = shatterTypeSelect.value;
    });

    // Toggle Collapsible Sidebar & Animate Canvas Resize
    sidebarToggle.addEventListener('click', (e) => {
        e.stopPropagation(); // Evita clicks en el lienzo
        sidebar.classList.toggle('collapsed');
        
        // Bucle de redimensionamiento de 600ms para Three.js fluida
        const startTime = performance.now();
        const duration = 600;
        function resizeTransition() {
            onResize();
            if (performance.now() - startTime < duration) {
                requestAnimationFrame(resizeTransition);
            } else {
                onResize();
            }
        }
        requestAnimationFrame(resizeTransition);
    });

    // --- MOTOR 3D (THREE.JS) ---
    let scene: THREE.Scene, 
        camera: THREE.PerspectiveCamera, 
        renderer: THREE.WebGLRenderer;
        
    let solidMesh: THREE.Mesh | null = null;
    let nextMesh: THREE.Mesh | null = null;
    
    let activeShardsGroup: THREE.Group | null = null;
    let activeShardsList: THREE.Mesh[] = [];

    let activePoints: THREE.Points | null = null;
    let activePointsVelocities: THREE.Vector3[] = [];
    let activePointsOpacity = 1.0;
    
    let isShattered = false;
    let isTransitioning = false;
    let currentTexture: THREE.Texture | null = null;
    let nextTexture: THREE.Texture | null = null;

    const textureLoader = new THREE.TextureLoader();
    textureLoader.crossOrigin = 'anonymous';
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    const pointLight = new THREE.PointLight(colorMap[configLightColor], configLightIntensity, 18);

    // Inicializar Escenario
    function init3D() {
        const width = container.clientWidth;
        const height = container.clientHeight;

        scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x030303, 0.05);

        camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
        camera.position.z = 9.5; 

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, 0.3);
        dirLight.position.set(0, 8, 10);
        scene.add(dirLight);

        pointLight.position.set(0, 0, 1.8);
        scene.add(pointLight);

        window.addEventListener('resize', onResize);
        container.addEventListener('click', onStageClick);
        container.addEventListener('mousemove', onMouseMove);

        loadSlide(0);
        animate();
    }

    function onResize() {
        const width = container.clientWidth;
        const height = container.clientHeight;
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);
    }

    function onMouseMove(e: MouseEvent) {
        const rect = container.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        const y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        pointLight.position.x = x * 5.5;
        pointLight.position.y = y * 4.2;
        pointLight.position.z = 1.6;
    }

    // --- CARGAR TEXTURAS E IMÁGENES ---
    function loadSlide(index: number) {
        if (currentPhotos.length === 0) return;

        isShattered = false;
        isTransitioning = false;
        
        clearActiveSimulation();

        const photo = currentPhotos[index];
        updateUI(photo, index);

        textureLoader.load(photo.src, (texture) => {
            currentTexture = texture;
            currentTexture.colorSpace = THREE.SRGBColorSpace;
            setupActiveMesh(currentTexture);

            const nextIndex = (index + 1) % currentPhotos.length;
            const nextPhoto = currentPhotos[nextIndex];
            textureLoader.load(nextPhoto.src, (nTex) => {
                nextTexture = nTex;
                nextTexture.colorSpace = THREE.SRGBColorSpace;
                setupNextMesh(nextTexture);
            });
        });
    }

    function updateUI(photo: any, index: number) {
        metaTitle.textContent = photo.title.toUpperCase();
        metaDim.textContent = photo.metadata.dim;
        metaSize.textContent = photo.metadata.size;
        metaDate.textContent = photo.metadata.date;

        const total = currentPhotos.length;
        trackerCount.textContent = `${String(index + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        progressFill.style.width = `${((index + 1) / total) * 100}%`;
    }

    function calculatePlaneSize(texture: THREE.Texture) {
        const aspect = texture.image.width / texture.image.height;
        const maxW = 7.6;
        const maxH = 5.2;
        let w = maxW;
        let h = w / aspect;
        if (h > maxH) {
            h = maxH;
            w = h * aspect;
        }
        return { w, h };
    }

    function setupActiveMesh(texture: THREE.Texture) {
        if (solidMesh) {
            scene.remove(solidMesh);
            solidMesh.geometry.dispose();
            (solidMesh.material as THREE.Material).dispose();
        }

        const size = calculatePlaneSize(texture);
        const geom = new THREE.PlaneGeometry(size.w, size.h);
        const mat = new THREE.MeshPhongMaterial({
            map: texture,
            side: THREE.DoubleSide,
            shininess: 40,
            specular: new THREE.Color(0xdcb14a)
        });

        solidMesh = new THREE.Mesh(geom, mat);
        solidMesh.position.set(0, 0, 0);
        solidMesh.scale.set(1, 1, 1);
        scene.add(solidMesh);
    }

    function setupNextMesh(texture: THREE.Texture) {
        if (nextMesh) {
            scene.remove(nextMesh);
            nextMesh.geometry.dispose();
            (nextMesh.material as THREE.Material).dispose();
        }

        const size = calculatePlaneSize(texture);
        const geom = new THREE.PlaneGeometry(size.w, size.h);
        const mat = new THREE.MeshPhongMaterial({
            map: texture,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0,
            shininess: 40
        });

        nextMesh = new THREE.Mesh(geom, mat);
        nextMesh.position.set(0, 0, -3.5);
        nextMesh.scale.set(0.65, 0.65, 0.65);
        scene.add(nextMesh);
    }

    function clearActiveSimulation() {
        if (activeShardsGroup) {
            scene.remove(activeShardsGroup);
            activeShardsList.forEach(s => {
                s.geometry.dispose();
                (s.material as THREE.Material).dispose();
            });
            activeShardsList = [];
            activeShardsGroup = null;
        }

        if (activePoints) {
            scene.remove(activePoints);
            activePoints.geometry.dispose();
            (activePoints.material as THREE.Material).dispose();
            activePoints = null;
            activePointsVelocities = [];
        }
    }

    function onStageClick(e: MouseEvent) {
        if (isShattered || isTransitioning || !solidMesh || !currentTexture) return;

        const rect = container.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouse, camera);
        const intersects = raycaster.intersectObject(solidMesh);

        if (intersects.length > 0) {
            const impact = intersects[0].point;
            shatterAndSlide(impact);
        }
    }

    function shatterAndSlide(impactPoint: THREE.Vector3) {
        isShattered = true;
        isTransitioning = true;

        playShatterSound(configShatterType);

        const size = calculatePlaneSize(currentTexture!);

        if (configShatterType === 'dust') {
            const dustData = createDustParticles(currentTexture!, size.w, size.h, impactPoint);
            if (dustData) {
                activePoints = dustData.points;
                activePointsVelocities = dustData.velocities;
                activePointsOpacity = 1.0;
                scene.add(activePoints);
            }
        } else {
            const shardData = createShards3D(currentTexture!, size.w, size.h, impactPoint, configShatterType);
            activeShardsGroup = shardData.group;
            activeShardsList = shardData.shards;
            scene.add(activeShardsGroup);
        }

        if (solidMesh) solidMesh.visible = false;

        let startSlideTime = performance.now();
        const slideDuration = 1500;

        function animateSlideIn() {
            if (!nextMesh) return;

            const now = performance.now();
            const elapsed = now - startSlideTime;
            const progress = Math.min(elapsed / slideDuration, 1);

            const ease = 1 - Math.pow(1 - progress, 3); 

            nextMesh.position.z = -3.5 + (ease * 3.5);
            const currentScale = 0.65 + (ease * 0.35);
            nextMesh.scale.set(currentScale, currentScale, currentScale);
            (nextMesh.material as THREE.Material).opacity = ease;

            if (progress < 1) {
                requestAnimationFrame(animateSlideIn);
            } else {
                currentIndex = (currentIndex + 1) % currentPhotos.length;
                
                solidMesh = nextMesh;
                solidMesh.position.set(0, 0, 0);
                solidMesh.scale.set(1, 1, 1);
                (solidMesh.material as THREE.Material).opacity = 1;
                
                currentTexture = nextTexture;
                nextMesh = null;
                
                isShattered = false;
                isTransitioning = false;

                const photo = currentPhotos[currentIndex];
                updateUI(photo, currentIndex);

                const nextIdx = (currentIndex + 1) % currentPhotos.length;
                const nextPhoto = currentPhotos[nextIdx];
                textureLoader.load(nextPhoto.src, (nTex) => {
                    nextTexture = nTex;
                    nextTexture.colorSpace = THREE.SRGBColorSpace;
                    setupNextMesh(nextTexture);
                });
            }
        }

        requestAnimationFrame(animateSlideIn);
    }

    // --- ALGORITMO DE FRACTURA DE COMPONENTES ---
    function createShards3D(texture: THREE.Texture, width: number, height: number, impactPoint: THREE.Vector3, mode: string) {
        const group = new THREE.Group();
        const shards: THREE.Mesh[] = [];

        const totalTarget = (mode === 'stone') ? Math.round(configShards * 0.55) : configShards;
        const ratio = width / height;
        const rows = Math.max(3, Math.round(THREE.MathUtils.lerp(3, 12, Math.sqrt(totalTarget / ratio) / 10)));
        const cols = Math.max(3, Math.round(rows * ratio));

        const nodes: THREE.Vector2[] = [];
        for (let r = 0; r <= rows; r++) {
            for (let c = 0; c <= cols; c++) {
                let x = (c / cols) - 0.5;
                let y = (r / rows) - 0.5;

                if (c > 0 && c < cols && r > 0 && r < rows) {
                    const noise = (mode === 'stone') ? 0.48 : 0.44;
                    x += (Math.random() - 0.5) * (1 / cols) * noise;
                    y += (Math.random() - 0.5) * (1 / rows) * noise;
                }

                nodes.push(new THREE.Vector2(x * width, y * height));
            }
        }

        const getNodeIdx = (c: number, r: number) => r * (cols + 1) + c;

        function addShard(p1: THREE.Vector2, p2: THREE.Vector2, p3: THREE.Vector2) {
            const geom = new THREE.BufferGeometry();

            const vertices = new Float32Array([
                p1.x, p1.y, 0,
                p2.x, p2.y, 0,
                p3.x, p3.y, 0
            ]);
            geom.setAttribute('position', new THREE.BufferAttribute(vertices, 3));

            const uvs = new Float32Array([
                (p1.x / width) + 0.5, (p1.y / height) + 0.5,
                (p2.x / width) + 0.5, (p2.y / height) + 0.5,
                (p3.x / width) + 0.5, (p3.y / height) + 0.5
            ]);
            geom.setAttribute('uv', new THREE.BufferAttribute(uvs, 2));

            geom.computeVertexNormals();

            let mat;
            if (mode === 'stone') {
                mat = new THREE.MeshPhongMaterial({
                    map: texture,
                    side: THREE.DoubleSide,
                    transparent: true,
                    opacity: 1,
                    shininess: 3, 
                    specular: new THREE.Color(0x111111),
                    color: 0x858585,
                    reflectivity: 0.05
                });
            } else {
                mat = new THREE.MeshPhongMaterial({
                    map: texture,
                    side: THREE.DoubleSide,
                    transparent: true,
                    opacity: 1,
                    shininess: 95, 
                    specular: new THREE.Color(colorMap[configLightColor]),
                    reflectivity: 0.8
                });
            }

            const mesh = new THREE.Mesh(geom, mat);

            const cx = (p1.x + p2.x + p3.x) / 3;
            const cy = (p1.y + p2.y + p3.y) / 3;

            const dx = cx - impactPoint.x;
            const dy = cy - impactPoint.y;
            const dist = Math.sqrt(dx * dx + dy * dy) || 0.1;

            const forceBase = (mode === 'stone') ? 1.7 : 2.5;
            const force = Math.max(0.1, forceBase / (dist + 0.4));

            let vx, vy, vz;
            if (mode === 'stone') {
                vx = (dx / dist) * force * 0.08 + (Math.random() - 0.5) * 0.02;
                vy = (dy / dist) * force * 0.08 + (Math.random() - 0.5) * 0.02;
                vz = (Math.random() * 0.03 + 0.005) * force; 
            } else {
                vx = (dx / dist) * force * 0.16 + (Math.random() - 0.5) * 0.05;
                vy = (dy / dist) * force * 0.16 + (Math.random() - 0.5) * 0.05;
                vz = (Math.random() * 0.13 + 0.05) * force;  
            }

            const rotFactor = (mode === 'stone') ? 0.04 : 0.18;

            mesh.userData = {
                velocity: new THREE.Vector3(vx, vy, vz),
                angularVelocity: new THREE.Vector3(
                    (Math.random() - 0.5) * rotFactor,
                    (Math.random() - 0.5) * rotFactor,
                    (Math.random() - 0.5) * rotFactor
                ),
                opacity: 1,
                delay: dist * ((mode === 'stone') ? 14 : 7)
            };

            group.add(mesh);
            shards.push(mesh);
        }

        for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
                const n00 = nodes[getNodeIdx(c, r)];
                const n10 = nodes[getNodeIdx(c + 1, r)];
                const n01 = nodes[getNodeIdx(c, r + 1)];
                const n11 = nodes[getNodeIdx(c + 1, r + 1)];

                if (Math.random() > 0.5) {
                    addShard(n00, n10, n01);
                    addShard(n10, n11, n01);
                } else {
                    addShard(n00, n10, n11);
                    addShard(n00, n11, n01);
                }
            }
        }

        return { group, shards };
    }

    // --- ALGORITMO DE FRACTURA DE POLVO (PARTÍCULAS POINT CLOUD) ---
    function createDustParticles(texture: THREE.Texture, width: number, height: number, impactPoint: THREE.Vector3) {
        const img = texture.image;
        if (!img || !img.width) return null;

        const pCols = 100;
        const pRows = Math.round(pCols / (img.width / img.height)) || 80;
        const numPoints = pCols * pRows;

        const canvas = document.createElement('canvas');
        canvas.width = pCols;
        canvas.height = pRows;
        const ctx = canvas.getContext('2d');
        if (!ctx) return null;
        ctx.drawImage(img, 0, 0, pCols, pRows);
        
        let imgData;
        try {
            imgData = ctx.getImageData(0, 0, pCols, pRows).data;
        } catch (e) {
            imgData = new Uint8Array(numPoints * 4);
            for (let i = 0; i < numPoints * 4; i += 4) {
                imgData[i] = 180 + Math.random() * 75;
                imgData[i+1] = 160 + Math.random() * 60;
                imgData[i+2] = 120 + Math.random() * 50;
                imgData[i+3] = 255;
            }
        }

        const positions = new Float32Array(numPoints * 3);
        const colors = new Float32Array(numPoints * 3);
        const velocities: THREE.Vector3[] = [];

        let index = 0;
        for (let r = 0; r < pRows; r++) {
            for (let c = 0; c < pCols; c++) {
                const pctX = c / (pCols - 1);
                const pctY = r / (pRows - 1);

                const x = (pctX - 0.5) * width;
                const y = (pctY - 0.5) * height;
                const z = 0;

                positions[index * 3] = x;
                positions[index * 3 + 1] = y;
                positions[index * 3 + 2] = z;

                const canvasY = pRows - 1 - r;
                const pixelIndex = (canvasY * pCols + c) * 4;

                colors[index * 3] = imgData[pixelIndex] / 255;
                colors[index * 3 + 1] = imgData[pixelIndex + 1] / 255;
                colors[index * 3 + 2] = imgData[pixelIndex + 2] / 255;

                const dx = x - impactPoint.x;
                const dy = y - impactPoint.y;
                const dist = Math.sqrt(dx * dx + dy * dy) || 0.1;

                const force = Math.max(0.05, 1.8 / (dist + 0.3));

                const vx = (dx / dist) * force * 0.04 + (Math.random() - 0.5) * 0.012;
                const vy = (dy / dist) * force * 0.04 + (Math.random() - 0.5) * 0.012;
                const vz = (Math.random() * 0.06 + 0.01) * force;

                velocities.push(new THREE.Vector3(vx, vy, vz));
                index++;
            }
        }

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

        const material = new THREE.PointsMaterial({
            size: 0.038,
            vertexColors: true,
            transparent: true,
            opacity: 1,
            sizeAttenuation: true
        });

        const points = new THREE.Points(geometry, material);
        return { points, velocities };
    }

    // --- BUCLE DE ANIMACIÓN (TICK) ---
    let lastTime = performance.now();

    function animate() {
        requestAnimationFrame(animate);

        const now = performance.now();
        const delta = Math.min((now - lastTime) / 16.666, 3);
        lastTime = now;

        if (activeShardsList.length > 0) {
            const gravityMultiplier = (configShatterType === 'stone') ? 1.45 : 1.0;
            const gravityAcc = (configGravity / 1000) * gravityMultiplier * delta;
            
            for (let i = 0; i < activeShardsList.length; i++) {
                const shard = activeShardsList[i];
                
                if (shard.userData.delay > 0) {
                    shard.userData.delay -= 16.666 * delta;
                    continue;
                }

                shard.position.addScaledVector(shard.userData.velocity, delta);

                shard.rotation.x += shard.userData.angularVelocity.x * delta;
                shard.rotation.y += shard.userData.angularVelocity.y * delta;
                shard.rotation.z += shard.userData.angularVelocity.z * delta;

                shard.userData.velocity.y -= gravityAcc;

                shard.userData.velocity.multiplyScalar(Math.pow(0.978, delta));
                shard.userData.angularVelocity.multiplyScalar(Math.pow(0.978, delta));

                shard.userData.opacity -= ((configShatterType === 'stone') ? 0.012 : 0.007) * delta;
                const mat = shard.material as THREE.MeshPhongMaterial;
                mat.opacity = Math.max(0, shard.userData.opacity);

                if (shard.userData.opacity <= 0) {
                    shard.visible = false;
                }
            }
        }

        if (activePoints && activePointsVelocities.length > 0) {
            const posAttr = activePoints.geometry.getAttribute('position') as THREE.BufferAttribute;
            const positions = posAttr.array as Float32Array;
            const time = now * 0.0016;

            for (let i = 0; i < activePointsVelocities.length; i++) {
                const vel = activePointsVelocities[i];

                positions[i * 3] += vel.x * delta;
                positions[i * 3 + 1] += vel.y * delta;
                positions[i * 3 + 2] += vel.z * delta;

                vel.y += 0.0002 * delta;

                positions[i * 3] += Math.sin(time + i) * 0.0012 * delta;

                vel.multiplyScalar(Math.pow(0.975, delta));
            }
            posAttr.needsUpdate = true;

            activePointsOpacity -= 0.0065 * delta;
            (activePoints.material as THREE.PointsMaterial).opacity = Math.max(0, activePointsOpacity);
            if (activePointsOpacity <= 0) {
                activePoints.visible = false;
            }
        }

        renderer.render(scene, camera);
    }

    seriesSelect.addEventListener('change', () => {
        currentSeriesName = seriesSelect.value;
        currentPhotos = seriesMap[currentSeriesName] || [];
        currentIndex = 0;
        
        if (solidMesh) scene.remove(solidMesh);
        if (nextMesh) scene.remove(nextMesh);
        clearActiveSimulation();
        
        solidMesh = null;
        nextMesh = null;
        
        loadSlide(0);
    });

    init3D();
</script>
