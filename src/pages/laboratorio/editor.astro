---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\laboratorio\editor.astro
import Layout from '@layouts/Layout.astro';
---

<Layout title="Estudio Editor 3D/IA | Laboratorio JMX" themeForce="dark">
    <main class="editor-portal">
        <!-- 🧭 Top Navigation -->
        <nav class="editor-nav">
            <a href="/laboratorio" class="back-link">
                <span class="nav-icon">←</span>
                VOLVER AL GABINETE
            </a>
            <div class="system-status">
                <span class="status-dot animate-pulse"></span>
                ESTUDIO DIGITAL JMX: v.2.5
            </div>
        </nav>

        <!-- 🎛️ Editor Layout -->
        <div class="editor-layout">
            <!-- 🛠️ Left Toolbar -->
            <aside class="left-toolbar">
                <div class="tool-group">
                    <button class="tool-btn active" data-tool="pointer" title="Puntero / Navegar (V)">
                        <span class="icon">➔</span>
                        <span class="tooltip">Mover Capas / Inspeccionar</span>
                    </button>
                    <button class="tool-btn" data-tool="adjust" title="Revelado Digital (C)">
                        <span class="icon">☀️</span>
                        <span class="tooltip">Ajustar Brillo, Contraste y Exposición</span>
                    </button>
                    <button class="tool-btn" data-tool="filter" title="Filtros Artísticos (F)">
                        <span class="icon">🎨</span>
                        <span class="tooltip">Aplicar tonalidades de autor</span>
                    </button>
                    <button class="tool-btn" data-tool="depth3d" title="Relieve 3D (D)">
                        <span class="icon">🧊</span>
                        <span class="tooltip">Pintar o generar relieve 3D interactivo</span>
                    </button>
                    <button class="tool-btn" data-tool="text" title="Añadir Texto (T)">
                        <span class="icon">T</span>
                        <span class="tooltip">Capas tipográficas personalizadas</span>
                    </button>
                </div>
            </aside>

            <!-- 🖥️ Central Canvas Viewport -->
            <section class="canvas-viewport" id="drop-zone">
                <div class="canvas-container">
                    <canvas id="main-webgl-canvas"></canvas>
                    <div id="brush-cursor" class="brush-cursor-indicator"></div>
                    <div class="upload-overlay" id="upload-prompt">
                        <div class="upload-icon">📂</div>
                        <h3>ARRASTRÁ UNA IMAGEN AQUÍ</h3>
                        <p>o haz clic para buscar un archivo local</p>
                        <span class="badge-limits">Formatos soportados: JPG, PNG, WEBP, AVIF</span>
                    </div>
                </div>
                <!-- Mini barra de estado del lienzo -->
                <div class="canvas-status">
                    <span id="image-dimensions">Resolución: N/A</span>
                    <span id="active-tool-status">Herramienta: Puntero</span>
                </div>
            </section>

            <!-- ⚙️ Right Properties Panel -->
            <aside class="right-panel">
                <div class="panel-section">
                    <h3>PROPIEDADES</h3>
                    <div class="properties-content">
                        <!-- Ajustes de Revelado -->
                        <div class="tool-settings" id="adjust-settings" style="display: none;">
                            <label class="setting-title">Revelado Digital</label>
                            
                            <div class="setting-row">
                                <label>Brillo</label>
                                <div class="slider-wrapper">
                                    <input type="range" id="brightness-slider" min="50" max="150" value="100" class="editor-range">
                                    <span class="slider-val" id="brightness-val">100%</span>
                                </div>
                            </div>
                            
                            <div class="setting-row">
                                <label>Contraste</label>
                                <div class="slider-wrapper">
                                    <input type="range" id="contrast-slider" min="50" max="150" value="100" class="editor-range">
                                    <span class="slider-val" id="contrast-val">100%</span>
                                </div>
                            </div>
                            
                            <div class="setting-row">
                                <label>Saturación</label>
                                <div class="slider-wrapper">
                                    <input type="range" id="saturation-slider" min="0" max="200" value="100" class="editor-range">
                                    <span class="slider-val" id="saturation-val">100%</span>
                                </div>
                            </div>

                            <div class="setting-row">
                                <label>Exposición</label>
                                <div class="slider-wrapper">
                                    <input type="range" id="exposure-slider" min="50" max="150" value="100" class="editor-range">
                                    <span class="slider-val" id="exposure-val">100%</span>
                                </div>
                            </div>
                            <button class="btn-action secondary reset-btn" id="reset-adjusts">Restaurar Valores</button>
                        </div>

                        <!-- Filtros Artísticos -->
                        <div class="tool-settings" id="filter-settings" style="display: none;">
                            <label class="setting-title">Filtros Creativos</label>
                            <div class="filter-presets">
                                <button class="filter-preset active" data-filter="none">Ninguno</button>
                                <button class="filter-preset" data-filter="crimson">Velvet Crimson</button>
                                <button class="filter-preset" data-filter="sepia">Golden Sepia</button>
                                <button class="filter-preset" data-filter="emerald">Esmeralda</button>
                                <button class="filter-preset" data-filter="monochrome">Gris Platinado</button>
                                <button class="filter-preset" data-filter="glitch">Glitch Azulado</button>
                            </div>
                        </div>

                        <!-- Configuración de Relieve 3D -->
                        <div class="tool-settings" id="depth3d-settings" style="display: none;">
                            <label class="setting-title">Relieve 3D e IA</label>
                            
                            <div class="setting-row">
                                <label>Intensidad de Parallax</label>
                                <div class="slider-wrapper">
                                    <input type="range" id="depth-intensity-slider" min="0" max="100" value="30" class="editor-range">
                                    <span class="slider-val" id="depth-intensity-val">30%</span>
                                </div>
                            </div>

                            <div class="setting-row">
                                <label>Mapa de Profundidad</label>
                                <select id="depth-map-preset" class="editor-select">
                                    <option value="brush">Pincel (Pintar Relieve)</option>
                                    <option value="sphere">Cúpula Central (Esfera)</option>
                                    <option value="tunnel">Efecto Túnel (Radial)</option>
                                    <option value="horizon">Gradiente de Horizonte</option>
                                </select>
                            </div>

                            <div class="setting-row" id="brush-settings">
                                <label>Tamaño del Pincel</label>
                                <div class="slider-wrapper">
                                    <input type="range" id="brush-size-slider" min="10" max="200" value="60" class="editor-range">
                                    <span class="slider-val" id="brush-size-val">60px</span>
                                </div>
                            </div>

                            <div class="setting-row">
                                <label>Modo de Visualización 3D</label>
                                <select id="render-mode-select" class="editor-select">
                                    <option value="0">Imagen Desplazada (Normal)</option>
                                    <option value="1">Mapa de Profundidad (Gris)</option>
                                    <option value="2">Mapa de Calor (Estilo JMX)</option>
                                    <option value="3">Efecto Anaglifo (3D Estereoscópico)</option>
                                </select>
                            </div>

                            <div class="setting-row checkbox-row" style="align-items: center;">
                                <input type="checkbox" id="toggle-visualize-depth" class="editor-checkbox">
                                <label for="toggle-visualize-depth">Mostrar Mapa de Profundidad</label>
                            </div>

                            <div class="setting-row">
                                <label>Cargar Mapa de Profundidad</label>
                                <input type="file" id="depth-loader" accept="image/*" class="hidden">
                                <button class="btn-action secondary" id="btn-depth-loader-trigger" style="padding: 0.6rem; font-size: 0.55rem; letter-spacing: 1px;">Cargar Imagen de Relieve</button>
                            </div>
                            
                            <div class="info-box">
                                <p>💡 <strong>¿Cómo funciona?</strong> Mueve el mouse sobre la imagen para ver el relieve 3D. El blanco indica cercanía y el negro lejanía.</p>
                            </div>
                        </div>

                        <!-- Configuración de Texto -->
                        <div class="tool-settings" id="text-settings" style="display: none;">
                            <label class="setting-title">Añadir Capas de Texto</label>
                            <div class="setting-row">
                                <label>Texto de la Capa</label>
                                <input type="text" id="text-input" placeholder="Escribe algo..." class="editor-input">
                            </div>

                            <div class="setting-row">
                                <label>Tamaño de Letra</label>
                                <div class="slider-wrapper">
                                    <input type="range" id="text-size-slider" min="16" max="120" value="48" class="editor-range">
                                    <span class="slider-val" id="text-size-val">48px</span>
                                </div>
                            </div>

                            <div class="setting-row">
                                <label>Color de Texto</label>
                                <input type="color" id="text-color" value="#ffffff" class="editor-color">
                            </div>

                            <button class="btn-action gold" id="add-text-btn">Añadir Capa</button>
                        </div>

                        <!-- Carga Inicial -->
                        <div class="tool-settings" id="pointer-settings">
                            <label class="setting-title">Capas y Proyecto</label>
                            <div class="layers-list">
                                <div class="layer-item active" id="background-layer-item">
                                    <span class="layer-visible">👁️</span>
                                    <span class="layer-name">Imagen de Fondo</span>
                                </div>
                                <div id="dynamic-layers-container">
                                    <!-- Aquí irán dinámicamente las capas agregadas -->
                                </div>
                            </div>

                            <div class="project-actions" style="margin-top: 1rem; display: flex; gap: 0.5rem;">
                                <input type="file" id="project-loader" accept=".json" class="hidden">
                                <button class="btn-action secondary" id="btn-import-project" style="padding: 0.6rem; font-size: 0.55rem; letter-spacing: 1px;">Importar Proyecto</button>
                                <button class="btn-action secondary" id="btn-export-project" style="padding: 0.6rem; font-size: 0.55rem; letter-spacing: 1px;">Guardar Proyecto</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 💾 File Management Buttons -->
                <div class="panel-section file-management">
                    <input type="file" id="image-loader" accept="image/*" class="hidden">
                    <button class="btn-action" id="btn-load-trigger">Cargar Imagen</button>
                    <button class="btn-action gold disabled" id="btn-export" disabled>Exportar Obra</button>
                </div>
            </aside>
        </div>
    </main>
</Layout>

<style>
    :root {
        --color-editor-bg: #030303;
        --color-editor-panel: rgba(15, 15, 15, 0.9);
        --color-editor-border: rgba(255, 255, 255, 0.08);
        --color-editor-accent: #dcb14a;
        --color-editor-text-muted: rgba(255, 255, 255, 0.4);
        --transition-editor: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .editor-portal {
        min-height: 100vh;
        background: var(--color-editor-bg);
        color: #fff;
        font-family: 'Inter', sans-serif;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* 🧭 Navigation */
    .editor-nav {
        height: 60px;
        border-bottom: 1px solid var(--color-editor-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2rem;
        background: rgba(10, 10, 10, 0.95);
        backdrop-filter: blur(10px);
        z-index: 10;
        flex-shrink: 0;
    }

    .back-link {
        color: #fff;
        text-decoration: none;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 2px;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        opacity: 0.6;
        transition: var(--transition-editor);
    }

    .back-link:hover {
        opacity: 1;
        color: var(--color-editor-accent);
    }

    .system-status {
        font-family: monospace;
        font-size: 0.6rem;
        color: var(--color-editor-text-muted);
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        background: #00ff88;
        border-radius: 50%;
        box-shadow: 0 0 10px #00ff88;
    }

    /* 🎛️ Layout Grid */
    .editor-layout {
        display: flex;
        flex: 1;
        position: relative;
        overflow: hidden;
    }

    /* 🛠️ Left Toolbar */
    .left-toolbar {
        width: 60px;
        border-right: 1px solid var(--color-editor-border);
        background: var(--color-editor-panel);
        backdrop-filter: blur(20px);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 0;
        z-index: 5;
        flex-shrink: 0;
    }

    .tool-group {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        width: 100%;
        align-items: center;
    }

    .tool-btn {
        width: 44px;
        height: 44px;
        background: transparent;
        border: 1px solid transparent;
        color: var(--color-editor-text-muted);
        border-radius: 6px;
        cursor: pointer;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.1rem;
        transition: var(--transition-editor);
    }

    .tool-btn:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255,255,255,0.08);
    }

    .tool-btn.active {
        color: var(--color-editor-accent);
        background: rgba(220, 177, 74, 0.08);
        border-color: rgba(220, 177, 74, 0.3);
        box-shadow: inset 0 0 10px rgba(220, 177, 74, 0.05);
    }

    .tool-btn .tooltip {
        position: absolute;
        left: 70px;
        top: 50%;
        transform: translateY(-50%) translateX(10px);
        background: #121212;
        border: 1px solid var(--color-editor-border);
        color: #fff;
        padding: 0.5rem 1rem;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        border-radius: 4px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s, transform 0.3s;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        text-transform: uppercase;
    }

    .tool-btn:hover .tooltip {
        opacity: 1;
        transform: translateY(-50%) translateX(0);
    }

    /* 🖥️ Viewport central */
    .canvas-viewport {
        flex: 1;
        background-color: #0b0b0b;
        background-image: 
            radial-gradient(rgba(220, 177, 74, 0.08) 1px, transparent 1px),
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        background-size: 20px 20px, 100px 100px, 100px 100px;
        background-position: center;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .canvas-container {
        flex: 1;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
    }

    .brush-cursor-indicator {
        position: absolute;
        border: 2px dashed rgba(220, 177, 74, 0.6);
        border-radius: 50%;
        pointer-events: none;
        display: none;
        transform: translate(-50%, -50%);
        z-index: 100;
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }

    #main-webgl-canvas {
        max-width: 100%;
        max-height: 100%;
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.95);
        border: 1px solid rgba(255,255,255,0.05);
        background-image: linear-gradient(45deg, #151515 25%, transparent 25%),
                          linear-gradient(-45deg, #151515 25%, transparent 25%),
                          linear-gradient(45deg, transparent 75%, #151515 75%),
                          linear-gradient(-45deg, transparent 75%, #151515 75%);
        background-size: 20px 20px;
        background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
        display: none;
    }

    .upload-overlay {
        position: absolute;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 2px dashed rgba(220, 177, 74, 0.25);
        border-radius: 12px;
        padding: 4rem;
        background: rgba(15, 15, 15, 0.85);
        backdrop-filter: blur(15px);
        width: 80%;
        max-width: 500px;
        cursor: pointer;
        transition: var(--transition-editor);
    }

    .upload-overlay:hover {
        border-color: var(--color-editor-accent);
        box-shadow: 0 0 40px rgba(220, 177, 74, 0.08);
        transform: translateY(-4px);
    }

    .upload-icon {
        font-size: 3rem;
        margin-bottom: 1.5rem;
    }

    .upload-overlay h3 {
        font-size: 0.9rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 0.5rem;
        color: #fff;
    }

    .upload-overlay p {
        font-size: 0.75rem;
        color: var(--color-editor-text-muted);
        margin-bottom: 2rem;
    }

    .badge-limits {
        font-size: 0.55rem;
        color: var(--color-editor-accent);
        border: 1px solid rgba(220, 177, 74, 0.3);
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        letter-spacing: 1px;
    }

    .canvas-status {
        height: 35px;
        border-top: 1px solid var(--color-editor-border);
        background: var(--color-editor-panel);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 1.5rem;
        font-family: monospace;
        font-size: 0.6rem;
        color: var(--color-editor-text-muted);
        flex-shrink: 0;
    }

    /* ⚙️ Right Panel */
    .right-panel {
        width: 320px;
        border-left: 1px solid var(--color-editor-border);
        background: var(--color-editor-panel);
        backdrop-filter: blur(20px);
        display: flex;
        flex-direction: column;
        z-index: 5;
        flex-shrink: 0;
    }

    .panel-section {
        padding: 2rem;
        border-bottom: 1px solid var(--color-editor-border);
    }

    .panel-section h3 {
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 3px;
        color: var(--color-editor-accent);
        margin-bottom: 1.5rem;
        text-transform: uppercase;
    }

    .properties-content {
        flex: 1;
    }

    .tool-settings {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .setting-title {
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1px;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding-bottom: 0.5rem;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
    }

    .setting-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .setting-row label {
        font-size: 0.58rem;
        font-weight: 900;
        color: var(--color-editor-text-muted);
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .slider-wrapper {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .editor-range {
        flex: 1;
        -webkit-appearance: none;
        background: rgba(255,255,255,0.08);
        height: 3px;
        border-radius: 2px;
        outline: none;
    }

    .editor-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--color-editor-accent);
        cursor: pointer;
        transition: transform 0.2s;
    }

    .editor-range::-webkit-slider-thumb:hover {
        transform: scale(1.25);
    }

    .slider-val {
        font-family: monospace;
        font-size: 0.6rem;
        color: var(--color-editor-accent);
        min-width: 35px;
        text-align: right;
    }

    .editor-select, .editor-input {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        color: #fff;
        padding: 0.6rem 0.8rem;
        border-radius: 4px;
        font-size: 0.7rem;
        outline: none;
        transition: var(--transition-editor);
    }

    .editor-select:focus, .editor-input:focus {
        border-color: var(--color-editor-accent);
        background: rgba(255,255,255,0.05);
    }

    .editor-color {
        -webkit-appearance: none;
        border: 1px solid rgba(255,255,255,0.08);
        width: 100%;
        height: 38px;
        background: transparent;
        cursor: pointer;
        padding: 0;
        border-radius: 4px;
    }

    .editor-color::-webkit-color-swatch-wrapper {
        padding: 0;
    }
    .editor-color::-webkit-color-swatch {
        border: none;
        border-radius: 4px;
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .editor-checkbox {
        accent-color: var(--color-editor-accent);
        cursor: pointer;
    }

    .checkbox-row label {
        font-size: 0.6rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.5px;
        cursor: pointer;
    }

    .info-box {
        background: rgba(220, 177, 74, 0.05);
        border: 1px solid rgba(220, 177, 74, 0.15);
        padding: 1rem;
        border-radius: 4px;
    }
    .info-box p {
        font-size: 0.6rem;
        color: rgba(255,255,255,0.6);
        line-height: 1.5;
    }

    /* Preset list filters */
    .filter-presets {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.6rem;
    }

    .filter-preset {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 4px;
        padding: 0.7rem 0.5rem;
        font-size: 0.6rem;
        font-weight: 700;
        color: var(--color-editor-text-muted);
        cursor: pointer;
        transition: var(--transition-editor);
        text-align: center;
    }

    .filter-preset:hover {
        border-color: rgba(255,255,255,0.15);
        color: #fff;
    }

    .filter-preset.active {
        background: rgba(220, 177, 74, 0.08);
        border-color: var(--color-editor-accent);
        color: var(--color-editor-accent);
    }

    /* Layers List */
    .layers-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .layer-item {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 4px;
        padding: 0.8rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        font-size: 0.65rem;
        cursor: grab;
        transition: var(--transition-editor);
    }

    .layer-item.active {
        border-color: rgba(255,255,255,0.15);
        background: rgba(255,255,255,0.04);
    }

    .layer-item:hover {
        background: rgba(255,255,255,0.05);
    }

    .layer-visible {
        cursor: pointer;
        font-size: 0.75rem;
    }

    .layer-name {
        flex: 1;
