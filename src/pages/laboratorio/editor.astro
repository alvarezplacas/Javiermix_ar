</style>

<script type="module">
import * as THREE from 'three';

if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', initEditor);
}

function initEditor() {
    const dropZone = document.getElementById('drop-zone');
    const imgLoader = document.getElementById('image-loader');
    const btnLoadTrigger = document.getElementById('btn-load-trigger');
    const uploadPrompt = document.getElementById('upload-prompt');
    const canvas = document.getElementById('main-webgl-canvas');
    const btnExport = document.getElementById('btn-export');
    const projectLoader = document.getElementById('project-loader');
    const btnImportProject = document.getElementById('btn-import-project');
    const btnExportProject = document.getElementById('btn-export-project');
    const depthLoader = document.getElementById('depth-loader');
    const btnDepthLoaderTrigger = document.getElementById('btn-depth-loader-trigger');

    const toolBtns = document.querySelectorAll('.tool-btn');
    const activeToolLabel = document.getElementById('active-tool-status');
    const dimensionLabel = document.getElementById('image-dimensions');

    const adjustPanel = document.getElementById('adjust-settings');
    const filterPanel = document.getElementById('filter-settings');
    const depthPanel = document.getElementById('depth3d-settings');
    const textPanel = document.getElementById('text-settings');
    const pointerPanel = document.getElementById('pointer-settings');

    const brightnessSlider = document.getElementById('brightness-slider');
    const contrastSlider = document.getElementById('contrast-slider');
    const saturationSlider = document.getElementById('saturation-slider');
    const exposureSlider = document.getElementById('exposure-slider');
    const resetAdjusts = document.getElementById('reset-adjusts');
    const presetBtns = document.querySelectorAll('.filter-preset');
    const textInput = document.getElementById('text-input');
    const textSizeSlider = document.getElementById('text-size-slider');
    const textColorPicker = document.getElementById('text-color');
    const addTextBtn = document.getElementById('add-text-btn');
    const dynamicLayersContainer = document.getElementById('dynamic-layers-container');

    const depthIntensitySlider = document.getElementById('depth-intensity-slider');
    const depthIntensityVal = document.getElementById('depth-intensity-val');
    const depthPresetSelect = document.getElementById('depth-map-preset');
    const brushSettingsRow = document.getElementById('brush-settings');
    const brushSizeSlider = document.getElementById('brush-size-slider');
    const brushSizeVal = document.getElementById('brush-size-val');
    const visualizeDepthCheckbox = document.getElementById('toggle-visualize-depth');
    const renderModeSelect = document.getElementById('render-mode-select');

    if (!canvas) return;

    const offscreenImage = document.createElement('canvas');
    const offscreenCtx = offscreenImage.getContext('2d');
    const offscreenDepth = document.createElement('canvas');
    const offscreenDepthCtx = offscreenDepth.getContext('2d');

    let originalImage = null;
    let activeTool = 'pointer';
    let activeFilter = 'none';
    let filterMode = 0;
    let adjustments = { brightness: 100, contrast: 100, saturation: 100, exposure: 100 };
    let textLayers = [];
    let dragTextIndex = -1;
    let isPaintingDepth = false;
    let brushSize = 60;
    let depthIntensity = 0.3;
    let selectedDepthPreset = 'brush';
    let visualizeDepthMap = false;
    let renderMode = 0;
    let mouseX = 0.5;
    let mouseY = 0.5;
    let targetMouseX = 0.5;
    let targetMouseY = 0.5;

    let renderer = null;
    let scene = null;
    let camera = null;
    let material = null;
    let mesh = null;
    let imageTexture = null;
    let depthTexture = null;
    let animationFrameId = null;

    function updateSliderVal(slider, targetId, suffix = '') {
        const el = document.getElementById(targetId);
        if (el && slider) el.innerText = `${slider.value}${suffix}`;
    }

    brightnessSlider?.addEventListener('input', () => {
        adjustments.brightness = Number(brightnessSlider.value);
        updateSliderVal(brightnessSlider, 'brightness-val', '%');
        updateColorCanvas();
    });

    contrastSlider?.addEventListener('input', () => {
        adjustments.contrast = Number(contrastSlider.value);
        updateSliderVal(contrastSlider, 'contrast-val', '%');
        updateColorCanvas();
    });

    saturationSlider?.addEventListener('input', () => {
        adjustments.saturation = Number(saturationSlider.value);
        updateSliderVal(saturationSlider, 'saturation-val', '%');
        updateColorCanvas();
    });

    exposureSlider?.addEventListener('input', () => {
        adjustments.exposure = Number(exposureSlider.value);
        updateSliderVal(exposureSlider, 'exposure-val', '%');
        updateColorCanvas();
    });

    depthIntensitySlider?.addEventListener('input', () => {
        depthIntensity = Number(depthIntensitySlider.value) / 100;
        if (depthIntensityVal) depthIntensityVal.innerText = `${Math.round(depthIntensity * 100)}%`;
    });

    brushSizeSlider?.addEventListener('input', () => {
        brushSize = Number(brushSizeSlider.value);
        if (brushSizeVal) brushSizeVal.innerText = `${brushSize}px`;
    });

    visualizeDepthCheckbox?.addEventListener('change', () => {
        visualizeDepthMap = visualizeDepthCheckbox.checked;
    });

    depthPresetSelect?.addEventListener('change', () => {
        selectedDepthPreset = depthPresetSelect.value;
        if (brushSettingsRow) {
            brushSettingsRow.style.display = selectedDepthPreset === 'brush' ? 'block' : 'none';
        }
        if (originalImage) {
            generateDepthPreset();
            updateDepthTexture();
        }
    });

    resetAdjusts?.addEventListener('click', () => {
        adjustments = { brightness: 100, contrast: 100, saturation: 100, exposure: 100 };
        if (brightnessSlider) brightnessSlider.value = '100';
        if (contrastSlider) contrastSlider.value = '100';
        if (saturationSlider) saturationSlider.value = '100';
        if (exposureSlider) exposureSlider.value = '100';
        updateSliderVal(brightnessSlider, 'brightness-val', '%');
        updateSliderVal(contrastSlider, 'contrast-val', '%');
        updateSliderVal(saturationSlider, 'saturation-val', '%');
        updateSliderVal(exposureSlider, 'exposure-val', '%');
        updateColorCanvas();
    });

    toolBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            toolBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeTool = btn.getAttribute('data-tool') || 'pointer';
            if (activeToolLabel) activeToolLabel.innerText = `Herramienta: ${activeTool.toUpperCase()}`;
            if (adjustPanel) adjustPanel.style.display = activeTool === 'adjust' ? 'flex' : 'none';
            if (filterPanel) filterPanel.style.display = activeTool === 'filter' ? 'flex' : 'none';
            if (depthPanel) depthPanel.style.display = activeTool === 'depth3d' ? 'flex' : 'none';
            if (textPanel) textPanel.style.display = activeTool === 'text' ? 'flex' : 'none';
            if (pointerPanel) pointerPanel.style.display = activeTool === 'pointer' ? 'flex' : 'none';
        });
    });

    btnLoadTrigger?.addEventListener('click', () => imgLoader?.click());
    uploadPrompt?.addEventListener('click', () => imgLoader?.click());

    imgLoader?.addEventListener('change', (event) => {
        const input = event.target;
        const file = input.files && input.files[0];
        if (file) loadImageFile(file);
    });

    dropZone?.addEventListener('dragover', (event) => {
        event.preventDefault();
        dropZone.classList.add('drag-over');
    });
    dropZone?.addEventListener('dragleave', () => {
        dropZone.classList.remove('drag-over');
    });
    dropZone?.addEventListener('drop', (event) => {
        event.preventDefault();
        dropZone.classList.remove('drag-over');
        const file = event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0];
        if (file) loadImageFile(file);
    });

    btnExport?.addEventListener('click', exportFinalImage);
    btnExportProject?.addEventListener('click', exportProject);
    btnImportProject?.addEventListener('click', () => projectLoader?.click());

    projectLoader?.addEventListener('change', (event) => {
        const input = event.target;
        const file = input.files && input.files[0];
        if (file) importProject(file);
    });

    btnDepthLoaderTrigger?.addEventListener('click', () => depthLoader?.click());
    depthLoader?.addEventListener('change', (event) => {
        const input = event.target;
        const file = input.files && input.files[0];
        if (file) loadDepthFile(file);
    });

    presetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            presetBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeFilter = btn.getAttribute('data-filter') || 'none';
            filterMode = filterId(activeFilter);
            if (material?.uniforms?.uFilterMode) {
                material.uniforms.uFilterMode.value = filterMode;
            }
            updateColorCanvas();
        });
    });

    renderModeSelect?.addEventListener('change', () => {
        renderMode = Number(renderModeSelect.value);
    });

    canvas.addEventListener('mousemove', onCanvasMouseMove);
    canvas.addEventListener('mousedown', onCanvasMouseDown);
    window.addEventListener('mouseup', () => {
        isPaintingDepth = false;
        dragTextIndex = -1;
    });
    window.addEventListener('resize', resizeRenderer);
    window.addEventListener('beforeunload', cleanup);

    addTextBtn?.addEventListener('click', () => {
        const text = textInput?.value.trim();
        if (!text || !originalImage) return;
        const size = Number(textSizeSlider?.value || '48');
        const color = textColorPicker?.value || '#ffffff';
        textLayers.push({ id: `layer-${Date.now()}`, text, size, color, x: 0.5, y: 0.5 });
        if (textInput) textInput.value = '';
        updateColorCanvas();
        renderLayersUI();
    });

    function loadImageFile(file) {
        const reader = new FileReader();
        reader.onload = () => {
            const img = new Image();
            img.onload = () => {
                originalImage = img;
                offscreenImage.width = img.width;
                offscreenImage.height = img.height;
                offscreenDepth.width = img.width;
                offscreenDepth.height = img.height;
                if (offscreenDepthCtx) {
                    offscreenDepthCtx.fillStyle = '#000000';
                    offscreenDepthCtx.fillRect(0, 0, img.width, img.height);
                }
                canvas.width = img.width;
                canvas.height = img.height;
                if (canvas instanceof HTMLCanvasElement) canvas.style.display = 'block';
                if (uploadPrompt) uploadPrompt.style.display = 'none';
                if (dimensionLabel) dimensionLabel.innerText = `Resolución: ${img.width}x${img.height}`;
                if (btnExport) { btnExport.classList.remove('disabled'); btnExport.disabled = false; }
                textLayers = [];
                selectedDepthPreset = 'brush';
                if (depthPresetSelect) depthPresetSelect.value = 'brush';
                if (brushSettingsRow) brushSettingsRow.style.display = 'block';
                visualizeDepthMap = false;
                if (visualizeDepthCheckbox) visualizeDepthCheckbox.checked = false;
                renderMode = 0;
                const renderModeSelect = document.getElementById('render-mode-select');
                if (renderModeSelect) renderModeSelect.value = '0';
                updateColorCanvas();
                generateDepthPreset();
                initThree();
            };
            img.src = reader.result;
        };
        reader.readAsDataURL(file);
    }

    function loadDepthFile(file) {
        const reader = new FileReader();
        reader.onload = () => {
            const img = new Image();
            img.onload = () => {
                if (!offscreenDepthCtx) return;
                offscreenDepthCtx.clearRect(0, 0, offscreenDepth.width, offscreenDepth.height);
                offscreenDepthCtx.drawImage(img, 0, 0, offscreenDepth.width, offscreenDepth.height);
                updateDepthTexture();
            };
            img.src = reader.result;
        };
        reader.readAsDataURL(file);
    }

    function updateColorCanvas() {
        if (!originalImage || !offscreenCtx) return;
        offscreenCtx.clearRect(0, 0, offscreenImage.width, offscreenImage.height);
        offscreenCtx.filter = `brightness(${adjustments.brightness * (adjustments.exposure / 100)}%) contrast(${adjustments.contrast}%) saturate(${adjustments.saturation}%)`;
        offscreenCtx.drawImage(originalImage, 0, 0, offscreenImage.width, offscreenImage.height);
        offscreenCtx.filter = 'none';
        if (activeFilter !== 'none') {
            offscreenCtx.save();
            if (activeFilter === 'crimson') {
                offscreenCtx.fillStyle = 'rgba(220, 70, 70, 0.12)';
            } else if (activeFilter === 'sepia') {
                offscreenCtx.fillStyle = 'rgba(220, 177, 74, 0.15)';
            } else if (activeFilter === 'emerald') {
                offscreenCtx.fillStyle = 'rgba(20, 180, 120, 0.15)';
            } else if (activeFilter === 'monochrome') {
                offscreenCtx.fillStyle = 'rgba(255, 255, 255, 0.05)';
            } else if (activeFilter === 'glitch') {
                offscreenCtx.drawImage(offscreenImage, 8, 4, offscreenImage.width - 8, offscreenImage.height - 4, 0, 0, offscreenImage.width, offscreenImage.height);
                offscreenCtx.fillStyle = 'rgba(20, 150, 220, 0.08)';
            }
            offscreenCtx.fillRect(0, 0, offscreenImage.width, offscreenImage.height);
            offscreenCtx.restore();
        }
        textLayers.forEach(layer => {
            offscreenCtx.fillStyle = layer.color;
            offscreenCtx.font = `bold ${layer.size * (offscreenImage.width / 800)}px 'Cormorant Garamond', serif`;
            offscreenCtx.textAlign = 'center';
            offscreenCtx.fillText(layer.text, layer.x * offscreenImage.width, layer.y * offscreenImage.height);
        });
        if (material?.uniforms) {
            material.uniforms.uBrightness.value = adjustments.brightness / 100;
            material.uniforms.uContrast.value = adjustments.contrast / 100;
            material.uniforms.uSaturation.value = adjustments.saturation / 100;
            material.uniforms.uFilterMode.value = filterMode;
        }
        updateColorTexture();
    }

    function renderLayersUI() {
        if (!dynamicLayersContainer) return;
        dynamicLayersContainer.innerHTML = textLayers.map((layer, index) => `
            <div class="layer-item" data-id="${layer.id}">
                <span class="layer-visible">👁️</span>
                <span class="layer-name">Texto: "${layer.text.substring(0, 12)}..."</span>
                <button class="delete-layer-btn" data-idx="${index}">&times;</button>
            </div>
        `).join('');
        document.querySelectorAll('.delete-layer-btn').forEach(btn => {
            btn.addEventListener('click', (event) => {
                event.stopPropagation();
                const idx = Number(btn.getAttribute('data-idx'));
                textLayers.splice(idx, 1);
                updateColorCanvas();
                renderLayersUI();
            });
        });
    }

    function generateDepthPreset() {
        if (!offscreenDepthCtx || !originalImage) return;
        const w = offscreenDepth.width;
        const h = offscreenDepth.height;
        offscreenDepthCtx.fillStyle = '#000000';
        offscreenDepthCtx.fillRect(0, 0, w, h);
        if (selectedDepthPreset === 'sphere') {
            const grad = offscreenDepthCtx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, Math.max(w, h) / 2);
            grad.addColorStop(0, '#ffffff');
            grad.addColorStop(1, '#000000');
            offscreenDepthCtx.fillStyle = grad;
            offscreenDepthCtx.fillRect(0, 0, w, h);
        } else if (selectedDepthPreset === 'tunnel') {
            const grad = offscreenDepthCtx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, Math.max(w, h) / 2);
            grad.addColorStop(0, '#000000');
            grad.addColorStop(0.7, '#666666');
            grad.addColorStop(1, '#ffffff');
            offscreenDepthCtx.fillStyle = grad;
            offscreenDepthCtx.fillRect(0, 0, w, h);
        } else if (selectedDepthPreset === 'horizon') {
            const grad = offscreenDepthCtx.createLinearGradient(0, 0, 0, h);
            grad.addColorStop(0, '#000000');
            grad.addColorStop(0.5, '#ffffff');
            grad.addColorStop(1, '#000000');
            offscreenDepthCtx.fillStyle = grad;
            offscreenDepthCtx.fillRect(0, 0, w, h);
        }
        updateDepthTexture();
    }

    function initThree() {
        if (renderer) return;
        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
        renderer.setPixelRatio(window.devicePixelRatio || 1);
        renderer.outputEncoding = THREE.sRGBEncoding;
        renderer.setClearColor(0x000000, 0);
        const width = canvas.clientWidth || canvas.width;
        const height = canvas.clientHeight || canvas.height;
        renderer.setSize(width, height, false);
        scene = new THREE.Scene();
        camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
        camera.position.z = 1;
        const geometry = new THREE.PlaneGeometry(2, 2);
        material = new THREE.ShaderMaterial({
            uniforms: {
                uImage: { value: null },
                uDepthMap: { value: null },
                uMouseOffset: { value: new THREE.Vector2(0.5, 0.5) },
                uDepthIntensity: { value: depthIntensity },
                uVisualizeDepth: { value: visualizeDepthMap },
                uRenderMode: { value: renderMode },
                uBrightness: { value: adjustments.brightness / 100 },
                uContrast: { value: adjustments.contrast / 100 },
                uSaturation: { value: adjustments.saturation / 100 },
                uFilterMode: { value: filterMode }
            },
            vertexShader: `
                varying vec2 vUv;
                void main() {
                    vUv = uv;
                    gl_Position = vec4(position, 1.0);
                }
            `,
            fragmentShader: `
                precision highp float;
                uniform sampler2D uImage;
                uniform sampler2D uDepthMap;
                uniform vec2 uMouseOffset;
                uniform float uDepthIntensity;
                uniform bool uVisualizeDepth;
                uniform int uRenderMode;
                uniform float uBrightness;
                uniform float uContrast;
                uniform float uSaturation;
                uniform int uFilterMode;
                varying vec2 vUv;
                vec3 adjustColor(vec3 color) {
                    color *= uBrightness;
                    color = (color - 0.5) * uContrast + 0.5;
                    float grey = dot(color, vec3(0.299, 0.587, 0.114));
                    return mix(vec3(grey), color, uSaturation);
                }
                vec3 artisticFilter(vec3 color) {
                    if (uFilterMode == 1) {
                        return color * vec3(1.05, 0.9, 0.95);
                    }
                    if (uFilterMode == 2) {
                        return mix(vec3(0.25, 0.16, 0.08), color, 0.7);
                    }
                    if (uFilterMode == 3) {
                        float grey = dot(color, vec3(0.299, 0.587, 0.114));
                        return vec3(grey);
                    }
                    if (uFilterMode == 4) {
                        return color * vec3(0.8, 1.05, 0.9);
                    }
                    if (uFilterMode == 5) {
                        return mix(color, vec3(color.b * 1.2, color.g * 0.9, color.r * 0.9), 0.25);
                    }
                    return color;
                }
                void main() {
                    if (uVisualizeDepth) {
                        gl_FragColor = texture2D(uDepthMap, vUv);
                        return;
                    }
                    float depthValue = texture2D(uDepthMap, vUv).r;
                    vec2 displacedUv = vUv + (uMouseOffset - vec2(0.5)) * depthValue * uDepthIntensity;
                    displacedUv = clamp(displacedUv, 0.0, 1.0);
                    vec4 color = texture2D(uImage, displacedUv);
                    color.rgb = adjustColor(color.rgb);
                    color.rgb = artisticFilter(color.rgb);
                    if (uRenderMode == 1) {
                        float gray = texture2D(uDepthMap, vUv).r;
                        gl_FragColor = vec4(vec3(gray), 1.0);
                        return;
                    }
                    if (uRenderMode == 2) {
                        float gray = texture2D(uDepthMap, vUv).r;
                        gl_FragColor = vec4(vec3(gray * 0.4, gray * 0.8, 1.0 - gray), 1.0);
                        return;
                    }
                    if (uRenderMode == 3) {
                        float r = texture2D(uImage, vec2(clamp(displacedUv.x + 0.01, 0.0, 1.0), displacedUv.y)).r;
                        float g = color.g;
                        float b = texture2D(uImage, vec2(clamp(displacedUv.x - 0.01, 0.0, 1.0), displacedUv.y)).b;
                        gl_FragColor = vec4(r, g, b, color.a);
                        return;
                    }
                    gl_FragColor = color;
                }
            `
        });
        mesh = new THREE.Mesh(geometry, material);
        scene.add(mesh);
        imageTexture = new THREE.Texture(offscreenImage);
        imageTexture.minFilter = THREE.LinearFilter;
        imageTexture.magFilter = THREE.LinearFilter;
        imageTexture.flipY = false;
        imageTexture.encoding = THREE.sRGBEncoding;
        imageTexture.needsUpdate = true;
        depthTexture = new THREE.Texture(offscreenDepth);
        depthTexture.minFilter = THREE.LinearFilter;
        depthTexture.magFilter = THREE.LinearFilter;
        depthTexture.flipY = false;
        depthTexture.needsUpdate = true;
        material.uniforms.uImage.value = imageTexture;
        material.uniforms.uDepthMap.value = depthTexture;
        resizeRenderer();
        renderLoop();
    }

    function resizeRenderer() {
        if (!renderer || !camera || !canvas) return;
        const width = canvas.clientWidth || canvas.width;
        const height = canvas.clientHeight || canvas.height;
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
    }

    function renderLoop() {
        if (!renderer || !material || !scene || !camera) return;
        animationFrameId = window.requestAnimationFrame(renderLoop);
        mouseX += (targetMouseX - mouseX) * 0.08;
        mouseY += (targetMouseY - mouseY) * 0.08;
        const offset = new THREE.Vector2((mouseX - 0.5) * 0.04, (mouseY - 0.5) * -0.04);
        material.uniforms.uMouseOffset.value.copy(offset);
        material.uniforms.uDepthIntensity.value = activeTool === 'depth3d' ? depthIntensity : 0.0;
        material.uniforms.uVisualizeDepth.value = visualizeDepthMap;
        material.uniforms.uRenderMode.value = renderMode;
        renderer.render(scene, camera);
    }

    function updateColorTexture() {
        if (!imageTexture) return;
        imageTexture.needsUpdate = true;
    }

    function updateDepthTexture() {
        if (!depthTexture) return;
        depthTexture.needsUpdate = true;
    }

    function onCanvasMouseMove(event) {
        if (!canvas || !originalImage) return;
        const rect = canvas.getBoundingClientRect();
        const xNorm = (event.clientX - rect.left) / rect.width;
        const yNorm = (event.clientY - rect.top) / rect.height;
        targetMouseX = xNorm;
        targetMouseY = yNorm;
        if (activeTool === 'depth3d' && selectedDepthPreset === 'brush' && isPaintingDepth) {
            paintDepthBrush(xNorm * offscreenDepth.width, yNorm * offscreenDepth.height);
        }
        if (activeTool === 'pointer' && dragTextIndex !== -1) {
            textLayers[dragTextIndex].x = xNorm;
            textLayers[dragTextIndex].y = yNorm;
            updateColorCanvas();
        }
    }

    function onCanvasMouseDown(event) {
        if (!canvas || !originalImage) return;
        const rect = canvas.getBoundingClientRect();
        const xNorm = (event.clientX - rect.left) / rect.width;
        const yNorm = (event.clientY - rect.top) / rect.height;
        if (activeTool === 'depth3d' && selectedDepthPreset === 'brush') {
            isPaintingDepth = true;
            paintDepthBrush(xNorm * offscreenDepth.width, yNorm * offscreenDepth.height);
        }
        if (activeTool === 'pointer') {
            dragTextIndex = textLayers.findIndex(layer => {
                const dist = Math.hypot(layer.x - xNorm, layer.y - yNorm);
                return dist < 0.08;
            });
        }
    }

    function paintDepthBrush(x, y) {
        if (!offscreenDepthCtx) return;
        const grad = offscreenDepthCtx.createRadialGradient(x, y, 0, x, y, brushSize);
        grad.addColorStop(0, 'rgba(255,255,255,0.15)');
        grad.addColorStop(1, 'rgba(255,255,255,0.0)');
        offscreenDepthCtx.save();
        offscreenDepthCtx.fillStyle = grad;
        offscreenDepthCtx.beginPath();
        offscreenDepthCtx.arc(x, y, brushSize, 0, Math.PI * 2);
        offscreenDepthCtx.fill();
        offscreenDepthCtx.restore();
        updateDepthTexture();
    }

    function exportFinalImage() {
        if (!canvas || !btnExport || btnExport.classList.contains('disabled')) return;
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = canvas.width;
        exportCanvas.height = canvas.height;
        const exportCtx = exportCanvas.getContext('2d');
        if (!exportCtx) return;
        exportCtx.drawImage(canvas, 0, 0);
        const url = exportCanvas.toDataURL('image/jpeg', 0.95);
        const link = document.createElement('a');
        link.href = url;
        link.download = `JMX_Obra_Modificada_${Date.now()}.jpg`;
        link.click();
    }

    function exportProject() {
        if (!originalImage) return;
        const project = {
            image: offscreenImage.toDataURL('image/png'),
            adjustments,
            activeFilter,
            textLayers,
            depthMap: offscreenDepth.toDataURL('image/png'),
            selectedDepthPreset,
            brushSize,
            depthIntensity,
            renderMode,
            visualizeDepthMap
        };
        const blob = new Blob([JSON.stringify(project, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `JMX_Editor_Proyecto_${Date.now()}.json`;
        link.click();
        URL.revokeObjectURL(url);
    }

    function importProject(file) {
        const reader = new FileReader();
        reader.onload = () => {
            try {
                const project = JSON.parse(reader.result);
                restoreProject(project);
            } catch (error) {
                console.error('Error cargando proyecto:', error);
            }
        };
        reader.readAsText(file);
    }

    function restoreProject(project) {
        if (!project.image) return;
        const img = new Image();
        img.onload = () => {
            originalImage = img;
            offscreenImage.width = img.width;
            offscreenImage.height = img.height;
            offscreenDepth.width = img.width;
            offscreenDepth.height = img.height;
            canvas.width = img.width;
            canvas.height = img.height;
            if (canvas instanceof HTMLCanvasElement) canvas.style.display = 'block';
            if (uploadPrompt) uploadPrompt.style.display = 'none';
            if (dimensionLabel) dimensionLabel.innerText = `Resolución: ${img.width}x${img.height}`;
            if (btnExport) { btnExport.classList.remove('disabled'); btnExport.disabled = false; }
            adjustments = project.adjustments || adjustments;
            activeFilter = project.activeFilter || 'none';
            textLayers = project.textLayers || [];
            selectedDepthPreset = project.selectedDepthPreset || 'brush';
            brushSize = project.brushSize ?? 60;
            depthIntensity = project.depthIntensity ?? 0.3;
            renderMode = project.renderMode ?? 0;
            visualizeDepthMap = project.visualizeDepthMap || false;
            if (brightnessSlider) brightnessSlider.value = String(adjustments.brightness || 100);
            if (contrastSlider) contrastSlider.value = String(adjustments.contrast || 100);
            if (saturationSlider) saturationSlider.value = String(adjustments.saturation || 100);
            if (exposureSlider) exposureSlider.value = String(adjustments.exposure || 100);
            updateSliderVal(brightnessSlider, 'brightness-val', '%');
            updateSliderVal(contrastSlider, 'contrast-val', '%');
            updateSliderVal(saturationSlider, 'saturation-val', '%');
            updateSliderVal(exposureSlider, 'exposure-val', '%');
            if (depthPresetSelect) depthPresetSelect.value = selectedDepthPreset;
            if (brushSizeSlider) brushSizeSlider.value = String(brushSize);
            if (depthIntensitySlider) depthIntensitySlider.value = String(Math.round(depthIntensity * 100));
            if (depthIntensityVal) depthIntensityVal.innerText = `${Math.round(depthIntensity * 100)}%`;
            if (visualizeDepthCheckbox) visualizeDepthCheckbox.checked = visualizeDepthMap;
            const renderModeSelect = document.getElementById('render-mode-select');
            if (renderModeSelect) renderModeSelect.value = String(renderMode);
            updateColorCanvas();
            if (project.depthMap) {
                const depthImg = new Image();
                depthImg.onload = () => {
                    if (!offscreenDepthCtx) return;
                    offscreenDepthCtx.clearRect(0, 0, offscreenDepth.width, offscreenDepth.height);
                    offscreenDepthCtx.drawImage(depthImg, 0, 0, offscreenDepth.width, offscreenDepth.height);
                    updateDepthTexture();
                };
                depthImg.src = project.depthMap;
            } else {
                generateDepthPreset();
            }
            renderLayersUI();
            initThree();
        };
        img.src = project.image;
    }

    function cleanup() {
        if (animationFrameId) {
            cancelAnimationFrame(animationFrameId);
            animationFrameId = null;
        }
        window.removeEventListener('resize', resizeRenderer);
        if (renderer) {
            renderer.dispose();
            renderer = null;
        }
        if (mesh) {
            mesh.geometry.dispose();
            if (mesh.material) mesh.material.dispose();
        }
        scene = null;
        camera = null;
        material = null;
        mesh = null;
        imageTexture = null;
        depthTexture = null;
    }
}
</script>
