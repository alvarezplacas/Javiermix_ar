---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\laboratorio\profundidad.astro
import Layout from '@layouts/Layout.astro';
import { getCatalogoFiles } from '@conexion/directus';
import { getOptimizedImageURL } from '@utils/media';

export const prerender = false;

const artworksRaw = await getCatalogoFiles();
const artworks = artworksRaw
    .filter(file => !file.filename_download.toLowerCase().includes('_2'))
    .slice(0, 15)
    .map((file, index) => ({
        id: file.id,
        title: file.title || `Obra ${index + 1}`,
        img: getOptimizedImageURL(file.id, { width: 1200, format: 'avif', quality: 90 }),
        x: Math.round((Math.random() - 0.5) * 300),
        y: Math.round((Math.random() - 0.5) * 150),
        index,
    }));

const SPACING = 900; // px entre cuadros en el eje Z
---

<Layout title="Infinity Gallery 3D | Laboratorio JMX" themeForce="dark">
    <main class="infinity-container">

        <!-- 🌌 Fondo de Partículas -->
        <canvas id="dust-canvas"></canvas>

        <!--
            ✅ ARQUITECTURA 3D CORRECTA:
            .scene-wrapper → tiene perspective (fixed, así cubre el viewport)
            .tunnel        → se mueve en Z (simula que la cámara avanza)
            .art-frame     → posiciones fijas en Z, centradas en X/Y
        -->
        <div class="scene-wrapper">
            <div class="tunnel" id="tunnel">
                {artworks.map((art) => (
                    <div
                        class="art-frame"
                        data-index={art.index}
                        data-x={art.x}
                        data-y={art.y}
                        data-z={-(art.index + 1) * SPACING}
                        style={`transform: translate3d(-50%, -50%, 0) translate3d(${art.x}px, ${art.y}px, ${-(art.index + 1) * SPACING}px);`}
                    >
                        <img src={art.img} alt={art.title} loading="lazy" />
                        <div class="art-info">
                            <h3>{art.title}</h3>
                            <span>0{art.index + 1}</span>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <!-- Indicador de scroll -->
        <div class="scroll-indicator" id="scroll-hint">
            <div class="mouse"></div>
            <span>SCROLL PARA AVANZAR</span>
        </div>

        <!-- 🕹️ Controles -->
        <div class="lab-controls">
            <button id="play-btn" class="lab-btn">
                <span class="icon">▶</span> PLAY TOUR
            </button>
            <button id="sound-btn" class="lab-btn">
                <span class="icon">🔇</span> AUDIO OFF
            </button>
            <div class="depth-meter">DEPTH: <span id="depth-val">0</span>m</div>
        </div>

        <a href="/laboratorio" class="back-btn">← SALIR AL GABINETE</a>
    </main>
</Layout>

<style>
    /* ─── Contenedor scrolleable (da espacio al scroll) ─── */
    .infinity-container {
        height: 700vh;
        background: #000;
        color: #fff;
    }

    /* ─── Canvas partículas ─── */
    #dust-canvas {
        position: fixed;
        inset: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        z-index: 1;
        opacity: 0.35;
    }

    /* ─── Wrapper con PERSPECTIVE (fixed = cubre viewport) ─── */
    .scene-wrapper {
        position: fixed;
        inset: 0;
        perspective: 750px;
        perspective-origin: 50% 45%;
        overflow: hidden;
        z-index: 2;
    }

    /* ─── Túnel 3D: JS le aplica translateZ para simular avance ─── */
    .tunnel {
        position: absolute;
        inset: 0;
        transform-style: preserve-3d;
        /* JS: translateZ(progress) */
    }

    /* ─── Cada cuadro, centrado en viewport ─── */
    .art-frame {
        position: absolute;
        width: 580px;
        /* Centrar en el viewport */
        left: 50%;
        top: 50%;
        transform-style: preserve-3d;
        /* transform inicial viene del style inline en el HTML */
        will-change: opacity, transform;
    }

    .art-frame img {
        width: 100%;
        height: auto;
        display: block;
        box-shadow: 0 40px 120px rgba(0,0,0,0.95), 0 0 60px rgba(220,177,74,0.08);
        border: 1px solid rgba(255,255,255,0.06);
    }

    .art-info {
        margin-top: 0.9rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'Cormorant Garamond', serif;
    }

    .art-info h3 {
        font-weight: 300;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 1.1rem;
        color: rgba(255,255,255,0.85);
    }

    .art-info span {
        color: #dcb14a;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 1px;
    }

    /* ─── Scroll indicator ─── */
    .scroll-indicator {
        position: fixed;
        bottom: 6rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.8rem;
        z-index: 10;
        opacity: 0.6;
        transition: opacity 0.5s;
        font-size: 0.6rem;
        letter-spacing: 3px;
        font-weight: 700;
    }

    .mouse {
        width: 20px; height: 34px;
        border: 2px solid rgba(255,255,255,0.7);
        border-radius: 15px;
        position: relative;
    }
    .mouse::after {
        content: '';
        position: absolute;
        top: 7px; left: 50%;
        transform: translateX(-50%);
        width: 3px; height: 3px;
        background: #fff;
        border-radius: 50%;
        animation: scrollMouse 1.8s infinite;
    }
    @keyframes scrollMouse {
        0%   { opacity: 1; top: 7px; }
        100% { opacity: 0; top: 22px; }
    }

    /* ─── Back btn ─── */
    .back-btn {
        position: fixed;
        top: 1.8rem; left: 1.8rem;
        z-index: 100;
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        font-size: 0.65rem;
        letter-spacing: 3px;
        font-weight: 900;
        transition: 0.3s;
    }
    .back-btn:hover { color: #dcb14a; opacity: 1; }

    /* ─── Controls bar ─── */
    .lab-controls {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 2rem;
        background: rgba(0,0,0,0.75);
        padding: 0.75rem 2rem;
        border: 1px solid rgba(220,177,74,0.2);
        border-radius: 50px;
        backdrop-filter: blur(12px);
        z-index: 100;
    }

    .lab-btn {
        background: transparent;
        border: none;
        color: rgba(255,255,255,0.6);
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 2px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        transition: 0.3s;
    }
    .lab-btn:hover, .lab-btn.active { color: #dcb14a; opacity: 1 !important; }

    .depth-meter {
        font-family: monospace;
        font-size: 0.58rem;
        color: rgba(255,255,255,0.35);
        border-left: 1px solid rgba(255,255,255,0.1);
        padding-left: 1.5rem;
        letter-spacing: 1px;
    }

    @media (max-width: 768px) {
        .art-frame { width: 88vw; }
        .lab-controls { width: 90vw; gap: 1rem; }
        .depth-meter { display: none; }
    }
</style>

<script>
    import { soundManager } from '../../utils/SoundManager';

    document.addEventListener('astro:page-load', () => {
        const tunnel    = document.getElementById('tunnel') as HTMLElement;
        const frames    = document.querySelectorAll<HTMLElement>('.art-frame');
        const canvas    = document.getElementById('dust-canvas') as HTMLCanvasElement;
        const playBtn   = document.getElementById('play-btn') as HTMLButtonElement;
        const soundBtn  = document.getElementById('sound-btn') as HTMLButtonElement;
        const depthVal  = document.getElementById('depth-val') as HTMLElement;
        const scrollHint = document.getElementById('scroll-hint') as HTMLElement;

        if (!tunnel || !canvas) return;

        const SPACING      = 900;   // debe coincidir con el valor en el frontmatter
        const SCROLL_SPEED = 1.0;   // px de avance por px de scroll
        const AUTO_SPEED   = 1.8;   // px por frame en auto-tour

        let soundEnabled  = false;
        let isPlaying     = false;
        let virtualScroll = 0;
        let lastScrollY   = 0;
        let pauseCounter  = 0;
        let lastPausedIndex = -1;

        // ── Audio ──────────────────────────────────────────
        soundManager.init();

        soundBtn.addEventListener('click', () => {
            soundEnabled = !soundEnabled;
            if (soundEnabled) {
                soundManager.enable();
                soundManager.playMusic('https://admin.javiermix.ar/assets/22503906-6608-4d38-ae0d-fe7999d25216');
                soundBtn.innerHTML = '<span class="icon">🔊</span> AUDIO ON';
                soundBtn.classList.add('active');
            } else {
                soundManager.disable();
                soundBtn.innerHTML = '<span class="icon">🔇</span> AUDIO OFF';
                soundBtn.classList.remove('active');
            }
        });

        playBtn.addEventListener('click', () => {
            isPlaying = !isPlaying;
            playBtn.innerHTML = isPlaying
                ? '<span class="icon">⏸</span> PAUSE'
                : '<span class="icon">▶</span> PLAY TOUR';
            playBtn.classList.toggle('active', isPlaying);
            if (isPlaying) scrollHint.style.opacity = '0';
        });

        const onScroll = () => {
            if (Math.abs(window.scrollY - lastScrollY) > 8) {
                if (isPlaying) {
                    isPlaying = false;
                    playBtn.innerHTML = '<span class="icon">▶</span> PLAY TOUR';
                    playBtn.classList.remove('active');
                }
                // Ocultar hint después del primer scroll
                scrollHint.style.opacity = '0';
                lastScrollY = window.scrollY;
                
                // Evitamos pausas automáticas bruscas si el usuario scrolló manualmente
                const progress = (window.scrollY + virtualScroll) * SCROLL_SPEED;
                lastPausedIndex = Math.floor(progress / SPACING);
            }
        };

        window.addEventListener('scroll', onScroll);

        // ── Partículas (Estrellas 3D radiales) ──────────────
        const ctx = canvas.getContext('2d')!;
        const particles: { x: number; y: number; z: number; size: number; speed: number }[] = [];

        const initParticles = () => {
            particles.length = 0;
            for (let i = 0; i < 180; i++) {
                particles.push({
                    x:     (Math.random() - 0.5) * canvas.width * 2,
                    y:     (Math.random() - 0.5) * canvas.height * 2,
                    z:     Math.random() * 1000,
                    size:  Math.random() * 1.5 + 0.5,
                    speed: Math.random() * 2 + 1,
                });
            }
        };

        const onResize = () => {
            canvas.width  = window.innerWidth;
            canvas.height = window.innerHeight;
            initParticles();
        };
        window.addEventListener('resize', onResize);
        onResize();

        // Limpiar event listeners globales al destruir la vista
        document.addEventListener('astro:before-preparation', () => {
            window.removeEventListener('resize', onResize);
            window.removeEventListener('scroll', onScroll);
        }, { once: true });

        // ── Loop principal ─────────────────────────────────
        function animate() {
            // Avance en auto-tour con pausas en cada obra
            if (isPlaying) {
                if (pauseCounter > 0) {
                    pauseCounter--;
                    // Avance mínimo residual para no congelar del todo la UI (efecto premium de deriva)
                    virtualScroll += AUTO_SPEED * 0.08;
                } else {
                    virtualScroll += AUTO_SPEED;

                    const progress = (window.scrollY + virtualScroll) * SCROLL_SPEED;
                    // Detectar proximidad de la siguiente obra
                    const nextArtworkIndex = Math.floor((progress + 150) / SPACING);
                    if (nextArtworkIndex >= 0 && nextArtworkIndex < artworks.length) {
                        if (nextArtworkIndex > lastPausedIndex) {
                            const targetZ = (nextArtworkIndex + 1) * SPACING;
                            if (progress >= targetZ - 30 && progress <= targetZ + 30) {
                                pauseCounter = 120; // 120 frames ≈ 2 segundos a 60fps
                                lastPausedIndex = nextArtworkIndex;
                            }
                        }
                    }
                }
            }

            // Progreso total de la "cámara"
            const progress = (window.scrollY + virtualScroll) * SCROLL_SPEED;

            // Actualizar profundidad en UI
            depthVal.innerText = Math.floor(progress / 10).toString();

            // ── Mover el TÚNEL entero hacia la cámara ──
            tunnel.style.transform = `translateZ(${progress}px)`;

            // 1. Leer todas las alturas en lote primero para evitar Layout Thrashing
            const heights = Array.from(frames).map(frame => frame.offsetHeight);

            // 2. Aplicar estilos, opacidad y centrado vertical exacto en píxeles
            frames.forEach((frame, idx) => {
                const x   = parseFloat(frame.dataset.x ?? '0');
                const y   = parseFloat(frame.dataset.y ?? '0');
                const z   = parseFloat(frame.dataset.z ?? '0');
                const height = heights[idx] || 0;

                // Z relativo a la cámara actual
                const relZ = z + progress;

                // Modificado para mantener la imagen en muestra durante más recorrido/tiempo
                let opacity: number;
                if (relZ > 650) {
                    opacity = 0; // ya pasó del todo y sale del campo de visión
                } else if (relZ > 200) {
                    opacity = 1 - (relZ - 200) / 450; // fade out al rebasar el visor
                } else if (relZ > -SPACING * 2) {
                    opacity = 1; // totalmente visible
                } else {
                    // fade in inicial desde la distancia
                    opacity = Math.max(0, 1 + (relZ + SPACING * 2) / SPACING);
                }

                frame.style.opacity = opacity.toFixed(3);

                // Elevación dinámica al acercarse (sube en el eje Y para imponer presencia)
                let elevation = 0;
                if (relZ > -900) {
                    const t = Math.min(1, Math.max(0, (relZ + 900) / 1200));
                    const easeOutQuad = t * (2 - t);
                    elevation = -90 * easeOutQuad; // Sube hasta 90px
                }

                const targetY = y + elevation;
                // Centrado exacto basado en la altura física del elemento (obras horizontales y verticales)
                const centerYOffset = -height / 2 + targetY;
                frame.style.transform = `translate3d(-50%, ${centerYOffset.toFixed(1)}px, 0) translate3d(${x}px, 0px, ${z}px)`;
            });

            // ── Partículas (Estrellas 3D radiales) ──────────
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            const cx = canvas.width / 2;
            const cy = canvas.height / 2;
            const focalLength = 300;
            const extra = isPlaying ? 5 : 0.8;

            for (const p of particles) {
                p.z -= p.speed + extra;
                
                // Si pasa la cámara, reiniciarla al fondo (Z=1000)
                if (p.z <= 0) {
                    p.z = 1000;
                    p.x = (Math.random() - 0.5) * canvas.width * 2;
                    p.y = (Math.random() - 0.5) * canvas.height * 2;
                }

                // Proyección 3D a coordenadas 2D en pantalla
                const px = cx + (p.x / p.z) * focalLength;
                const py = cy + (p.y / p.z) * focalLength;
                const psize = p.size * (focalLength / p.z);

                // Variar opacidad según la profundidad
                let alpha = 1 - p.z / 1000;
                if (p.z < 100) {
                    alpha = p.z / 100; // Desvanecer suavemente antes de pasar los límites de la pantalla
                }

                if (px >= 0 && px <= canvas.width && py >= 0 && py <= canvas.height) {
                    ctx.beginPath();
                    ctx.fillStyle = `rgba(255, 255, 255, ${alpha.toFixed(2)})`;
                    ctx.arc(px, py, Math.max(0.1, psize), 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            requestAnimationFrame(animate);
        }

        animate();
    });
</script>
