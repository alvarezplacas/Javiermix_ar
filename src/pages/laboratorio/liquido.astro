        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    /* 🖥️ Escenario de Render */
    .webgl-stage {
        flex: 1;
        height: 100%;
        position: relative;
        background: #060606;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .light-table-grid {
        position: absolute;
        inset: 0;
        opacity: 0.03;
