    }

    .progress-bar {
        width: 100%;
        height: 2px;
        background: rgba(255, 255, 255, 0.05);
    }

    .progress-fill {
        width: 0%;
        height: 100%;
        background: var(--jmx-gold);
        box-shadow: 0 0 10px var(--jmx-gold);
