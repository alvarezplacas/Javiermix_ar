    }

    /* Sliders de Parámetros */
    .engine-settings {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 1rem;
    }

    .sheet-title {
        font-size: 0.55rem;
        font-weight: 900;
        color: var(--jmx-gold);
        letter-spacing: 2px;
        margin-bottom: 0.1rem;
    }

    .slider-item {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .slider-header {
        display: flex;
        justify-content: space-between;
        font-size: 0.55rem;
