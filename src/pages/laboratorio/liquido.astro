        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        padding: 2rem 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        background: linear-gradient(to bottom, rgba(6, 6, 6, 0.9) 0%, transparent 100%);
        pointer-events: none;
    }

    .shatter-nav * {
        pointer-events: auto;
    }

    .back-link {
        color: #fff;
        text-decoration: none;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 3px;
        opacity: 0.5;
        transition: var(--transition-jmx);
    }
    .back-link:hover {
        opacity: 1;
        color: var(--jmx-gold);
    }

    .shatter-badge {
        font-size: 0.55rem;
        font-weight: 900;
        letter-spacing: 2px;
        color: var(--jmx-gold);
