        outline: none;
        cursor: pointer;
        transition: var(--transition-jmx);
    }

    .jmx-select:hover, .jmx-select:focus {
        border-color: var(--jmx-gold);
        background: rgba(220, 177, 74, 0.05);
    }

    .jmx-select option {
