---
import Layout from '../../layouts/Layout.astro';
import { getCatalogoFiles, getAssetUrl } from '../../conexion/directus';

let files = [];
try {
    files = await getCatalogoFiles();
} catch (e) {
    console.error("[Liquido Page] Error al cargar archivos de Directus:", e);
}

// Filtrar principales (excluyendo variantes _2)
const mainFiles = files.filter((f: any) => !f.filename_download?.toLowerCase().includes('_2')) || [];

// Agrupar archivos por nombre de serie
const seriesMap: Record<string, any[]> = {};
mainFiles.forEach((file: any) => {
    const sName = file.serie_name || 'General';
    if (!seriesMap[sName]) seriesMap[sName] = [];
    seriesMap[sName].push({
        id: file.id,
        title: file.title || file.filename_download.split('.')[0] || 'Obra sin título',
        src: getAssetUrl(file.id, { width: 1600, format: 'webp', quality: 90 }),
        thumb: getAssetUrl(file.id, { width: 400, format: 'webp', quality: 70 }),
        metadata: {
            size: file.filesize ? (file.filesize / 1024 / 1024).toFixed(2) + ' MB' : 'N/A',
            dim: file.width && file.height ? `${file.width} x ${file.height}px` : 'Resolución Variable',
            date: file.uploaded_on ? new Date(file.uploaded_on).toLocaleDateString('es-AR') : 'N/A'
        }
    });
});

// Fallback por si Directus no tiene datos
const fallbackSeries = {
    'Serie Demostración JMX': [
        {
            id: 'demo1',
            title: 'Rescate de Plata I',
            src: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=1600&q=90',
            thumb: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=400&q=70',
            metadata: { size: '1.24 MB', dim: '3000 x 4000px', date: '04/06/2026' }
        },
        {
            id: 'demo2',
            title: 'Líneas de Paso II',
            src: 'https://images.unsplash.com/photo-1579783928621-7a13d66a62d1?w=1600&q=90',
            thumb: 'https://images.unsplash.com/photo-1579783928621-7a13d66a62d1?w=400&q=70',
            metadata: { size: '2.10 MB', dim: '3500 x 5000px', date: '04/06/2026' }
        },
        {
            id: 'demo3',
            title: 'Texturas de Mármol III',
            src: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1600&q=90',
            thumb: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400&q=70',
            metadata: { size: '1.85 MB', dim: '4000 x 4000px', date: '04/06/2026' }
        }
    ]
};

if (Object.keys(seriesMap).length === 0) {
    Object.assign(seriesMap, fallbackSeries);
}

const seriesNames = Object.keys(seriesMap);
---

<Layout title="Lienzo Derretido 3D | Laboratorio JMX" themeForce="dark">
    <main class="shatter-container">
        <div class="shatter-layout">
            <!-- Columna Izquierda: Escenario WebGL -->
            <div class="webgl-stage">
                <!-- Navegación superior dentro de la stage -->
                <nav class="shatter-nav">
                    <a href="/laboratorio" class="back-link">← VOLVER AL GABINETE</a>
                    <div class="shatter-badge">PROTOCOLO: LIENZO DERRETIDO 3D</div>
                </nav>

                <div class="light-table-grid"></div>
                <div id="canvas-container" class="canvas-mount"></div>
                <div class="interaction-hint">
                    <span class="hint-click">DESLIZA EL MOUSE PARA DERRETIR LA OBRA</span>
                </div>
            </div>

            <!-- Columna Derecha: Control de Datos Collapsible (Estilo Photoshop) -->
            <aside class="sidebar-panel" id="sidebar">
                <!-- Contenedor expandido -->
                <div class="sidebar-expanded-content">
                    <div class="sidebar-header-bar">
                        <span class="panel-header-title">PROPIEDADES // FLUIDO</span>
                        <button id="sidebar-collapse-btn" class="panel-action-btn" aria-label="Colapsar panel">
                            <span class="btn-icon">»</span>
                        </button>
                    </div>

                    <div class="sidebar-inner">
                        <!-- Selector de Series -->
                        <div class="control-group">
                            <label for="series-select">COLECCIÓN FOTOGRÁFICA</label>
                            <select id="series-select" class="jmx-select">
                                {seriesNames.map(name => (
                                    <option value={name}>{name.toUpperCase()}</option>
                                ))}
                            </select>
                        </div>

                        <!-- Selector de Viscosidad -->
                        <div class="control-group">
                            <label for="viscosity-select">VISCOSIDAD DEL FLUIDO</label>
                            <select id="viscosity-select" class="jmx-select">
                                <option value="0.2">ACEITE VISCOSO (LENTO)</option>
                                <option value="0.5" selected>ÓLEO INTERMEDIO</option>
                                <option value="0.9">AGUA DE HALUROS (RÁPIDO)</option>
                            </select>
                        </div>

                        <!-- Selector de Color de Luz Térmica -->
                        <div class="control-group">
                            <label for="light-color-select">COLOR DE LUZ CURSOR</label>
                            <select id="light-color-select" class="jmx-select">
                                <option value="gold">ORO TÉRMICO (#DCB14A)</option>
                                <option value="cyan">CIAN CRIOGÉNICO (#00FFFF)</option>
                                <option value="crimson">MAGMA VELVET (#FF0055)</option>
                                <option value="white">BLANCO NEUTRO (#FFFFFF)</option>
                            </select>
                        </div>

                        <!-- Configuración del Motor (Slider Físico) -->
                        <div class="engine-settings">
                            <div class="sheet-title">PARÁMETROS DE DERRETIMIENTO //</div>
                            
                            <div class="slider-item">
                                <div class="slider-header">
                                    <span>VELOCIDAD DE DERRAME (GRAVEDAD)</span>
                                    <span id="val-flow">1.5</span>
                                </div>
                                <input type="range" id="param-flow" min="0.2" max="4.0" step="0.1" value="1.5" class="jmx-slider" />
                            </div>

                            <div class="slider-item">
                                <div class="slider-header">
                                    <span>GROSOR DEL ÓLEO (RELIEVE 3D)</span>
                                    <span id="val-relief">0.6</span>
                                </div>
                                <input type="range" id="param-relief" min="0.1" max="1.5" step="0.05" value="0.6" class="jmx-slider" />
                            </div>
                        </div>

                        <!-- Estado de la secuencia -->
                        <div class="sequence-tracker">
                            <div class="progress-bar">
                                <div id="progress-indicator" class="progress-fill"></div>
                            </div>
                            <div class="tracker-text">
                                <span>SECUENCIA DE LIENZO</span>
                                <span id="tracker-count">01 / 01</span>
                            </div>
                        </div>

                        <!-- Mini Footer Explicativo Retraído abajo -->
                        <footer class="sidebar-mini-footer">
                            <div class="mini-title">EXP-08 // DERRETIMIENTO VISCOSO</div>
                            <p class="mini-desc">Simulación termodinámica de emulsión fotográfica. Al rozar el mouse, el lienzo se funde en un gel espeso 3D calculado por normales con brillos especulares.</p>
                        </footer>
                    </div>
                </div>

                <!-- Contenedor colapsado (Estilo Photoshop Strip) -->
                <div class="sidebar-collapsed-strip">
                    <button id="sidebar-expand-btn" class="panel-action-btn" aria-label="Expandir panel">
                        <span class="btn-icon">«</span>
                    </button>
                    
                    <div class="collapsed-icons">
                        <!-- Iconos de Photoshop sutiles de color oro JMX -->
                        <div class="collapsed-icon-item" title="Colección Fotográfica">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--jmx-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                        </div>
                        <div class="collapsed-icon-item" title="Viscosidad del Fluido">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                        <div class="collapsed-icon-item" title="Luz de Calor">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="5"></circle>
                                <line x1="12" y1="1" x2="12" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="23"></line>
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                <line x1="1" y1="12" x2="3" y2="12"></line>
                                <line x1="21" y1="12" x2="23" y2="12"></line>
                                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                            </svg>
                        </div>
                    </div>

                    <div class="collapsed-vertical-title">
                        <span>ÓLEO LÍQUIDO 3D</span>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <!-- Datos Serializados para el Cliente -->
    <div id="series-data" data-series={JSON.stringify(seriesMap)} style="display: none;"></div>
</Layout>

<style>
