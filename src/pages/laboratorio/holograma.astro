    .holo-paspartu {
        position: absolute;
        inset: 0;
        background: #0a0a0a;
        z-index: 1;
    }

    .holo-layer {
        position: absolute;
        display: block;
        pointer-events: none;
    }

    /* Imagen Principal - Ajuste Contain para evitar recortes */
    .bg-layer {
        inset: 24px;
        width: calc(100% - 48px);
        height: calc(100% - 48px);
        object-fit: contain;
        z-index: 2;
        transform: translateZ(15px) scale(0.96);
        border: 1px solid rgba(255,255,255,0.02);
    }

    /* Cristal */
    .reflection-layer {
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 10;
        background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%, rgba(255,255,255,0.08) 100%);
        mix-blend-mode: overlay;
        transform: translateZ(30px);
