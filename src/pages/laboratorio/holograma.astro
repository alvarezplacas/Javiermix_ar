---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\laboratorio\holograma.astro
import Layout from '@layouts/Layout.astro';
---

<Layout title="Holograma de Profundidad 3D | Laboratorio JMX" themeForce="dark">
    <main class="lab-coming-soon">
        <div class="grid-overlay"></div>
        <div class="glow-orb"></div>

        <section class="panel-box">
            <div class="panel-header">
                <span class="badge">EXP-10 // EN DISEÑO</span>
                <div class="status-indicator">
                    <span class="pulse-dot"></span>
                    CALIBRANDO PARALLAX
                </div>
            </div>

            <div class="panel-content">
                <h1>Holograma de Profundidad <br/><span>Volumen 3D</span></h1>
                <p class="summary">
                    Una experiencia inmersiva que dota a las fotografías Fine Art de relieve volumétrico interactivo.
                </p>

                <div class="blueprint">
                    <div class="blueprint-line"><span>PROTOCOLO:</span> Desplazamiento de píxeles interactivo mediante textura de mapa de profundidad.</div>
                    <div class="blueprint-line"><span>MECÁNICA:</span> Perspectiva tridimensional que reacciona al giroscopio (en móviles) o al mouse (en escritorio).</div>
                    <div class="blueprint-line"><span>TECNOLOGÍA:</span> WebGL + Three.js + Custom Shaders (Displacement Mapping).</div>
                </div>

                <div class="status-meter">
                    <div class="meter-label">
                        <span>PROGRESO DE DISEÑO</span>
                        <span>25%</span>
                    </div>
                    <div class="meter-bar">
                        <div class="meter-fill" style="width: 25%"></div>
                    </div>
                </div>
            </div>

            <footer class="panel-footer">
                <a href="/laboratorio" class="btn-back">
                    <span class="arrow">←</span> RETORNAR AL GABINETE
                </a>
            </footer>
        </section>
    </main>
</Layout>

<style>
    .lab-coming-soon {
        background: #030303;
        color: #fff;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        font-family: 'Inter', system-ui, sans-serif;
        overflow: hidden;
        padding: 2rem;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(220, 177, 74, 0.02) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(220, 177, 74, 0.02) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
        z-index: 1;
    }

    .glow-orb {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(220, 177, 74, 0.05) 0%, transparent 70%);
        pointer-events: none;
        z-index: 2;
        filter: blur(50px);
    }

    .panel-box {
        max-width: 600px;
        width: 100%;
        background: rgba(15, 15, 15, 0.65);
        border: 1px solid rgba(220, 177, 74, 0.15);
        backdrop-filter: blur(30px);
        border-radius: 4px;
        padding: 3rem;
        position: relative;
        z-index: 10;
        box-shadow: 0 40px 100px rgba(0,0,0,0.8);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding-bottom: 1rem;
    }

    .badge {
        font-size: 0.55rem;
        font-weight: 900;
        color: #dcb14a;
        letter-spacing: 2px;
        border: 1px solid rgba(220, 177, 74, 0.3);
        padding: 0.3rem 0.8rem;
    }

    .status-indicator {
        font-family: monospace;
        font-size: 0.55rem;
        color: rgba(255,255,255,0.4);
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background: #dcb14a;
        border-radius: 50%;
        box-shadow: 0 0 8px #dcb14a;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.5); opacity: 0.4; }
        100% { transform: scale(1); opacity: 1; }
    }

    h1 {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.1;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    h1 span {
        color: #dcb14a;
        font-size: 0.7em;
        font-style: italic;
    }

    .summary {
        color: rgba(255,255,255,0.5);
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 2.5rem;
        font-weight: 300;
    }

    .blueprint {
        background: rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.03);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    .blueprint-line {
        font-size: 0.7rem;
        line-height: 1.4;
        color: rgba(255,255,255,0.7);
    }

    .blueprint-line span {
        color: #dcb14a;
        font-weight: 700;
        margin-right: 8px;
    }

    .status-meter {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .meter-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.55rem;
        font-weight: 800;
        color: rgba(255,255,255,0.4);
        letter-spacing: 1.5px;
    }

    .meter-bar {
        width: 100%;
        height: 2px;
        background: rgba(255,255,255,0.05);
    }

    .meter-fill {
        height: 100%;
        background: #dcb14a;
        box-shadow: 0 0 8px #dcb14a;
    }

    .panel-footer {
        margin-top: 3.5rem;
        border-top: 1px solid rgba(255,255,255,0.05);
        padding-top: 2rem;
        text-align: center;
    }

    .btn-back {
        color: rgba(255,255,255,0.4);
        text-decoration: none;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 3px;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        color: #dcb14a;
    }

    .arrow {
        display: inline-block;
        transition: transform 0.3s ease;
    }

    .btn-back:hover .arrow {
        transform: translateX(-5px);
    }
</style>
