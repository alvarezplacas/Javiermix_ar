        padding-top: 0.5rem;
    }

    .gold-spec { color: var(--holo-accent); }

    .stage-hint {
        position: absolute;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.55rem;
        letter-spacing: 2px;
        color: rgba(255,255,255,0.25);
        font-weight: 700;
