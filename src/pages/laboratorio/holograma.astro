        .holo-stage { perspective: 800px; }
        .holo-wrapper { width: 85vw; height: 64vw; }
        .holo-tag { bottom: -30px; right: 0; left: 0; margin: 0 auto; width: 80%; }
        .bg-layer { inset: 16px; width: calc(100% - 32px); height: calc(100% - 32px); }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const wrapper = document.getElementById('holo-wrapper');
        const card = document.getElementById('holo-card');
        const shadow = document.getElementById('holo-shadow');
        const tag = document.getElementById('holo-tag');
        const reflection = document.getElementById('holo-reflection');
        const sensorText = document.getElementById('sensor-text');

        const holoImg = document.getElementById('holo-img') as HTMLImageElement;
        const tagTitle = document.getElementById('holo-tag-title');
        const tagSerie = document.getElementById('holo-tag-serie');
        const container = document.querySelector('.holo-container');
        const serieSelect = document.getElementById('serie-select') as HTMLSelectElement;
        const thumbStrip = document.getElementById('thumb-strip');

        if (!wrapper || !card || !shadow || !tag || !reflection || !container) return;

        let artworksData: any[] = [];
        try {
            artworksData = JSON.parse(container.getAttribute('data-artworks') || '[]');
        } catch (e) {
            console.error("Error al parsear obras en script de holograma:", e);
        }

        let lastX = 0;
        let lastY = 0;
        let targetX = 0;
        let targetY = 0;

        // Escuchar el movimiento del mouse
        window.addEventListener('mousemove', (e) => {
            const cx = window.innerWidth / 2;
            const cy = window.innerHeight / 2;
            targetX = (e.clientX - cx) / cx;
            targetY = (e.clientY - cy) / cy;
        });

        // Suavizado (Lerp) para movimiento cinemático fluido
        function updateParallax() {
            lastX += (targetX - lastX) * 0.1;
            lastY += (targetY - lastY) * 0.1;

            const rotateX = -lastY * 25; 
            const rotateY = lastX * 30;  

            wrapper.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg)`;
            
            const shadowX = -lastX * 45;
            const shadowY = -lastY * 30;
            shadow.style.transform = `translate3d(${shadowX.toFixed(1)}px, ${shadowY.toFixed(1)}px, -80px)`;

            const refX = -lastX * 35;
            const refY = -lastY * 35;
            reflection.style.backgroundPosition = `${(50 + refX).toFixed(1)}% ${(50 + refY).toFixed(1)}%`;

            if (sensorText) {
                const ratio = Math.sqrt(lastX * lastX + lastY * lastY);
                sensorText.innerText = `RATIO PARALLAX: ${(1.0 + ratio).toFixed(2)}`;
            }

            requestAnimationFrame(updateParallax);
        }

        updateParallax();

        // Soporte para Giroscopio de dispositivo móvil (DeviceOrientation)
        if (window.DeviceOrientationEvent) {
            window.addEventListener('deviceorientation', (e) => {
                if (e.beta !== null && e.gamma !== null) {
                    targetX = Math.min(1.0, Math.max(-1.0, e.gamma / 45));
                    targetY = Math.min(1.0, Math.max(-1.0, (e.beta - 45) / 45));
                }
            });
        }

        // Configurar botones de cambio de pared
        const wallBtns = document.querySelectorAll('[data-wall]');
        wallBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const wallType = btn.getAttribute('data-wall') || 'dark';
                
                document.querySelectorAll('[data-wall]').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                container.setAttribute('data-wall', wallType);
            });
        });

        // Vincular los eventos de clic en las miniaturas
        function bindThumbEvents() {
            const thumbBtns = document.querySelectorAll('.thumb-btn');
            thumbBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    thumbBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    
                    const img = btn.getAttribute('data-img') || '';
                    const title = btn.getAttribute('data-title') || '';
                    const serie = btn.getAttribute('data-serie') || '';

                    if (holoImg) holoImg.src = img;
                    if (tagTitle) tagTitle.innerText = title;
                    if (tagSerie) tagSerie.innerText = serie.toUpperCase();
                });
            });
        }

        // Inicializar clics de miniaturas iniciales
        bindThumbEvents();

        // Cambiar serie de fotos y recargar miniaturas correspondientes
        serieSelect?.addEventListener('change', (e) => {
            const selectedSerie = (e.target as HTMLSelectElement).value;
            const filtered = artworksData.filter((art: any) => art.serie === selectedSerie);
            
            if (!thumbStrip) return;
            thumbStrip.innerHTML = '';
            
            filtered.forEach((art: any, idx: number) => {
                const btn = document.createElement('button');
                btn.className = `thumb-btn ${idx === 0 ? 'active' : ''}`;
                btn.setAttribute('data-index', idx.toString());
                btn.setAttribute('data-img', art.img);
                btn.setAttribute('data-title', art.title);
                btn.setAttribute('data-serie', art.serie);
                
                const img = document.createElement('img');
                img.src = art.thumb;
                img.alt = art.title;
                
                const span = document.createElement('span');
                span.className = 'thumb-title';
                span.innerText = art.title;
                
                btn.appendChild(img);
                btn.appendChild(span);
                
                thumbStrip.appendChild(btn);
            });
            
            // Re-vincular eventos a las nuevas miniaturas
            bindThumbEvents();
            
            // Cargar automáticamente la primera obra de la serie seleccionada
            if (filtered.length > 0) {
                if (holoImg) holoImg.src = filtered[0].img;
                if (tagTitle) tagTitle.innerText = filtered[0].title;
                if (tagSerie) tagSerie.innerText = filtered[0].serie.toUpperCase();
            }
        });
    });
</script>
