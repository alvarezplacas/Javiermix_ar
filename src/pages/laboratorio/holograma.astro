    }

    .holo-nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        padding: 1.5rem 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(to bottom, rgba(3,3,3,0.95) 60%, transparent);
