    }

    .thumb-strip {
        display: flex;
        gap: 1.2rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(255,255,255,0.1) transparent;
    }

    .thumb-btn {
        background: #060606;
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.4rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
