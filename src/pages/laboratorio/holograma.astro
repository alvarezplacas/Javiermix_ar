        letter-spacing: 2px;
        color: var(--holo-accent);
        font-weight: 800;
        display: block;
        margin-bottom: 0.3rem;
    }

    /* Título reducido a demanda del autor */
    .holo-tag h3 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
        color: #fff;
        line-height: 1.25;
        letter-spacing: 0.5px;
    }

    .tag-footer {
        display: flex;
        justify-content: space-between;
        font-size: 0.45rem;
        font-weight: 900;
        letter-spacing: 1.2px;
        color: rgba(255,255,255,0.35);
