---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\laboratorio\holograma.astro
import Layout from '@layouts/Layout.astro';
import { getCatalogoFiles } from '@conexion/directus';
import { getOptimizedImageURL } from '@utils/media';

export const prerender = false;

let artworks = [];
try {
    const artworksRaw = await getCatalogoFiles();
    artworks = artworksRaw
        .filter(file => file.id && !file.filename_download.toLowerCase().includes('_2'))
        .map((file, index) => ({
            id: file.id,
            title: file.title || `Obra ${index + 1}`,
            img: getOptimizedImageURL(file.id, { width: 1200, format: 'webp', quality: 90 }),
            thumb: getOptimizedImageURL(file.id, { width: 300, format: 'webp', quality: 70 }),
            serie: file.serie_name || 'Archivo General',
        }));
} catch (e) {
    console.error("Error al cargar catálogo en holograma:", e);
}

// Fallback por si falla la base de datos
if (artworks.length === 0) {
    artworks = [
        {
            id: 'demo1',
            title: 'Obra de Prueba JMX I',
            img: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=1200&q=90',
            thumb: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=300&q=70',
            serie: 'Serie Prueba'
        },
        {
            id: 'demo2',
            title: 'Obra de Prueba JMX II',
            img: 'https://images.unsplash.com/photo-1579783928621-7a13d66a62d1?w=1200&q=90',
            thumb: 'https://images.unsplash.com/photo-1579783928621-7a13d66a62d1?w=300&q=70',
            serie: 'Serie Prueba'
        }
    ];
}

const seriesList = [...new Set(artworks.map(a => a.serie))];
const defaultSerie = seriesList[0] || '';
const initialArtworks = artworks.filter(art => art.serie === defaultSerie);
---

<Layout title="Holograma de Profundidad 3D | Laboratorio JMX" themeForce="dark">
    <main class="holo-container" data-artworks={JSON.stringify(artworks)} data-wall="dark">
        <!-- Grilla de laboratorio -->
        <div class="grid-overlay"></div>
        <div class="glow-orb"></div>

        <!-- Navegación superior -->
        <nav class="holo-nav">
            <a href="/laboratorio" class="back-link">← GABINETE</a>
            <div class="holo-title">PROTOCOLO EXP-10: HOLOGRAMA PARALLAX 3D</div>
            <div class="sensor-status">
                <span class="status-dot"></span>
                <span id="sensor-text">RATIO PARALLAX: 1.0</span>
            </div>
        </nav>

        <!-- Layout split: Escenario y Sidebar -->
        <div class="framer-layout">
            <!-- Escenario de Visualización Holográfica -->
            <div class="holo-stage">
                <div class="holo-wrapper" id="holo-wrapper">
                    <!-- Sombra proyectada detrás -->
                    <div class="holo-shadow" id="holo-shadow"></div>
                    
                    <!-- El Marco del Holograma que rota en 3D -->
                    <div class="holo-card" id="holo-card">
                        <!-- Textura de fondo paspartú -->
                        <div class="holo-paspartu"></div>
                        
                        <!-- Imagen Base (Capa de Fondo) -->
                        <img id="holo-img" src={initialArtworks[0]?.img || artworks[0]?.img} alt={initialArtworks[0]?.title || artworks[0]?.title} class="holo-layer bg-layer" />
                        
                        <!-- Capa de Brillo/Reflejo de Cristal de Museo (Capa Superior) -->
                        <div class="holo-layer reflection-layer" id="holo-reflection"></div>
                        
                        <!-- Marco Físico Tridimensional virtual -->
                        <div class="holo-bezel"></div>
                    </div>

                    <!-- Ficha de Datos que flota delante (Parallax extra) -->
                    <div class="holo-tag" id="holo-tag">
                        <span id="holo-tag-serie">{(initialArtworks[0]?.serie || artworks[0]?.serie).toUpperCase()}</span>
                        <h3 id="holo-tag-title">{initialArtworks[0]?.title || artworks[0]?.title}</h3>
                        <div class="tag-footer">
                            <span>ESTÁNDAR FINE-ART</span>
                            <span class="gold-spec">JMX 2026</span>
                        </div>
                    </div>
                </div>

                <!-- Hint de interacción -->
                <div class="stage-hint">
                    <span>MUEVE EL CURSOR O INCLINA EL MÓVIL PARA VER LA TRIDIMENSIONALIDAD</span>
                </div>
            </div>

            <!-- Panel de Ajustes Derecho (Photoshop Style) -->
            <aside class="holo-sidebar">
                <div class="sidebar-header">
                    <h3>CONFIGURACIÓN DE ENTORNOS</h3>
                </div>
                <div class="sidebar-content">
                    <!-- 1. Selección de Serie -->
                    <div class="control-section">
                        <label>SERIE DE FOTOGRAFÍAS</label>
                        <select id="serie-select" class="jmx-select">
                            {seriesList.map(serie => (
                                <option value={serie} selected={serie === defaultSerie}>{serie.toUpperCase()}</option>
                            ))}
                        </select>
                    </div>

                    <!-- 2. Textura/Color de Pared -->
                    <div class="control-section">
                        <label>TEXTURA / COLOR DE PARED</label>
                        <div class="options-grid">
                            <button class="option-btn active" data-wall="dark" title="Pared Oscura de Museo">
                                <span class="color-dot" style="background: #121212; border: 1px solid #333;"></span> OSCURO
                            </button>
                            <button class="option-btn" data-wall="worn" title="Pared de Hormigón Gastado">
                                <span class="color-dot" style="background: #5c5c5c; border: 1px solid #777;"></span> GASTADO
                            </button>
                            <button class="option-btn" data-wall="burgundy" title="Terciopelo Velvet Borgoña">
                                <span class="color-dot" style="background: #3a080d; border: 1px solid #5a1017;"></span> VELVET
                            </button>
                            <button class="option-btn" data-wall="olive" title="Verde Oliva Museo">
                                <span class="color-dot" style="background: #1f2d24; border: 1px solid #2f3d34;"></span> OLIVA
                            </button>
                            <button class="option-btn" data-wall="terracotta" title="Terracota Rústica Gastada">
                                <span class="color-dot" style="background: #4e2b1f; border: 1px solid #6c3f30;"></span> TERRACOTA
                            </button>
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <!-- Selector Inferior -->
        <div class="carousel-panel">
            <span class="panel-label">SELECCIONAR OBRA PARA PROYECTAR //</span>
            <div class="thumb-strip" id="thumb-strip">
                {initialArtworks.map((art, idx) => (
                    <button class={`thumb-btn ${idx === 0 ? 'active' : ''}`} data-index={idx} data-img={art.img} data-title={art.title} data-serie={art.serie}>
                        <img src={art.thumb} alt={art.title} />
                        <span class="thumb-title">{art.title}</span>
                    </button>
                ))}
            </div>
        </div>
    </main>
</Layout>

<style>
    :root {
        --holo-accent: #dcb14a;
        --glass-border: rgba(255, 255, 255, 0.08);
    }

    .holo-container {
        min-height: 100vh;
        background: #030303;
        color: #fff;
        font-family: 'Inter', system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
        padding: 5rem 2rem 1.5rem 2rem;
        transition: background 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Muros de Fondo */
    .holo-container[data-wall="dark"] {
        background: #030303;
        background-image: radial-gradient(circle at 50% 50%, #1a1a1a 0%, #030303 100%);
    }

    .holo-container[data-wall="worn"] {
        background: radial-gradient(circle at 50% 50%, rgba(15, 15, 15, 0.8) 0%, rgba(3, 3, 3, 0.95) 100%), 
                    url('https://images.unsplash.com/photo-1590069261209-f8e9b8642343?w=1600&q=80');
        background-size: cover;
        background-position: center;
    }

    .holo-container[data-wall="burgundy"] {
        background: radial-gradient(circle at 50% 50%, rgba(35, 4, 8, 0.85) 0%, rgba(5, 0, 2, 0.97) 100%), 
                    url('https://images.unsplash.com/photo-1618220179428-22790b461013?w=1600&q=80');
        background-size: cover;
        background-position: center;
    }

    .holo-container[data-wall="olive"] {
        background: radial-gradient(circle at 50% 50%, rgba(15, 25, 18, 0.85) 0%, rgba(3, 7, 5, 0.97) 100%), 
                    url('https://images.unsplash.com/photo-1618220179428-22790b461013?w=1600&q=80');
        background-size: cover;
        background-position: center;
    }

    .holo-container[data-wall="terracotta"] {
        background: radial-gradient(circle at 50% 50%, rgba(45, 20, 15, 0.85) 0%, rgba(10, 5, 3, 0.97) 100%), 
                    url('https://images.unsplash.com/photo-1618220179428-22790b461013?w=1600&q=80');
