---
// src/pages/admin-ia.astro
// Acceso preferencial para Administrador (Javiermix.ar)
---

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiniIA - Admin Access</title>
    <!-- Incluyendo Tailwind (Asumiendo integración en el proyecto Javiermix) -->
    <style>
        body { font-family: 'Inter', sans-serif; }
        .gemini-gradient {
            background: linear-gradient(135deg, #1d4ed8 0%, #7e22ce 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="bg-[#0f0f11] text-gray-200 h-screen overflow-hidden flex">

    <!-- Sidebar / Menú Izquierdo (Minimalista) -->
    <aside class="w-16 md:w-64 bg-[#18181b] border-r border-gray-800 flex flex-col justify-between py-6 transition-all duration-300">
        <div class="px-4">
            <h1 class="text-xl font-bold tracking-tight hidden md:block"><span class="gemini-gradient">MiniIA</span> Admin</h1>
            <h1 class="text-xl font-bold tracking-tight md:hidden text-center">IA</h1>
            
            <nav class="mt-8 space-y-2">
                <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-gray-800 text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    <span class="hidden md:block">Chat Principal</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-800/50 text-gray-400 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span class="hidden md:block">Galería VPS</span>
                </a>
            </nav>
        </div>
        <div class="px-4">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold">J</div>
                <span class="hidden md:block font-medium text-sm">Javiermix Admin</span>
            </div>
        </div>
    </aside>

    <!-- Chat Area Central -->
    <main class="flex-1 flex flex-col relative bg-[#0f0f11]">
        <!-- Top bar de contexto -->
        <header class="h-14 border-b border-gray-800 flex items-center px-6 justify-between bg-[#0f0f11]/80 backdrop-blur-md z-10">
            <h2 class="text-sm font-medium text-gray-300">Asesoramiento Estilo Visual y Arquitectura</h2>
            <button id="togglePanelBtn" class="p-2 rounded-md hover:bg-gray-800 text-gray-400 transition-colors" title="Abrir Inspector">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
            </button>
        </header>

        <!-- Mensajes -->
        <div class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6 flex flex-col">
            <!-- Mensaje Usuario -->
            <div class="flex justify-end">
                <div class="bg-gray-800 text-gray-200 px-5 py-3 rounded-2xl rounded-tr-none max-w-2xl">
                    <p>Por favor, analiza la última fotografía del Torino subida al VPS.</p>
                </div>
            </div>
            <!-- Mensaje IA -->
            <div class="flex justify-start">
                <div class="flex gap-4 max-w-3xl">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 flex-shrink-0"></div>
                    <div class="bg-transparent text-gray-300 py-1">
                        <p class="leading-relaxed">He localizado la imagen en el VPS. Es una fotografía de exterior con excelente iluminación natural. El vehículo detectado es un Torino clásico. He preparado la disección semántica.</p>
                        <button class="mt-3 text-blue-400 text-sm hover:underline flex items-center gap-1" onclick="document.getElementById('rightPanel').classList.remove('translate-x-full')">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                            Ver análisis detallado y previsualización
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input Box -->
        <div class="p-4 md:p-6">
            <div class="max-w-4xl mx-auto relative">
                <textarea 
                    class="w-full bg-[#18181b] border border-gray-700 rounded-2xl pl-5 pr-14 py-4 text-gray-200 placeholder-gray-500 focus:outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none h-[60px]"
                    placeholder="Escribe instrucciones para MiniIA..."
                    rows="1"
                ></textarea>
                <button class="absolute right-4 top-1/2 -translate-y-1/2 p-2 bg-gray-700 hover:bg-gray-600 text-white rounded-xl transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </div>
    </main>

    <!-- Slide-out Right Panel (Imágenes y Metadatos) -->
    <aside id="rightPanel" class="fixed inset-y-0 right-0 w-80 md:w-96 bg-[#18181b] border-l border-gray-800 transform translate-x-full transition-transform duration-300 ease-in-out z-50 flex flex-col shadow-2xl">
        <header class="h-14 border-b border-gray-800 flex items-center px-4 justify-between bg-[#18181b]">
            <h3 class="font-medium text-gray-300">Análisis Visual</h3>
            <button id="closePanelBtn" class="p-2 hover:bg-gray-800 rounded-md text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </header>
        
        <div class="flex-1 overflow-y-auto p-4 space-y-6">
            <!-- Imagen Renderizada -->
            <div class="rounded-xl overflow-hidden border border-gray-800 bg-gray-900 aspect-video relative group">
                <div class="absolute inset-0 flex items-center justify-center text-gray-500 text-sm">
                    [Imagen desde VPS vía Tailscale]
                </div>
            </div>

            <!-- Metadatos (Ollama/DeepFace JSON) -->
            <div>
                <h4 class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-3">Extracción Semántica</h4>
                <div class="bg-[#0f0f11] rounded-xl p-4 border border-gray-800 font-mono text-xs text-green-400 overflow-x-auto">
<pre><code>{
  "estilo": "Exterior diurno, HD",
  "iluminacion": "Luz natural",
  "objetos": ["Torino", "Árboles"],
  "contexto": "Calle residencial"
}</code></pre>
                </div>
            </div>

            <!-- Datos de Rostro -->
            <div>
                <h4 class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-3">Biometría</h4>
                <div class="flex items-center gap-3 bg-gray-800/50 p-3 rounded-lg border border-gray-800">
                    <div class="w-2 h-2 rounded-full bg-red-500"></div>
                    <span class="text-sm text-gray-300">No se detectaron rostros.</span>
                </div>
            </div>
        </div>
    </aside>

    <script>
        const rightPanel = document.getElementById('rightPanel');
        const toggleBtn = document.getElementById('togglePanelBtn');
        const closeBtn = document.getElementById('closePanelBtn');

        // Toggle Right Panel
        toggleBtn?.addEventListener('click', () => {
            rightPanel?.classList.toggle('translate-x-full');
        });

        // Close Right Panel
        closeBtn?.addEventListener('click', () => {
            rightPanel?.classList.add('translate-x-full');
        });
    </script>
</body>
</html>
