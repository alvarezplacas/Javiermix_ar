---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\acceso.astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);

// Si ya está logueado, redirigir al Dashboard
if (session) {
  return Astro.redirect('/dashboard/artista');
}

export const prerender = false;
---

<Layout title="Acceso | Javier Mix" description="Ingreso al Estudio de Fotógrafos">
    <Header currentPath="/acceso" theme="dark" />
    
    <main class="login-container">
        <div class="login-box">
            <div class="login-header">
                <h2>El Estudio</h2>
                <p>Ingresa a tu portafolio y gestiona tus obras.</p>
            </div>

            <div class="login-methods">
                <button id="btn-google" class="btn-social google">
                    <i class="fab fa-google"></i> Continuar con Google
                </button>

                <div class="divider">
                    <span>O con tu correo electrónico</span>
                </div>

                <form id="login-form" class="classic-form">
                    <div class="form-group">
                        <label for="email">Correo Electrónico</label>
                        <input type="email" id="email" name="email" required placeholder="tu@correo.com" autocomplete="email" />
                    </div>
                    <div class="form-group">
                        <label for="password">Contraseña</label>
                        <input type="password" id="password" name="password" required placeholder="••••••••" autocomplete="current-password" />
                    </div>
                    
                    <div id="login-error" class="error-message" style="display: none;">
                        Credenciales incorrectas. Intenta de nuevo.
                    </div>

                    <div class="forgot-password">
                        <a href="/recuperar-clave">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="btn-submit gold-btn" id="btn-submit">
                        <span class="btn-text">INGRESAR</span>
                        <i class="fas fa-spinner fa-spin loader" style="display: none;"></i>
                    </button>
                    
                    <div class="register-prompt">
                        <p>¿No tienes una cuenta? <a href="/registro">Regístrate aquí</a></p>
                    </div>
                </form>
            </div>
        </div>
    </main>
</Layout>

<script>
    const { signIn } = await import("auth-astro/client");

    document.addEventListener('astro:page-load', () => {
        const btnGoogle = document.getElementById('btn-google');
        const loginForm = document.getElementById('login-form');
        const btnSubmit = document.getElementById('btn-submit');
        const btnText = btnSubmit?.querySelector('.btn-text') as HTMLElement;
        const loader = btnSubmit?.querySelector('.loader') as HTMLElement;
        const errorMsg = document.getElementById('login-error');

        // Login Google
        if (btnGoogle) {
            btnGoogle.addEventListener('click', () => {
                signIn('google', { callbackUrl: '/dashboard/artista' });
            });
        }

        // Login Manual
        if (loginForm) {
            loginForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = (document.getElementById('email') as HTMLInputElement).value;
                const password = (document.getElementById('password') as HTMLInputElement).value;

                if (btnSubmit) btnSubmit.setAttribute('disabled', 'true');
                if (btnText) btnText.style.display = 'none';
                if (loader) loader.style.display = 'inline-block';
                if (errorMsg) errorMsg.style.display = 'none';

                try {
                    const res = await signIn('credentials', {
                        email,
                        password,
                        redirect: false
                    });

                    if (res?.error) {
                        throw new Error(res.error);
                    }

                    // Success -> redirect
                    window.location.href = '/dashboard/artista';
                } catch (error) {
                    if (errorMsg) errorMsg.style.display = 'block';
                    if (btnSubmit) btnSubmit.removeAttribute('disabled');
                    if (btnText) btnText.style.display = 'inline-block';
                    if (loader) loader.style.display = 'none';
                }
            });
        }
    });
</script>

<style>
    .login-container {
        min-height: 100dvh;
        background-color: var(--color-onyx-deep);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6rem 2rem 2rem;
        background-image: radial-gradient(circle at center, rgba(197, 160, 89, 0.05) 0%, transparent 60%);
    }

    .login-box {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 3rem;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    }

    .login-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .login-header h2 {
        font-family: var(--font-primary);
        font-weight: 300;
        font-size: 2.5rem;
        color: var(--color-accent);
        margin-bottom: 0.5rem;
    }

    .login-header p {
        color: var(--color-travertine-light);
        opacity: 0.7;
        font-size: 0.95rem;
    }

    .btn-social {
        width: 100%;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: var(--color-onyx-soft);
        border: 1px solid var(--glass-border);
        color: var(--color-text);
        font-family: var(--font-secondary);
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-social:hover {
        background: var(--color-onyx-charcoal);
        transform: translateY(-2px);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 2rem 0;
        color: var(--color-text-muted);
        font-size: 0.8rem;
    }

    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid var(--glass-border);
    }

    .divider span {
        padding: 0 1rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--color-travertine-light);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 1px;
        font-family: var(--font-secondary);
    }

    .form-group input {
        width: 100%;
        padding: 1rem;
        background: var(--color-onyx-soft);
        border: 1px solid var(--glass-border);
        color: var(--color-text);
        font-family: var(--font-primary);
        font-size: 1rem;
        transition: border-color 0.3s ease;
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--color-accent);
    }

    .btn-submit {
        width: 100%;
        padding: 1.2rem;
        background: rgba(197, 160, 89, 0.15);
        border: 1px solid rgba(197, 160, 89, 0.3);
        color: var(--color-accent);
        font-family: var(--font-secondary);
        font-weight: 700;
        letter-spacing: 2px;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 1rem;
    }

    .btn-submit:hover:not(:disabled) {
        background: rgba(197, 160, 89, 0.3);
        border-color: var(--color-accent);
        color: white;
    }

    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .error-message {
        color: #ff4b4b;
        font-size: 0.85rem;
        text-align: center;
        margin-bottom: 1rem;
        background: rgba(255, 75, 75, 0.1);
        padding: 0.5rem;
        border: 1px solid rgba(255, 75, 75, 0.2);
    }

    @media (max-width: 768px) {
        .login-box {
            padding: 2rem;
            border-left: none;
            border-right: none;
            border-bottom: none;
        }
    }

    .forgot-password {
        text-align: right;
        margin-top: -1rem;
        margin-bottom: 1.5rem;
    }

    .forgot-password a {
        color: var(--color-travertine-light);
        font-family: var(--font-secondary);
        font-size: 0.8rem;
        text-decoration: none;
        transition: color 0.3s ease;
        opacity: 0.8;
    }

    .forgot-password a:hover {
        color: var(--color-accent);
        text-decoration: underline;
        opacity: 1;
    }

    .register-prompt {
        text-align: center;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--glass-border);
    }

    .register-prompt p {
        color: var(--color-travertine-light);
        font-family: var(--font-secondary);
        font-size: 0.9rem;
        margin: 0;
    }

    .register-prompt a {
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.3s ease;
        margin-left: 0.3rem;
    }

    .register-prompt a:hover {
        opacity: 0.8;
        text-decoration: underline;
    }
</style>
