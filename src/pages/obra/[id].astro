---
// src/pages/obra/[id].astro
import Layout from '../../layouts/Layout.astro';
import { getDirectusClient } from '../../conexion/directus';
import { readItem } from '@directus/sdk';

const { id } = Astro.params;

let artwork = null;
try {
  const client = getDirectusClient();
  artwork = await client.request(readItem('directus_files', id as string));
} catch (e) {
  console.error("Error cargando obra:", e);
}

if (!artwork) {
  return Astro.redirect('/404');
}

const imageUrl = `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${artwork.id}`;
---

<Layout title={`${artwork.title || 'Obra'} | Noir & Lux`}>
  <main class="lightbox-container">
    {/* 70% Izquierda: La Fotografía Inmersiva */}
    <div class="artwork-showcase">
      <div class="image-wrapper">
        <img 
          src={imageUrl} 
          alt={artwork.title || 'Fotografía de Noir & Lux'} 
          class="main-artwork-img"
        />
      </div>
      <button class="fullscreen-btn" aria-label="Ver en pantalla completa">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
      </button>
    </div>

    {/* 30% Derecha: Panel del Curador (Glassmorphism) */}
    <aside class="curator-sidebar">
      <header class="sidebar-header">
        <h1>{artwork.title || 'Sin Título'}</h1>
        <p class="artist-name">por JavierMix</p>
      </header>

      <div class="sidebar-scroll-area">
        <section class="rating-section">
          <h3>Valoración de la Comunidad</h3>
          <div class="stars-container">
             <p class="placeholder-text">Estrellas aquí</p>
          </div>
        </section>

        <section class="metadata-section">
          <h3>Especificaciones (EXIF)</h3>
          <ul class="exif-list">
            <li><span class="exif-label">Resolución:</span> {artwork.width}x{artwork.height} px</li>
            <li><span class="exif-label">Formato:</span> {artwork.type}</li>
            <li><span class="exif-label">Peso:</span> {(artwork.filesize / 1024 / 1024).toFixed(2)} MB</li>
          </ul>
        </section>

        <section class="comments-section">
          <h3>Crítica y Análisis</h3>
           <div class="auth-placeholder">
             <button class="login-btn">Iniciar sesión para comentar</button>
           </div>
        </section>
      </div>
    </aside>
  </main>
</Layout>

<style>
  /* Base del Lightbox */
  .lightbox-container {
    display: flex;
    height: 100vh;
    width: 100vw;
    background-color: #050505;
    color: #e0e0e0;
    overflow: hidden;
  }

  .artwork-showcase {
    flex: 7;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background: radial-gradient(circle at center, #1a1a1a 0%, #000000 100%);
    padding: 2rem;
  }

  .image-wrapper {
    position: relative;
    max-width: 100%;
    max-height: 100%;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
  }

  .main-artwork-img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 4px;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .main-artwork-img:hover {
    transform: scale(1.02);
  }

  .fullscreen-btn {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: all 0.3s ease;
  }

  .fullscreen-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .curator-sidebar {
    flex: 3;
    min-width: 350px;
    max-width: 450px;
    background: rgba(20, 20, 20, 0.65);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-left: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    box-shadow: -10px 0 30px rgba(0,0,0,0.5);
    z-index: 10;
  }

  .sidebar-header {
    padding: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-header h1 {
    font-size: 1.8rem;
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    margin: 0 0 0.5rem 0;
    letter-spacing: 1px;
  }

  .artist-name {
    color: #a0a0a0;
    font-size: 0.9rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .sidebar-scroll-area {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
  }

  .sidebar-scroll-area::-webkit-scrollbar { width: 6px; }
  .sidebar-scroll-area::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
  .sidebar-scroll-area::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
  .sidebar-scroll-area::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

  section { margin-bottom: 2.5rem; }

  h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #666;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding-bottom: 0.5rem;
  }

  .exif-list { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; color: #ccc; }
  .exif-list li { margin-bottom: 0.8rem; display: flex; justify-content: space-between; }
  .exif-label { color: #888; }

  .login-btn {
    width: 100%;
    padding: 1rem;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s;
    font-family: 'Inter', sans-serif;
    letter-spacing: 1px;
  }

  .login-btn:hover { background: white; color: black; }

  @media (max-width: 1024px) {
    .lightbox-container { flex-direction: column; overflow-y: auto; }
    .artwork-showcase { height: 60vh; flex: none; }
    .curator-sidebar { max-width: 100%; border-left: none; border-top: 1px solid rgba(255, 255, 255, 0.05); }
  }
</style>
