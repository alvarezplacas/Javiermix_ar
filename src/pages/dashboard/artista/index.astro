---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\dashboard\artista\index.astro
import ProducerLayout from '@layouts/ProducerLayout.astro';
import { getSession } from 'auth-astro/server';

export const prerender = false;

// Obtener sesión (si no hay, el layout lo redirigirá igual, pero aquí lo tenemos para el nombre)
const session = await getSession(Astro.request);
const artistName = session?.user?.name || 'Artista Anónimo';

// Mock data for initial UI
const artist = {
    name: artistName,
    upload_quota: 7,
    used_quota: 2,
    likes_received: 45
};

const recentArtworks = [
    { id: '1', title: 'Soledad Urbana', likes: 12, views: 150, date: '01/07/2026', thumb: '/img/placeholder.jpg' },
    { id: '2', title: 'Luz y Sombra', likes: 33, views: 420, date: '28/06/2026', thumb: '/img/placeholder.jpg' }
];
---

<ProducerLayout title="Mi Estudio">
    <div class="studio-header">
        <div class="welcome-text">
            <h2>Bienvenido a tu Estudio, {artist.name}</h2>
            <p>Aquí gestionas tu portafolio y tu presencia en la comunidad Noir & Lux.</p>
        </div>
        
        <div class="quick-stats">
            <div class="stat-card">
                <span class="stat-value">{artist.upload_quota - artist.used_quota}</span>
                <span class="stat-label">Espacios Libres</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">{artist.likes_received}</span>
                <span class="stat-label">Likes Totales</span>
            </div>
        </div>
    </div>

    <div class="studio-actions">
        <!-- Panel Principal para Subir Obra -->
        <div class="action-card primary-action">
            <div class="action-icon"><i class="fas fa-cloud-upload-alt"></i></div>
            <h3>Subir Nueva Obra</h3>
            <p>Tus obras se optimizan automáticamente a calidad de museo (AVIF).</p>
            
            <input type="file" id="artwork-upload" accept="image/jpeg, image/png, image/webp" style="display: none;" />
            <button class="btn-studio gold-btn" id="btn-upload">Seleccionar Archivo</button>
            <div id="upload-status" style="display: none; margin-bottom: 1rem; color: var(--c-accent); font-size: 0.9rem;">
                <i class="fas fa-spinner fa-spin"></i> Subiendo y optimizando (AVIF)...
            </div>

            <div class="quota-progress">
                <div class="progress-bar" style={`width: ${(artist.used_quota / artist.upload_quota) * 100}%`}></div>
                <span>{artist.used_quota} / {artist.upload_quota} espacios usados</span>
            </div>
        </div>

        <!-- Selector de Presentación (Laboratorio) -->
        <div class="action-card">
            <div class="action-icon"><i class="fas fa-magic"></i></div>
            <h3>Laboratorio de Presentación</h3>
            <p>Elige cómo quieres que los coleccionistas experimenten tu galería.</p>
            <select class="presentation-selector">
                <option value="masonry">Grilla Clásica (Masonry)</option>
                <option value="infinity">Infinity Gallery (Inmersiva)</option>
                <option value="fragment">Lienzo Fragmentado</option>
            </select>
            <button class="btn-studio outline-btn">Guardar Preferencia</button>
        </div>
    </div>

    <div class="recent-works-section">
        <h3>Tus Obras Recientes</h3>
        <div class="works-list">
            {recentArtworks.map(art => (
                <div class="work-row">
                    <img src={art.thumb} alt={art.title} class="work-thumb" />
                    <div class="work-info">
                        <h4>{art.title}</h4>
                        <span>Subida el {art.date}</span>
                    </div>
                    <div class="work-metrics">
                        <span><i class="fas fa-heart"></i> {art.likes}</span>
                        <span><i class="fas fa-eye"></i> {art.views}</span>
                    </div>
                    <button class="btn-icon" data-tooltip="Editar"><i class="fas fa-edit"></i></button>
                </div>
            ))}
        </div>
    </div>
</ProducerLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const fileInput = document.getElementById('artwork-upload') as HTMLInputElement;
        const btnUpload = document.getElementById('btn-upload');
        const uploadStatus = document.getElementById('upload-status');

        if (!btnUpload || !fileInput) return;

        btnUpload.addEventListener('click', () => {
            fileInput.click();
        });

        fileInput.addEventListener('change', async (e) => {
            const target = e.target as HTMLInputElement;
            if (!target.files || target.files.length === 0) return;

            const file = target.files[0];
            
            // UI Updates
            btnUpload.style.display = 'none';
            if (uploadStatus) uploadStatus.style.display = 'block';

            const formData = new FormData();
            formData.append('file', file);
            
            try {
                const response = await fetch('/api/upload', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (response.ok) {
                    alert('¡Obra subida con éxito! Tu imagen ha sido convertida a formato museo (AVIF).');
                    // Reload to update list
                    window.location.reload();
                } else {
                    alert('Error al subir: ' + (result.error || 'Inténtalo de nuevo'));
                    btnUpload.style.display = 'block';
                    if (uploadStatus) uploadStatus.style.display = 'none';
                }
            } catch (error) {
                console.error('Upload Error:', error);
                alert('Ocurrió un error inesperado al subir el archivo.');
                btnUpload.style.display = 'block';
                if (uploadStatus) uploadStatus.style.display = 'none';
            }
        });
    });
</script>

<style>
    .studio-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 3rem;
        flex-wrap: wrap;
        gap: 2rem;
    }

    .welcome-text h2 {
        font-family: var(--font-primary);
        font-size: 2.5rem;
        font-weight: 200;
        margin-bottom: 0.5rem;
    }

    .welcome-text p {
        color: var(--c-muted);
        font-size: 1.1rem;
    }

    .quick-stats {
        display: flex;
        gap: 1.5rem;
    }

    .stat-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--c-border);
        padding: 1.5rem;
        border-radius: 8px;
        min-width: 150px;
        text-align: center;
        display: flex;
        flex-direction: column;
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--c-accent);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.7rem;
        color: var(--c-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 0.5rem;
    }

    .studio-actions {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 2rem;
        margin-bottom: 4rem;
    }

    .action-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--c-border);
        padding: 2.5rem;
        border-radius: 8px;
        position: relative;
        overflow: hidden;
    }

    .primary-action {
        background: linear-gradient(135deg, rgba(20,20,20,1) 0%, rgba(30,30,30,1) 100%);
        border-color: rgba(197, 160, 89, 0.3);
    }

    .action-icon {
        font-size: 2.5rem;
        color: var(--c-accent);
        margin-bottom: 1.5rem;
        opacity: 0.8;
    }

    .action-card h3 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .action-card p {
        color: var(--c-muted);
        margin-bottom: 2rem;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .btn-studio {
        padding: 1rem 2rem;
        border-radius: 4px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s;
        width: 100%;
        margin-bottom: 1rem;
    }

    .gold-btn {
        background: var(--c-accent);
        color: #000;
        border: none;
    }

    .gold-btn:hover {
        background: #d4b572;
        transform: translateY(-2px);
    }

    .outline-btn {
        background: transparent;
        color: var(--c-text);
        border: 1px solid var(--c-border);
    }

    .outline-btn:hover {
        border-color: var(--c-accent);
        color: var(--c-accent);
    }

    .presentation-selector {
        width: 100%;
        padding: 1rem;
        background: rgba(0,0,0,0.5);
        border: 1px solid var(--c-border);
        color: var(--c-text);
        margin-bottom: 1.5rem;
        border-radius: 4px;
        font-size: 0.95rem;
        outline: none;
    }

    .presentation-selector:focus {
        border-color: var(--c-accent);
    }

    .quota-progress {
        margin-top: 1.5rem;
    }

    .progress-bar {
        height: 6px;
        background: var(--c-accent);
        border-radius: 3px;
        margin-bottom: 0.5rem;
    }

    .quota-progress span {
        font-size: 0.75rem;
        color: var(--c-muted);
    }

    .recent-works-section h3 {
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--c-border);
    }

    .works-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .work-row {
        display: flex;
        align-items: center;
        background: rgba(255,255,255,0.01);
        padding: 1rem;
        border: 1px solid var(--c-border);
        border-radius: 6px;
        gap: 1.5rem;
        transition: background 0.3s;
    }

    .work-row:hover {
        background: rgba(255,255,255,0.03);
    }

    .work-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 4px;
        opacity: 0.8;
    }

    .work-info {
        flex: 1;
    }

    .work-info h4 {
        margin: 0 0 0.3rem;
        font-size: 1rem;
    }

    .work-info span {
        font-size: 0.75rem;
        color: var(--c-muted);
    }

    .work-metrics {
        display: flex;
        gap: 1.5rem;
        color: var(--c-muted);
        font-size: 0.85rem;
    }

    .work-metrics i {
        color: var(--c-accent);
        margin-right: 0.3rem;
    }

    .btn-icon {
        background: transparent;
        border: none;
        color: var(--c-muted);
        cursor: pointer;
        padding: 0.5rem;
        transition: color 0.3s;
    }

    .btn-icon:hover {
        color: var(--c-accent);
    }

    /* MOBILE ADJUSTMENTS */
    @media (max-width: 768px) {
        .studio-actions {
            grid-template-columns: 1fr;
        }
        
        .work-row {
            flex-direction: column;
            align-items: flex-start;
            position: relative;
        }
        
        .work-thumb {
            width: 100%;
            height: 150px;
        }

        .btn-icon {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(0,0,0,0.5);
            border-radius: 4px;
        }
    }
</style>
