---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\comunidad\index.astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getOptimizedImageURL } from '@utils/media';

export const prerender = false;

// 🚀 FIX: Caché Dinámica para Cloudflare
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');

// TODO: Connect to Directus artists/community tables
// For now, we will use mock data to build the UI based on the Fstoppers analysis
const artworks = [
    { id: '1', title: 'Soledad Urbana', author: 'Ana Silva', thumb: '/img/placeholder.jpg', likes: 120, isPick: true },
    { id: '2', title: 'Luz y Sombra', author: 'Carlos Rey', thumb: '/img/placeholder.jpg', likes: 85, isPick: false },
    { id: '3', title: 'Reflejos', author: 'Marta Diaz', thumb: '/img/placeholder.jpg', likes: 45, isPick: false },
];

const photoOfTheDay = artworks.reduce((prev, current) => (prev.likes > current.likes) ? prev : current);

---

<Layout
  title="Comunidad | Javier Mix"
  description="Descubre fotógrafos emergentes y obras destacadas en la comunidad Noir & Lux."
  url="/comunidad"
>
    <Header currentPath="/comunidad" />

	<main class="gallery-clean-container">
		<!-- 🎭 HERO INMERSIVO COMUNIDAD -->
		<header class="google-hero">
            <div class="immersive-hero-bg">
                <div class="bg-layer active" style={`background-image: url('${photoOfTheDay.thumb}')`}></div>
                <div class="bg-overlay"></div>
            </div>

            <div class="hero-content">
                <h1 class="gallery-title">COMMUNITY</h1>
                <p class="hero-subtitle">El talento de nuestros artistas</p>
                <div class="search-portal-wrapper">
                    <input type="text" id="community-search-input" placeholder="Busca por autor o tema..." autocomplete="off">
                    <div class="search-mode-selector" id="search-mode-selector">
                        <button class="mode-btn active" data-mode="TRENDING">POPULARES</button>
                        <button class="mode-btn" data-mode="PICKS">SELECCIÓN JMX</button>
                        <button class="mode-btn" data-mode="RECENT">RECIENTES</button>
                    </div>
                </div>
            </div>
		</header>

        <!-- OBRA DEL DÍA (Photo of the Day) -->
        <section class="photo-of-the-day-section">
            <div class="potd-badge">🏆 OBRA DEL DÍA</div>
            <div class="potd-container">
                <div class="potd-image-wrapper">
                    <img src={photoOfTheDay.thumb} alt={photoOfTheDay.title} />
                </div>
                <div class="potd-info">
                    <h2>{photoOfTheDay.title}</h2>
                    <p>Por <strong>{photoOfTheDay.author}</strong></p>
                    <div class="likes-count">❤️ {photoOfTheDay.likes} LIKES</div>
                </div>
            </div>
        </section>

		<!-- 🏛️ CONTENIDO (Default: Obras Recientes / Resultados) -->
		<div id="content-view" class="viewport">
            <!-- GRILLA MASONRY -->
            <div id="community-grid" class="masonry-grid">
                {artworks.map((art, index) => (
                    <a href={`/comunidad/obra/${art.id}`} 
                       class="grid-item" 
                       data-tilt 
                       style={`animation-delay: ${index * 0.05}s`}>
                        <img src={art.thumb} alt={art.title} class="img-main" loading="lazy" />
                        <div class="item-overlay">
                            <span class="art-title">{art.title}</span>
                            <span class="art-serie">Por {art.author}</span>
                            <div class="community-stats">
                                <span>❤️ {art.likes}</span>
                                {art.isPick && <span class="gold-badge">🎖️ JMX PICK</span>}
                            </div>
                        </div>
                    </a>
                ))}
            </div>
		</div>

        <script id="artworks-data" type="application/json" is:inline set:html={JSON.stringify(artworks)} />
	</main>

	<Footer />
</Layout>

<style is:global>
/* 🌑 ESTILO LIMPIO Y FUNCIONAL */
.gallery-clean-container {
    background: var(--color-bg);
    color: var(--color-text);
    min-height: 100vh;
    padding-bottom: 5rem;
    font-family: 'Inter', sans-serif;
    transition: var(--transition-premium);
}

/* 🎭 ARTISTIC HERO */
.google-hero {
    position: relative;
    height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-bg);
    transition: var(--transition-premium);
}

.immersive-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1;
}

.bg-layer {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0.5;
    transition: opacity 2s cubic-bezier(0.4, 0, 0.2, 1);
}

.bg-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4), var(--color-bg));
    z-index: 2;
    transition: var(--transition-premium);
}

.hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 900px;
    padding: 0 5%;
    text-align: center;
}

.gallery-title { 
    font-size: clamp(3.5rem, 8vw, 6.5rem); 
    font-weight: 200; 
    font-family: var(--font-primary); 
    margin: 0; 
    letter-spacing: clamp(5px, 2vw, 20px); 
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0.9;
}

.hero-subtitle {
    font-family: var(--font-secondary);
    font-size: clamp(0.7rem, 1vw, 0.85rem);
    letter-spacing: 6px;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-top: 1rem;
    margin-bottom: 3.5rem;
    font-weight: 700;
}

.search-portal-wrapper {
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 50px;
    padding: 0.6rem 0.6rem 0.6rem 2.5rem;
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
}

.search-portal-wrapper:focus-within {
    background: var(--color-onyx-soft);
    border-color: var(--color-accent);
    transform: translateY(-5px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.5), 0 0 0 5px rgba(197, 160, 89, 0.1);
}

#community-search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text);
    padding: 1.2rem 0;
    font-size: 1.2rem;
    outline: none;
    font-weight: 300;
}

.search-mode-selector {
    display: flex;
    gap: 0.4rem;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.3rem;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

.mode-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    padding: 0.6rem 1.2rem;
    border-radius: 20px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: all 0.3s;
    text-transform: uppercase;
}

.mode-btn.active {
    background: var(--color-accent);
    color: #000;
    font-weight: 900;
    box-shadow: 0 5px 15px rgba(197, 160, 89, 0.3);
}

.mode-btn:hover:not(.active) {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
}

/* OBRA DEL DIA */
.photo-of-the-day-section {
    max-width: 1200px;
    margin: -5rem auto 5rem;
    position: relative;
    z-index: 15;
    padding: 0 2rem;
}

.potd-badge {
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: #000;
    padding: 0.5rem 1.5rem;
    border-radius: 30px;
    font-weight: 900;
    letter-spacing: 2px;
    font-size: 0.75rem;
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);
    z-index: 20;
}

.potd-container {
    background: var(--color-onyx-soft);
    border: 1px solid var(--glass-border);
    display: flex;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
}

.potd-image-wrapper {
    flex: 2;
    height: 400px;
}

.potd-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.potd-info {
    flex: 1;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.potd-info h2 {
    font-size: 2.5rem;
    font-family: var(--font-primary);
    margin-bottom: 0.5rem;
}

.potd-info p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
}

.likes-count {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 2px;
}

/* 🖼️ GRID MASONRY (RESPETO AL FORMATO) */
.viewport { max-width: 1800px; margin: 0 auto; padding: 0 5%; }

.masonry-grid {
    column-count: 3;
    column-gap: 2rem;
}

.grid-item {
    break-inside: avoid;
    margin-bottom: 2rem;
    display: block;
    text-decoration: none;
    position: relative;
    background: var(--color-onyx-soft);
    overflow: hidden;
    opacity: 0;
    animation: fadeInScale 0.6s cubic-bezier(0.23, 1, 0.32, 1) forwards;
}

@keyframes fadeInScale {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.grid-item img {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    display: block;
    transition: opacity 0.6s ease, transform 0.6s ease;
}

.item-overlay {
    padding: 1.5rem;
    border-top: 1px solid var(--glass-border);
}

.art-title { font-size: 0.8rem; font-weight: 700; color: var(--color-text); display: block; letter-spacing: 1px; text-transform: uppercase; }
.art-serie { font-size: 0.6rem; color: var(--color-text-muted); font-weight: 500; display: block; margin-top: 0.4rem; letter-spacing: 1px; }

.community-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text);
}

.gold-badge {
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
}

/* 📱 MOBILE */
@media (max-width: 1024px) { 
    .masonry-grid { column-count: 2; } 
    .potd-container { flex-direction: column; }
    .potd-image-wrapper { width: 100%; height: 300px; }
}

@media (max-width: 768px) { 
    .masonry-grid { column-count: 1; } 
    .search-portal-wrapper { flex-direction: column; padding: 1rem; border-radius: 20px; gap: 1rem;}
    .search-mode-selector { width: 100%; display: grid; grid-template-columns: 1fr 1fr 1fr; }
    .mode-btn { padding: 0.5rem; font-size: 0.55rem; text-align: center; }
}
</style>
