---
// src/pages/ia.astro
// Chat Exclusivo Gemini-Style Premium para Javier Móvil
// Seguridad mediante PIN de acceso.
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>MiniIA - Premium</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0b0c10;
            --surface-color: rgba(30, 31, 38, 0.7);
            --surface-border: rgba(255, 255, 255, 0.08);
            --text-primary: #f0f0f0;
            --text-secondary: #a0a5b1;
            --accent-primary: #4361ee;
            --accent-gradient: linear-gradient(135deg, #4361ee, #3a0ca3);
            --ai-bubble-bg: rgba(43, 45, 54, 0.8);
            --user-bubble-bg: var(--accent-gradient);
            --danger-color: #ef233c;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(67, 97, 238, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(114, 9, 183, 0.08) 0%, transparent 50%);
            color: var(--text-primary);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Glassmorphism Utilities */
        .glass {
            background: var(--surface-color);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--surface-border);
        }

        /* Modal Styles */
        #pinModal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(11, 12, 16, 0.85);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }

        #pinModal.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .modal-content {
            width: 90%;
            max-width: 360px;
            padding: 2.5rem 2rem;
            border-radius: 24px;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            transform: translateY(0);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        #pinModal.hidden .modal-content {
            transform: translateY(30px);
        }

        .modal-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: linear-gradient(to right, #fff, #a0a5b1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .modal-subtitle {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 2rem;
        }

        .pin-input {
            width: 100%;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--surface-border);
            border-radius: 16px;
            padding: 1rem;
            font-size: 2rem;
            letter-spacing: 0.8em;
            text-align: center;
            color: white;
            outline: none;
            margin-bottom: 1.5rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            font-family: monospace;
        }

        .pin-input:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
        }

        .btn-primary {
            width: 100%;
            background: var(--accent-gradient);
            border: none;
            border-radius: 16px;
            padding: 1.2rem;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 10px 20px -10px rgba(67, 97, 238, 0.6);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -10px rgba(67, 97, 238, 0.8);
        }
        
        .btn-primary:active {
            transform: translateY(1px);
        }

        .error-text {
            color: var(--danger-color);
            font-size: 0.85rem;
            margin-top: 1rem;
            font-weight: 500;
            display: none;
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }

        /* Header */
        header {
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--surface-border);
            z-index: 10;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .brand-icon {
            width: 28px;
            height: 28px;
            fill: var(--accent-primary);
            filter: drop-shadow(0 0 8px rgba(67, 97, 238, 0.5));
        }

        .badge {
            font-size: 0.65rem;
            background: rgba(67, 97, 238, 0.2);
            color: #7ba0ff;
            padding: 0.2rem 0.5rem;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
            border: 1px solid rgba(67, 97, 238, 0.3);
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--accent-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            border: 2px solid rgba(255,255,255,0.1);
        }

        /* Chat Area */
        main {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            scroll-behavior: smooth;
        }

        /* Hide scrollbar for Chrome, Safari and Opera */
        main::-webkit-scrollbar {
            display: none;
        }
        main {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .message-wrapper {
            display: flex;
            width: 100%;
            animation: fadeIn 0.4s ease forwards;
        }

        .message-wrapper.user {
            justify-content: flex-end;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .bubble {
            max-width: 85%;
            padding: 1rem 1.25rem;
            line-height: 1.5;
            font-size: 1.05rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            word-wrap: break-word;
        }

        .user-bubble {
            background: var(--user-bubble-bg);
            border-radius: 20px 20px 4px 20px;
            color: white;
        }

        .ia-bubble {
            background: var(--ai-bubble-bg);
            border: 1px solid var(--surface-border);
            border-radius: 20px 20px 20px 4px;
            color: var(--text-primary);
        }

        /* Typing Indicator (KITT Style) */
        .typing-indicator {
            width: 60px;
            height: 8px;
            background: #110000;
            border-radius: 4px;
            position: relative;
            overflow: hidden;
            margin: 0.5rem 0.2rem;
            border: 1px solid #330000;
        }
        .typing-indicator::after {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 20px;
            height: 100%;
            background: #ff0000;
            border-radius: 4px;
            box-shadow: 0 0 10px #ff0000, 0 0 20px #ff0000;
            animation: kitt-scan 0.7s ease-in-out infinite alternate;
        }
        @keyframes kitt-scan {
            0% { transform: translateX(0); }
            100% { transform: translateX(40px); }
        }

        /* Input Area */
        footer {
            padding: 1rem 1.5rem 1.5rem;
            background: linear-gradient(to top, var(--bg-color) 70%, transparent);
            z-index: 10;
        }

        .input-container {
            display: flex;
            align-items: flex-end;
            background: rgba(30, 31, 38, 0.9);
            border: 1px solid var(--surface-border);
            border-radius: 24px;
            padding: 0.5rem 0.5rem 0.5rem 1.25rem;
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
            transition: border-color 0.3s ease;
        }

        .input-container:focus-within {
            border-color: rgba(67, 97, 238, 0.5);
            box-shadow: 0 10px 30px -10px rgba(67, 97, 238, 0.2);
        }

        .chat-input {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text-primary);
            font-size: 1.05rem;
            font-family: inherit;
            resize: none;
            padding: 0.8rem 0;
            max-height: 120px;
            outline: none;
            line-height: 1.4;
        }

        .chat-input::placeholder {
            color: var(--text-secondary);
        }

        .send-btn {
            background: var(--accent-gradient);
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            cursor: pointer;
            margin-left: 0.5rem;
            flex-shrink: 0;
            transition: transform 0.2s, opacity 0.2s;
        }

        .send-btn:disabled {
            background: rgba(255,255,255,0.1);
            color: var(--text-secondary);
            cursor: not-allowed;
            transform: none;
        }

        .send-btn:not(:disabled):hover {
            transform: scale(1.05);
        }

        .send-btn svg {
            width: 20px;
            height: 20px;
            transform: translateX(1px) translateY(-1px);
        }
        
        .footer-status {
            text-align: center;
            font-size: 0.7rem;
            color: var(--text-secondary);
            margin-top: 0.75rem;
            opacity: 0.6;
        }
    </style>
</head>
<body>

    <!-- PIN Modal -->
    <div id="pinModal">
        <div class="modal-content glass">
            <h2 class="modal-title">MiniIA Secure</h2>
            <p class="modal-subtitle">Bóveda de acceso administrativo</p>
            
            <input type="password" id="pinInput" class="pin-input" placeholder="••••" maxlength="4" pattern="[0-9]*" inputmode="numeric" autocomplete="off">
            
            <button id="unlockBtn" class="btn-primary">
                Autenticar
            </button>
            <p id="pinError" class="error-text">PIN Incorrecto. Intenta nuevamente.</p>
        </div>
    </div>

    <!-- Header -->
    <header class="glass">
        <div class="brand">
            <svg class="brand-icon" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            MiniIA <span class="badge">Admin</span>
        </div>
        <div class="user-avatar">JM</div>
    </header>

    <!-- Chat Area -->
    <main id="chatContainer">
        <div class="message-wrapper">
            <div class="bubble ia-bubble">
                ¡Hola Javier! Sistema conectado a la red neuronal. El nuevo enrutador de modelos está activo y el diseño ha sido actualizado. ¿En qué te puedo asistir hoy?
            </div>
        </div>
    </main>

    <!-- Footer Input -->
    <footer>
        <div class="input-container">
            <textarea 
                id="promptInput" 
                class="chat-input" 
                placeholder="Pregúntale algo a MiniIA..." 
                rows="1"
            ></textarea>
            <button id="sendBtn" class="send-btn" disabled>
                <svg fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>
        </div>
        <div class="footer-status">
            Conexión Segura P2P • Procesamiento Local
        </div>
    </footer>

    <script>
        let currentPin = '';

        const pinModal = document.getElementById('pinModal');
        const pinInput = document.getElementById('pinInput');
        const unlockBtn = document.getElementById('unlockBtn');
        const pinError = document.getElementById('pinError');

        const chatContainer = document.getElementById('chatContainer');
        const promptInput = document.getElementById('promptInput');
        const sendBtn = document.getElementById('sendBtn');

        // Textarea Auto-resize
        promptInput.addEventListener('input', function() {
            this.style.height = 'auto';
            let newHeight = this.scrollHeight;
            if(newHeight > 120) newHeight = 120;
            this.style.height = newHeight + 'px';
            sendBtn.disabled = this.value.trim().length === 0;
        });

        // Authentication
        const authenticate = () => {
            if(pinInput.value === '7890') {
                currentPin = pinInput.value;
                pinModal.classList.add('hidden');
                setTimeout(() => promptInput.focus(), 400);
            } else {
                pinError.style.display = 'block';
                pinError.style.animation = 'none';
                pinError.offsetHeight; /* trigger reflow */
                pinError.style.animation = null; 
                pinInput.value = '';
                pinInput.focus();
            }
        };

        unlockBtn.addEventListener('click', authenticate);
        pinInput.addEventListener('keydown', (e) => {
            if(e.key === 'Enter') authenticate();
        });

        // Chat functionality
        const appendMessage = (role, text) => {
            const wrapper = document.createElement('div');
            wrapper.className = `message-wrapper ${role}`;
            
            const bubble = document.createElement('div');
            bubble.className = `bubble ${role === 'user' ? 'user-bubble' : 'ia-bubble'}`;
            
            if(text === '...') {
                bubble.innerHTML = `
                    <div class="typing-indicator"></div>
                `;
                bubble.id = 'loadingBubble';
            } else {
                // Simple formatting for basic markdown (bold, newlines, images, links)
                const formattedText = text
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\n/g, '<br>')
                    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" style="max-width: 100%; border-radius: 8px; margin-top: 8px; margin-bottom: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" />')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="color: #4361ee; text-decoration: underline;">$1</a>');
                bubble.innerHTML = formattedText;
            }

            wrapper.appendChild(bubble);
            chatContainer.appendChild(wrapper);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        };

        const sendMessage = async () => {
            const text = promptInput.value.trim();
            if(!text) return;

            promptInput.value = '';
            promptInput.style.height = 'auto';
            sendBtn.disabled = true;

            appendMessage('user', text);
            appendMessage('ia', '...');

            try {
                const res = await fetch('/api/ia-chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: text, pin: currentPin })
                });

                const data = await res.json();
                document.getElementById('loadingBubble')?.closest('.message-wrapper')?.remove();

                if(res.ok && data.status === 'success') {
                    appendMessage('ia', data.response);
                } else {
                    appendMessage('ia', `⚠️ Error: ${data.error || 'Fallo de conexión'}`);
                }
            } catch(e) {
                document.getElementById('loadingBubble')?.closest('.message-wrapper')?.remove();
                appendMessage('ia', `📡 Error de red: No se pudo conectar con el servidor.`);
            }
            sendBtn.disabled = false;
            promptInput.focus();
        };

        sendBtn.addEventListener('click', sendMessage);
        promptInput.addEventListener('keydown', (e) => {
            if(e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // Auto-focus on load
        window.onload = () => pinInput.focus();
    </script>
</body>
</html>
