---
// src/pages/links.astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

const instagram = "https://www.instagram.com/javiermixok/";
const bluesky = "https://bsky.app/profile/javiermix.bsky.social";
const linkedin = "https://www.linkedin.com/in/javiermixok";
const whatsapp = "https://wa.me/5491151061413"; // WhatsApp link
const contactEmail = "info@javiermix.ar";
---

<Layout 
  title="Conexiones & Obra" 
  description="Página de enlaces oficial de Javier Mix. Accede a porfolios Fine Art, Revista Digital, asesoría de enmarcado y contacto corporativo."
  themeForce="dark"
>
  <Header currentPath="/links" theme="dark" themeForce="dark" />

  <main class="links-page-wrapper">
    <div class="glow-bg-accent"></div>
    
    <div class="links-container">
      <!-- Sección Perfil -->
      <header class="profile-header">
        <div class="avatar-ring">
          <div class="avatar-inner">
            <span class="avatar-initials">JM</span>
          </div>
        </div>
        <h1 class="profile-title">Javier Mix</h1>
        <p class="profile-subtitle">Fotografía de Autor · Fine Art</p>
        <div class="profile-location">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Buenos Aires, Argentina
        </div>
      </header>

      <!-- Grid de Enlaces Principales -->
      <section class="links-grid" aria-label="Enlaces recomendados">
        
        <a href="/galeria" class="link-card highlight-card">
          <div class="card-glow"></div>
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <div class="card-content">
            <h2 class="card-title">Colecciones Fine Art</h2>
            <p class="card-desc">Portfolio fotográfico y obras de edición limitada impresas sobre aluminio.</p>
          </div>
          <div class="card-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </a>

        <a href="/revista" class="link-card">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="card-content">
            <h2 class="card-title">Revista Digital</h2>
            <p class="card-desc">Crónicas de estética visual, debates fotográficos y espacio interactivo.</p>
          </div>
          <div class="card-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </a>

        <a href="/curaduria" class="link-card">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="card-content">
            <h2 class="card-title">Arquitectos & Interioristas</h2>
            <p class="card-desc">Servicios de curaduría y asesoramiento técnico a medida para proyectos.</p>
          </div>
          <div class="card-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </a>

        <a href={`mailto:${contactEmail}`} class="link-card">
          <div class="card-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="card-content">
            <h2 class="card-title">Contacto de Adquisición</h2>
            <p class="card-desc">Consultas para compras, cotización de formatos personalizados y envío.</p>
          </div>
          <div class="card-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </a>

      </section>

      <!-- Sección Equipo Técnico Desplegable (Gear Showcase) -->
      <section class="gear-section" aria-label="Equipo de captura">
        <button id="gear-toggle" class="gear-toggle-btn" aria-expanded="false" aria-controls="gear-drawer">
          <svg class="gear-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Mi Equipo Técnico (Gear)
          <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>

        <div id="gear-drawer" class="gear-drawer" hidden>
          <div class="gear-content-inner">
            <p class="gear-intro">Las imágenes de mis colecciones se producen mediante un flujo híbrido y honesto de captura digital, optimizado para grandes formatos físicos de calidad museo.</p>
            
            <div class="gear-grid">
              
              <div class="gear-item">
                <div class="gear-item-header">
                  <div class="gear-type-tag">Cuerpo</div>
                  <h3 class="gear-item-title">Nikon D5600</h3>
                </div>
                <p class="gear-item-desc">Cámara réflex de formato DX. Núcleo principal de captura de luz para composiciones Fine Art urbanas y de estudio.</p>
                <div class="lenses-subgrid">
                  <div class="lens-item">
                    <span class="lens-tag">Óptica 35mm</span>
                    <p class="lens-desc">Lente de distancia focal fija f/1.8. Empleada para fotografía callejera honesta, geometrías de contraste y alta nitidez con luz natural.</p>
                  </div>
                  <div class="lens-item">
                    <span class="lens-tag">Teleobjetivo 300mm</span>
                    <p class="lens-desc">Distancia focal larga para aislar detalles urbanos, contrastes en altura y texturas de hormigón o metal a distancia.</p>
                  </div>
                </div>
              </div>

              <div class="gear-item">
                <div class="gear-item-header">
                  <div class="gear-type-tag">POV & Detrás de Escena</div>
                  <h3 class="gear-item-title">GoPro 11 Black</h3>
                </div>
                <p class="gear-item-desc">Cámara de acción ultra-compacta. Utilizada en soporte en primera persona para registrar el instante del disparo y la toma del fotógrafo durante las recorridas.</p>
              </div>

              <div class="gear-item">
                <div class="gear-item-header">
                  <div class="gear-type-tag">Inmersiva 360°</div>
                  <h3 class="gear-item-title">Insta360 X5</h3>
                </div>
                <p class="gear-item-desc">Cámara esférica de alta resolución. Captura el entorno completo del espacio urbano de Buenos Aires para registros creativos y documentación de locaciones.</p>
              </div>

            </div>
          </div>
        </div>
      </section>

      <!-- Redes Sociales de Soporte -->
      <footer class="links-footer">
        <p class="footer-note">Soportes & Conexiones del Artista</p>
        <div class="social-badges">
          <a href={instagram} target="_blank" aria-label="Instagram" class="badge-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            <span>Instagram</span>
          </a>
          <a href={bluesky} target="_blank" aria-label="Bluesky" class="badge-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 11.5c.6-1 2.3-3.6 4-5.3 1-1 2.2-1.7 3.5-1.7 1.5 0 2.5 1 2.5 2.5 0 2.5-3.5 8-6.5 10C12.5 19 12 20 12 20s-.5-1-3.5-3c-3-2-6.5-7.5-6.5-10C2 5.5 3 4.5 4.5 4.5c1.3 0 2.5.7 3.5 1.7 1.7 1.7 3.4 4.3 4 5.3Z"/></svg>
            <span>Bluesky</span>
          </a>
          <a href={linkedin} target="_blank" aria-label="LinkedIn" class="badge-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            <span>LinkedIn</span>
          </a>
          <a href={whatsapp} target="_blank" aria-label="WhatsApp" class="badge-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>WhatsApp</span>
          </a>
        </div>
      </footer>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Control interactivo de acordeón de equipo técnico
  const toggleBtn = document.getElementById('gear-toggle');
  const drawer = document.getElementById('gear-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      drawer.hidden = isExpanded;
      
      if (!isExpanded) {
        drawer.classList.add('expanded');
        // Smooth scroll for focus
        setTimeout(() => {
          toggleBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 100);
      } else {
        drawer.classList.remove('expanded');
      }
    });
  }
</script>

<style>
  .links-page-wrapper {
    position: relative;
    background-color: #050505;
    min-height: 100vh;
    padding: 10rem 2rem 6rem;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .glow-bg-accent {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(197, 160, 89, 0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .links-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Perfil */
  .profile-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .avatar-ring {
    position: relative;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--ok-gold) 0%, rgba(255,255,255,0.05) 100%);
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.03);
  }

  .avatar-initials {
    font-family: var(--font-primary);
    font-size: 1.8rem;
    font-style: italic;
    color: var(--ok-gold);
    letter-spacing: 1px;
  }

  .profile-title {
    font-family: var(--font-primary);
    font-size: 2.6rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-white);
    margin-bottom: 0.5rem;
    letter-spacing: 1px;
  }

  .profile-subtitle {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ok-gold);
    margin-bottom: 0.8rem;
  }

  .profile-location {
    font-size: 0.72rem;
    letter-spacing: 1px;
    color: var(--color-travertine-dark);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Grid de Enlaces */
  .links-grid {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .link-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.8rem;
    background: rgba(15, 15, 15, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    transition: var(--transition-premium);
    cursor: pointer;
    overflow: hidden;
  }

  .link-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 2px;
    background: transparent;
    transition: var(--transition-premium);
  }

  .link-card:hover {
    background: rgba(20, 20, 20, 0.8);
    border-color: rgba(197, 160, 89, 0.15);
    transform: translateY(-2px);
  }

  .link-card:hover::before {
    background: var(--ok-gold);
  }

  .highlight-card {
    background: linear-gradient(135deg, rgba(15,15,15,0.7) 0%, rgba(197, 160, 89, 0.02) 100%);
    border-color: rgba(197, 160, 89, 0.08);
  }

  .card-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(197, 160, 89, 0.03) 0%, transparent 70%);
    pointer-events: none;
  }

  .card-icon {
    color: var(--ok-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-content {
    flex-grow: 1;
  }

  .card-title {
    font-family: var(--font-primary);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }

  .card-desc {
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--color-travertine-mid);
    max-width: 90%;
  }

  .card-arrow {
    color: rgba(255,255,255,0.15);
    transition: var(--transition-premium);
  }

  .link-card:hover .card-arrow {
    color: var(--ok-gold);
    transform: translateX(3px);
  }

  /* Gear Acordeón */
  .gear-section {
    border: 1px solid rgba(255, 255, 255, 0.03);
    background: rgba(8, 8, 8, 0.4);
    backdrop-filter: blur(8px);
  }

  .gear-toggle-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.8rem;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-travertine-light);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: var(--transition-premium);
  }

  .gear-toggle-btn:hover {
    color: var(--ok-gold);
    background: rgba(255,255,255,0.01);
  }

  .gear-icon {
    color: var(--ok-gold);
    transition: transform 0.8s ease;
  }

  .gear-toggle-btn:hover .gear-icon {
    transform: rotate(45deg);
  }

  .chevron-icon {
    color: rgba(255,255,255,0.3);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gear-toggle-btn[aria-expanded="true"] .chevron-icon {
    transform: rotate(180deg);
    color: var(--ok-gold);
  }

  .gear-drawer {
    overflow: hidden;
    transition: max-height 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    border-top: 1px solid rgba(255, 255, 255, 0.02);
  }

  .gear-content-inner {
    padding: 2rem 1.8rem;
  }

  .gear-intro {
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-travertine-mid);
    margin-bottom: 2rem;
    text-align: center;
    font-style: italic;
  }

  .gear-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .gear-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.02);
  }

  .gear-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .gear-item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gear-type-tag {
    font-size: 0.6rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ok-gold);
    background: rgba(197, 160, 89, 0.05);
    padding: 2px 6px;
    border: 1px solid rgba(197, 160, 89, 0.1);
  }

  .gear-item-title {
    font-family: var(--font-primary);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-white);
  }

  .gear-item-desc {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-travertine-mid);
  }

  .lenses-subgrid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
    padding-left: 1rem;
    border-left: 1px solid rgba(197, 160, 89, 0.15);
  }

  .lens-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lens-tag {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--color-travertine-light);
  }

  .lens-desc {
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--color-travertine-dark);
  }

  /* Redes Footer */
  .links-footer {
    text-align: center;
    margin-top: 1rem;
  }

  .footer-note {
    font-size: 0.65rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-travertine-dark);
    margin-bottom: 1.25rem;
  }

  .social-badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }

  .badge-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    background: rgba(15, 15, 15, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.02);
    font-size: 0.75rem;
    color: var(--color-travertine-mid);
    transition: var(--transition-premium);
  }

  .badge-link:hover {
    color: var(--ok-gold);
    background: rgba(197, 160, 89, 0.03);
    border-color: rgba(197, 160, 89, 0.1);
  }

  .badge-link svg {
    transition: transform 0.5s ease;
  }

  .badge-link:hover svg {
    transform: scale(1.1);
  }

  @media (max-width: 480px) {
    .links-page-wrapper {
      padding-top: 8rem;
    }
    .profile-title {
      font-size: 2.2rem;
    }
    .social-badges {
      grid-template-columns: 1fr;
    }
  }
</style>
