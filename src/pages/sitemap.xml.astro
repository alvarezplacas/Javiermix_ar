---
// sitemap.xml.astro — Sitemap dinámico en vivo sincronizado con Directus (Estándar de Oro JMX)
import { getSeries, getArticles, slugify } from '@conexion/directus';

const SITE_URL = 'https://javiermix.ar';
const today = new Date().toISOString().split('T')[0];

// ── Páginas estáticas principales ──
const staticPages = [
  { url: '/',          priority: '1.0', changefreq: 'weekly'  },
  { url: '/galeria',   priority: '0.9', changefreq: 'weekly'  },
  { url: '/revista',   priority: '0.8', changefreq: 'weekly'  },
  { url: '/royal-gallery', priority: '0.9', changefreq: 'weekly' },
  { url: '/rescate',   priority: '0.8', changefreq: 'weekly'  },
];

// ── Series de catálogo dinámicas de Directus (URLs Amigables) ──
let seriesPages: { url: string; priority: string; changefreq: string }[] = [];
try {
  const dbSeries = await getSeries();
  seriesPages = dbSeries.map(s => ({
    url: `/galeria/${slugify(s.name)}`,
    priority: '0.8',
    changefreq: 'monthly',
  }));
} catch (e) {
  console.error("[Sitemap-Series-Error] Falló la recuperación de series de Directus:", e);
}

// ── Artículos de revista de Directus ──
let articlePages: { url: string; priority: string; changefreq: string; date?: string }[] = [];
try {
  const dbArticles = await getArticles();
  articlePages = dbArticles.map(a => ({
    url: `/revista/${a.id}-${a.slug}`,
    priority: '0.7',
    changefreq: 'monthly',
    date: a.date_created?.split('T')[0] || today,
  }));
} catch (e) {
  console.error("[Sitemap-Articles-Error] Falló la recuperación de artículos de Directus:", e);
}

const allPages = [...staticPages, ...seriesPages, ...articlePages];
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
>
  {allPages.map(page => (
    <url>
      <loc>{SITE_URL}{page.url}</loc>
      <lastmod>{(page as any).date || today}</lastmod>
      <changefreq>{page.changefreq}</changefreq>
      <priority>{page.priority}</priority>
    </url>
  ))}
</urlset>
