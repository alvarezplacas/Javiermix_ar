---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\index.astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');

import { getHomeSettings, getAssetUrl } from '@conexion/directus';

let homeSettings = null;
try {
    homeSettings = await getHomeSettings();
} catch (error) {
    console.error(`[SSR-Home-Error] Fallo en Fetch de Directus para Settings:`, error);
}

// --------------------------------------------------------
// DATOS DINÁMICOS DESDE DIRECTUS O VALORES POR DEFECTO
// --------------------------------------------------------

const heroImage = homeSettings?.portfolio_photo 
    ? getAssetUrl(homeSettings.portfolio_photo, { width: 800, format: 'webp', quality: 90 }) 
    : '/img/portfolio_hero.png';

const heroTitle = "JAVIER MIX"; // Forzado por petición del usuario
const heroSubtitle = homeSettings?.portfolio_subtitle || "Fotógrafo & Creador Digital";

// Frases Célebres (Inspiración)
const qPhoto = homeSettings?.quote_photo || "Fotografiar es colocar la cabeza, el ojo y el corazón en un mismo eje.";
const aPhoto = homeSettings?.author_photo || "Henri Cartier-Bresson";

const qPaint = homeSettings?.quote_paint || "El verdadero pintor es aquel que es capaz de pintar escenas extraordinarias en medio de un desierto vacío.";
const aPaint = homeSettings?.author_paint || "Salvador Dalí";

const qDesign = homeSettings?.quote_design || "El diseño no es solo lo que se ve o lo que se siente. El diseño es cómo funciona.";
const aDesign = homeSettings?.author_design || "Steve Jobs";
---

<Layout 
  title="JavierMix | Portfolio Profesional" 
  description="Portfolio profesional de Javier Mix. Fotografía Fine Art, Diseño y Desarrollo Web."
>
  <Header currentPath="/" theme="dark" />
  
  <main class="portfolio-main">
    
    <!-- FONDO ESTRUCTURAL 2D (Designer Grid) -->
    <div class="portfolio-background">
        <!-- El CSS de la retícula se genera en portfolio.css -->
    </div>

    <!-- 1. HERO SECTION -->
    <section class="hero-section">
      <div class="hero-content">
        <div>
            <h1 class="hero-title">{heroTitle}</h1>
            <p class="hero-subtitle">{heroSubtitle}</p>
        </div>
      </div>
      
      <!-- Logo de mouse animado para indicar scroll -->
      <div class="scroll-indicator">
        <div class="mouse"></div>
        <span>Descubrir</span>
      </div>
    </section>

    <!-- 2. DISEÑO INTEGRAL & VISIÓN DE AUTOR -->
    <section class="integral-design-section">
        <div class="integral-design-content reveal-on-scroll">
            <h2 class="integral-title">Diseño Integral & Visión de Autor</h2>
            <p class="integral-text">
                Conectamos la esencia que hace único a tu negocio con tu audiencia de forma relevante, distintiva y estratégica. 
                Creamos y desarrollamos identidades de marca con un profundo impacto visual y las llevamos al mundo 
                digital a través de sitios web innovadores y fluidos. <br><br>
                Fusionamos la precisión del desarrollo moderno con la sensibilidad estética de la fotografía fine art, 
                garantizando que el mensaje de tu proyecto no solo se lea, sino que se sienta y sea verdaderamente inolvidable.
            </p>
        </div>
    </section>

    <!-- 3. INSPIRACIÓN Y MAESTROS -->
    <section class="inspiration-section">
        <div class="floating-quotes reveal-on-scroll delay-100">
            
            <article class="quote-item">
                <p class="quote-text">"{qPhoto}"</p>
                <div class="quote-author">- {aPhoto}</div>
            </article>

            <article class="quote-item">
                <p class="quote-text">"{qPaint}"</p>
                <div class="quote-author">- {aPaint}</div>
            </article>

            <article class="quote-item">
                <p class="quote-text">"{qDesign}"</p>
                <div class="quote-author">- {aDesign}</div>
            </article>

        </div>
    </section>

    <!-- 4. HABILIDADES CON LOGOS REALES -->
    <section class="skills-section" id="about">
        <h2 class="section-title reveal-on-scroll">Stack & Herramientas</h2>
        <div class="skills-grid reveal-on-scroll delay-100">
            <div class="skill-icon"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/photoshop/photoshop-original.svg" alt="Photoshop" title="Photoshop" /></div>
            <div class="skill-icon"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/illustrator/illustrator-plain.svg" alt="Illustrator" title="Illustrator" /></div>
            <div class="skill-icon"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/premierepro/premierepro-original.svg" alt="Premiere" title="Premiere Pro" /></div>
            <div class="skill-icon"><img src="https://cdn.simpleicons.org/adobeindesign/FF3366" alt="InDesign" title="InDesign" /></div>
            <div class="skill-icon"><img src="https://cdn.simpleicons.org/adobelightroom/31A8FF" alt="Lightroom" title="Lightroom" /></div>
            <div class="skill-icon"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg" alt="Astro" title="Astro Framework" /></div>
            <div class="skill-icon"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg" alt="React" title="React JS" /></div>
            <div class="skill-icon"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" alt="Docker" title="Docker / VPS" /></div>
        </div>
    </section>

    <!-- 5. ECOSISTEMA DE PROYECTOS -->
    <section class="projects-section">
        <h2 class="section-title reveal-on-scroll">Proyectos Destacados</h2>
        <div class="projects-grid reveal-on-scroll delay-100">
            
            <a href="https://alvarezplacas.com.ar" target="_blank" rel="noopener noreferrer" class="project-card">
                <div class="project-bg" style="background-image: url('/img/hero-placas.jpg');"></div>
                <div class="project-overlay"></div>
                <div class="project-content">
                    <h3 class="project-title">Álvarez Placas</h3>
                    <p class="project-desc">Diseño, fabricación y portal e-commerce líder en reconocimientos.</p>
                </div>
            </a>

            <a href="/revista/" class="project-card">
                <!-- Por ahora usamos el hero generado como fondo, o uno de Directus si existiera -->
                <div class="project-bg" style="background-image: url('/img/portfolio_hero.png');"></div>
                <div class="project-overlay"></div>
                <div class="project-content">
                    <h3 class="project-title">Noir & Lux</h3>
                    <p class="project-desc">Revista online y galería de arte contemporáneo (Fotografía de Autor).</p>
                </div>
            </a>

        </div>
    </section>

  </main>

  <Footer />

</Layout>

<style>
  /* Los estilos base se importan globalmente o se pueden dejar aquí si es un css directo, 
     pero como creamos portfolio.css, lo incluiremos aquí o en global. */
  @import url('../styles/portfolio.css');
</style>

<script>
  // Observador para animaciones de reveal on scroll estilo Rowen
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target); // Solo animar la primera vez
        }
      });
    }, observerOptions);

    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    revealElements.forEach(el => observer.observe(el));
  });
</script>
