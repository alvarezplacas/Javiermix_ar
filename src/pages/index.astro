---
// d:\web_javiermix\JAVIERMIX-AR-0504\src\pages\index.astro
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');

import { getHomeSettings, getAssetUrl } from '@conexion/directus';

let homeSettings = null;
try {
    homeSettings = await getHomeSettings();
} catch (error) {
    console.error(`[SSR-Home-Error] Fallo en Fetch de Directus para Settings:`, error);
}

// --------------------------------------------------------
// DATOS DINÁMICOS DESDE DIRECTUS O VALORES POR DEFECTO
// --------------------------------------------------------

const heroImage = homeSettings?.portfolio_photo 
    ? getAssetUrl(homeSettings.portfolio_photo, { width: 800, format: 'webp', quality: 90 }) 
    : '/img/portfolio_hero.png';

const heroTitle = homeSettings?.portfolio_title || "Javier Álvarez";
const heroSubtitle = homeSettings?.portfolio_subtitle || "Fotógrafo & Creador Digital";

// Frases Célebres (Inspiración)
const qPhoto = homeSettings?.quote_photo || "Un fotógrafo hace una foto, no la toma.";
const aPhoto = homeSettings?.author_photo || "Pedro Luis Raota";

const qPaint = homeSettings?.quote_paint || "No pinto lo que veo, pinto lo que pienso.";
const aPaint = homeSettings?.author_paint || "Dalí & Picasso";

const qDesign = homeSettings?.quote_design || "El diseño es la organización de la experiencia visual y la materia.";
const aDesign = homeSettings?.author_design || "Herbert Bayer";
---

<Layout 
  title="JavierMix | Portfolio Profesional" 
  description="Portfolio profesional de Javier Álvarez. Fotografía Fine Art, Diseño y Desarrollo Web."
>
  <Header currentPath="/" theme="dark" />
  
  <main class="portfolio-main">
    
    <!-- FONDOS ANIMADOS OKLCH / KANDINSKY -->
    <div class="portfolio-background">
        <div class="kandinsky-shape shape-1"></div>
        <div class="kandinsky-shape shape-2"></div>
        <div class="kandinsky-shape shape-3"></div>
    </div>

    <!-- 1. HERO SECTION -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="hero-image-container">
            <img src={heroImage} alt="JavierMix Profile" class="hero-image" />
        </div>
        <div>
            <h1 class="hero-title">{heroTitle}</h1>
            <p class="hero-subtitle">{heroSubtitle}</p>
        </div>
      </div>
      
      <!-- Logo de mouse animado para indicar scroll -->
      <div class="scroll-indicator">
        <div class="mouse"></div>
        <span>Descubrir</span>
      </div>
    </section>

    <!-- 2. INSPIRACIÓN Y MAESTROS -->
    <section class="inspiration-section">
        <h2 class="section-title reveal-on-scroll">Pilares de Inspiración</h2>
        <div class="quotes-grid reveal-on-scroll delay-100">
            
            <article class="quote-card">
                <span class="quote-category">Fotografía</span>
                <p class="quote-text">"{qPhoto}"</p>
                <div class="quote-author">- {aPhoto}</div>
            </article>

            <article class="quote-card">
                <span class="quote-category">Pintura</span>
                <p class="quote-text">"{qPaint}"</p>
                <div class="quote-author">- {aPaint}</div>
            </article>

            <article class="quote-card">
                <span class="quote-category">Diseño Gráfico</span>
                <p class="quote-text">"{qDesign}"</p>
                <div class="quote-author">- {aDesign}</div>
            </article>

        </div>
    </section>

    <!-- 3. HABILIDADES -->
    <section class="skills-section">
        <h2 class="section-title reveal-on-scroll">Habilidades y Herramientas</h2>
        <div class="skills-container reveal-on-scroll delay-100">
            <span class="skill-pill">Fotografía Fine Art</span>
            <span class="skill-pill">Adobe Photoshop</span>
            <span class="skill-pill">Adobe Illustrator</span>
            <span class="skill-pill">Adobe Premiere</span>
            <span class="skill-pill">UI / UX Design</span>
            <span class="skill-pill">Astro & React</span>
            <span class="skill-pill">Docker & VPS</span>
        </div>
    </section>

    <!-- 4. ECOSISTEMA DE PROYECTOS -->
    <section class="projects-section">
        <h2 class="section-title reveal-on-scroll">Proyectos Destacados</h2>
        <div class="projects-grid reveal-on-scroll delay-100">
            
            <a href="https://alvarezplacas.com.ar" target="_blank" rel="noopener noreferrer" class="project-card">
                <div class="project-bg" style="background-image: url('/img/hero-placas.jpg');"></div>
                <div class="project-overlay"></div>
                <div class="project-content">
                    <h3 class="project-title">Álvarez Placas</h3>
                    <p class="project-desc">Diseño, fabricación y portal e-commerce líder en reconocimientos.</p>
                </div>
            </a>

            <a href="/revista/" class="project-card">
                <!-- Por ahora usamos el hero generado como fondo, o uno de Directus si existiera -->
                <div class="project-bg" style="background-image: url('/img/portfolio_hero.png');"></div>
                <div class="project-overlay"></div>
                <div class="project-content">
                    <h3 class="project-title">Noir & Lux</h3>
                    <p class="project-desc">Revista online y galería de arte contemporáneo (Fotografía de Autor).</p>
                </div>
            </a>

        </div>
    </section>

  </main>

  <Footer />

</Layout>

<style>
  /* Los estilos base se importan globalmente o se pueden dejar aquí si es un css directo, 
     pero como creamos portfolio.css, lo incluiremos aquí o en global. */
  @import url('../styles/portfolio.css');
</style>

<script>
  // Observador para animaciones de reveal on scroll estilo Rowen
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target); // Solo animar la primera vez
        }
      });
    }, observerOptions);

    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    revealElements.forEach(el => observer.observe(el));
  });
</script>
